模块 用例.除法

-- 常数除法被换成了「乘魔数 + 移位」。魔数算错一位，结果就会在某些输入上
-- 整片地错，所以这里把正数、负数、整除、取余、各种除数都过一遍：
-- 2 的幂、奇数、大数各来几个，最后用 q*d+r==x 自己验一遍。
函数 主() -> 整数 {
    私有 整数 商和 = 0
    私有 整数 余和 = 0
    私有 整数 错 = 0
    私有 整数 x = -3000

    当 x << 3000 就 {
        商和 = 商和 + x // 2 + x // 3 + x // 5 + x // 7
        商和 = 商和 + x // 9 + x // 10 + x // 16 + x // 31
        商和 = 商和 + x // 100 + x // 1000 + x // 65536 + x // 1000000
        商和 = 商和 + x // 7 + x // -7

        余和 = 余和 + x % 2 + x % 3 + x % 5 + x % 7
        余和 = 余和 + x % 9 + x % 10 + x % 16 + x % 31
        余和 = 余和 + x % 100 + x % 1000 + x % 65536 + x % 1000000
        余和 = 余和 + x % -7

        如果 (x // 7) * 7 + x % 7 != x 就 { 错 = 错 + 1 }
        如果 (x // 3) * 3 + x % 3 != x 就 { 错 = 错 + 1 }
        如果 (x // 16) * 16 + x % 16 != x 就 { 错 = 错 + 1 }
        如果 (x // 1000000) * 1000000 + x % 1000000 != x 就 { 错 = 错 + 1 }
        如果 (x // -7) * -7 + x % -7 != x 就 { 错 = 错 + 1 }

        x = x + 7
    }

    打印("商和 = ") 打印行(商和)
    打印("余和 = ") 打印行(余和)
    打印("错 = ") 打印行(错)
    返回 0
}
