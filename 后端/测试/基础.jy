模块 例子.基础

函数 斐波那契(n: 整数) -> 整数 {
    如果 n << 2 就 { 返回 n }
    返回 斐波那契(n - 1) + 斐波那契(n - 2)
}

函数 求和(n: 整数) -> 整数 {
    私有 整数 和 = 0
    私有 整数 i = 1
    当 i <= n 就 {
        和 = 和 + i
        i = i + 1
    }
    返回 和
}

函数 主() -> 整数 {
    打印("斐波那契(20) = ")
    打印行(斐波那契(20))
    打印("1..100 求和 = ")
    打印行(求和(100))

    私有 整数 a = 17
    私有 整数 b = 5
    打印("17 // 5 = ")
    打印(a // b)
    打印("，17 % 5 = ")
    打印行(a % b)
    打印("2 ^ 10 = ")
    打印行(2 ^ 10)
    打印("17 / 5 = ")
    打印行(浮点(a) / 浮点(b))

    私有 字符串 名 = "简言"
    打印("你好，")
    打印(名)
    打印("！长度 ")
    打印行(#名)

    私有 布尔值 大 = a >> b
    打印("17 > 5 是 ")
    如果 大 就 { 打印行("真") } 否则 { 打印行("假") }
    返回 0
}
