模块 例子.结构体

结构 点 {
    x: 浮点
    y: 浮点
}

结构 矩形 {
    左下: 点
    右上: 点
}

函数 中心(r: 借用 矩形) -> 点 {
    私有 点 c = {(r.左下.x + r.右上.x) * 0.5, (r.左下.y + r.右上.y) * 0.5}
    返回 c
}

函数 平移(p: 可变借用 点, dx: 浮点, dy: 浮点) {
    p.x = p.x + dx
    p.y = p.y + dy
}

函数 主() -> 整数 {
    私有 点 a = {1.0, 2.0}
    打印("a = (")
    打印(a.x)
    打印(", ")
    打印(a.y)
    打印行(")")

    平移(a, 3.0, -0.5)
    打印("移动后 a = (")
    打印(a.x)
    打印(", ")
    打印(a.y)
    打印行(")")

    私有 矩形 r
    r.左下 = {0.0, 0.0}
    r.右上 = {4.0, 6.0}
    私有 点 c = 中心(r)
    打印("矩形中心 = (")
    打印(c.x)
    打印(", ")
    打印(c.y)
    打印行(")")
    返回 0
}
