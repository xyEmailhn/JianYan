-- 真线程：`线程 { }` 抬成独立函数，后端用 pthread_create 起。
-- 通道是句柄：两个线程共用一个通道，各自的 `发送` 都进同一个缓冲。
-- 容量故意设成 1 —— 满了必须阻塞等，收方一读就走。
-- 只要不丢数据，和就一定是 5050，跟线程调度顺序无关。

模块 探.并发

函数 主() -> 整数 {
    私有 通道[整数] 管 = 通道[整数](1)

    线程 {
        对 i: 1~50 {
            发送 管, i
        }
    }

    线程 {
        对 i: 51~100 {
            发送 管, i
        }
    }

    私有 整数 和 = 0
    私有 整数 条 = 0
    对 i: 1~100 {
        私有 可空[整数] 甲 = 接收 管
        如果 甲.有值 就 {
            和 = 和 + 甲.取值()
            条 = 条 + 1
        }
    }
    打印行("两条线程送来 " .. 字符串(条) .. " 个数，和 " .. 字符串(和))

    -- 关闭以后 `接收` 不再等，直接给空：这就是"读到没了"的信号
    私有 通道[整数] 平方管 = 通道[整数](4)
    线程 {
        对 i: 1~3 {
            发送 平方管, i * i
        }
        关闭 平方管
    }
    私有 整数 平方和 = 0
    循环 {
        私有 可空[整数] 乙 = 接收 平方管
        如果 乙.有值 就 {
            平方和 = 平方和 + 乙.取值()
        } 否则 {
            打断
        }
    }
    打印行("平方和 " .. 字符串(平方和))

    -- 捕获：线程读外层变量是允许的，按值拷一份进去
    私有 整数 基数 = 100
    私有 通道[整数] 报 = 通道[整数](1)
    线程 {
        发送 报, 基数 + 1
    }
    私有 可空[整数] 丙 = 接收 报
    如果 丙.有值 就 {
        打印行("捕获到的基数 + 1 = " .. 字符串(丙.取值()))
    }
    返回 0
}
