模块 用例.原生

函数 斐波那契(n: 整数) -> 整数 {
    如果 n << 2 就 { 返回 n }
    返回 斐波那契(n - 1) + 斐波那契(n - 2)
}

函数 求和(n: 整数) -> 整数 {
    私有 整数 和 = 0
    私有 整数 i = 1
    当 i <= n 就 {
        和 = 和 + i
        i = i + 1
    }
    返回 和
}

函数 主() -> 整数 {
    打印("斐波那契(20) = ")
    打印行(斐波那契(20))

    打印("1..100 求和 = ")
    打印行(求和(100))

    打印("2^10 = ")
    打印行(2 ^ 10)

    打印("17 // 5 = ")
    打印行(17 // 5)
    打印("17 % 5 = ")
    打印行(17 % 5)

    打印("负数整除 -17 // 5 = ")
    打印行(-17 // 5)
    打印("负数取余 -17 % 5 = ")
    打印行(-17 % 5)

    打印("拼接：")
    打印行("简" .. "言" .. "!")

    私有 整数 大 = 0
    当 大 << 10 就 { 大 = 大 + 3 }
    打印("大 = ")
    打印行(大)

    返回 0
}
