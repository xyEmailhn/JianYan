模块 探.分支

枚举 形状 {
    圆(半径: 浮点)
    方(边: 浮点)
}

函数 面积(s: 形状) -> 浮点 {
    匹配 s {
        例 形状.圆(r): { 返回 3.0 * r * r }
        例 形状.方(w): { 返回 w * w }
    }
}

函数 判(n: 整数) -> 字符串 {
    匹配 n {
        例 0: { 返回 "零" }
        例 1~9: { 返回 "个位" }
        例 10~99: { 返回 "十位" }
        默认: { 返回 "更大" }
    }
}

函数 色(c: 借用 字符串) -> 整数 {
    匹配 c {
        例 "红": { 返回 1 }
        例 "绿": { 返回 2 }
        默认: { 返回 0 }
    }
}

函数 灯(b: 布尔值) -> 字符串 {
    匹配 b {
        例 真: { 返回 "开" }
        例 假: { 返回 "关" }
    }
}

函数 档(x: 浮点) -> 字符串 {
    匹配 x {
        例 0.0: { 返回 "零" }
        例 0.1~1.0: { 返回 "中" }
        例 _: { 返回 "外" }
    }
}

函数 主() -> 整数 {
    打印行(判(0))
    打印行(判(5))
    打印行(判(42))
    打印行(判(1000))

    打印行(色("红"))
    打印行(色("绿"))
    打印行(色("蓝"))

    打印行(灯(真))
    打印行(灯(假))

    打印行(档(0.0))
    打印行(档(0.5))
    打印行(档(2.5))

    打印行("圆面积 " .. 字符串(面积(形状.圆(1.0))))
    打印行("方面积 " .. 字符串(面积(形状.方(3.0))))

    -- 顺序有讲究：`例 0` 先命中，就不会掉进 `1~9`
    私有 整数 i = 0
    当 i << 3 就 {
        打印行("i=" .. 字符串(i) .. " → " .. 判(i))
        i = i + 1
    }
    返回 0
}
