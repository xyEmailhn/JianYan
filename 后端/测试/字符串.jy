模块 例子.文本

函数 主() -> 整数 {
    私有 字符串 s = "  简言 Hello  "
    私有 整数 长1 = #s
    打印("原串 [")
    打印(s)
    打印("] 长度 ")
    打印行(长1)

    私有 字符串 t = s.去空白()
    私有 整数 长2 = #t
    打印("去空白 [")
    打印(t)
    打印("] 长度 ")
    打印行(长2)

    打印("大写 ")
    打印行(t.大写())
    打印("小写 ")
    打印行(t.小写())
    打印("包含 简言 = ")
    打印行(t.包含("简言"))
    打印("开头是 简言 = ")
    打印行(t.开头是("简言"))
    打印("结尾是 言 = ")
    打印行(t.结尾是("言"))

    打印("替换 = ")
    打印行(t.替换("Hello", "世界"))
    返回 0
}
