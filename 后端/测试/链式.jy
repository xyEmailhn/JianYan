模块 用例.链式

-- 属性访问可以接着方法继续写：`r.取值.归一化()`、`数.取(0).取值 + 1`。
-- 这里钉住的是 IR 的类型推导：零参属性（取值 / 长度 / 是成功 …）
-- 查出来的签名是函数，但写成不带括号时它的值类型是「返回类型」。
-- 漏了这一步，`r.取值` 会被当成函数值，再往上找方法就找不到，
-- 整个表达式的类型退化成未知，生成出来的 C 拿 long long 去接结构体。
-- 这是第 18 坑的回归测试。

函数 主() -> 整数 {
    -- 结果 -> 属性 -> 方法
    结果[整数, 字符串] r = 成功(42)
    打印("1 ") 打印行(r.取值.转字符串())

    -- 结果套结果，两层属性
    结果[结果[整数, 字符串], 字符串] 套 = 成功(成功(7))
    打印("2 ") 打印行(套.取值.取值)

    -- 可空 -> 属性 -> 算术
    私有 整数 组 数 = {3, 1, 4}
    打印("3 ") 打印行(数.取(0).取值 + 100)

    -- 声音 -> 方法 -> 方法 -> 属性
    声音 s = 新建声音(4, 1, 8000)
    s.设(0, 0, 0.5)
    s.设(1, 0, -0.25)
    声音 响 = s.放大(2.0).归一化()
    打印("4 ") 打印行(响.取(0, 0))
    打印("5 ") 打印行(响.帧数)

    -- 结果 -> 属性 落在 声音 上，再取方法
    结果[声音, 字符串] 声 = 成功(s)
    打印("6 ") 打印行(声.取值.归一化().取(0, 0))

    -- 成功后取长度这类整数属性
    结果[字符串, 字符串] 文 = 成功("大肥鱼")
    打印("7 ") 打印行(#文.取值)

    返回 0
}
