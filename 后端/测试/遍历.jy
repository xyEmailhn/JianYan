模块 探.遍历

结构 学生 {
    名: 字符串
    分: 整数
}

函数 主() -> 整数 {
    -- 映射：一次给键和值，顺序由 键组() 定，和哈希布局无关
    私有 映射[字符串, 整数] 库存 = { "笔": 12, "本": 5, "尺": 3 }
    私有 整数 总数 = 0
    对 名, 数 在 库存 {
        打印行(名 .. " " .. 字符串(数))
        总数 = 总数 + 数
    }
    打印行("总数 " .. 字符串(总数))

    -- 只要键：写一个变量
    对 名 在 库存 {
        打印行("键 " .. 名)
    }

    -- 组
    私有 整数 组 分 = {90, 80, 70}
    私有 整数 和 = 0
    对 x 在 分 {
        和 = 和 + x
    }
    打印行("组和 " .. 字符串(和))

    -- 字符串按字符走
    私有 整数 字 = 0
    对 c 在 "简言" {
        字 = 字 + 1
    }
    打印行("字数 " .. 字符串(字))

    -- 结构体组：元素类型不会被截断
    私有 学生 组 班 = {}
    班.追加(新建 学生{ 名: "甲", 分: 91 })
    班.追加(新建 学生{ 名: "乙", 分: 78 })
    对 s 在 班 {
        打印行(s.名 .. "：" .. 字符串(s.分))
    }
    返回 0
}
