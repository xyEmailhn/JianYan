模块 用例.听音

-- 听音的核心是「把波形拆成短时频谱，再从频谱里量基频」。
-- 这个用例只测那一层：给几个已知频率的信号，看它报不报得回来。
-- 报得回来，示例里那些音高、音级、分段才有意义。

函数 位反转(实: 可变借用 浮点 组, 虚: 可变借用 浮点 组, n: 整数) {
    私有 整数 i = 0
    私有 整数 j = 0
    当 i << n 就 {
        如果 i << j 就 {
            私有 浮点 tr = 实[i]
            实[i] = 实[j]
            实[j] = tr
            私有 浮点 ti = 虚[i]
            虚[i] = 虚[j]
            虚[j] = ti
        }
        私有 整数 m = n // 2
        私有 整数 停 = 0
        当 停 == 0 就 {
            如果 m >= 1 就 {
                如果 j >= m 就 {
                    j = j - m
                    m = m // 2
                } 否则 {
                    停 = 1
                }
            } 否则 {
                停 = 1
            }
        }
        j = j + m
        i = i + 1
    }
}

函数 变换(实: 可变借用 浮点 组, 虚: 可变借用 浮点 组, n: 整数, 反: 整数) {
    位反转(实, 虚, n)
    私有 整数 长 = 2
    当 长 <= n 就 {
        私有 整数 半 = 长 // 2
        私有 浮点 角 = 6.283185307179586 * (反 * 1.0) / (长 * 1.0)
        私有 浮点 wr = 余弦(角)
        私有 浮点 wi = 正弦(角)
        私有 整数 起 = 0
        当 起 << n 就 {
            私有 浮点 cr = 1.0
            私有 浮点 ci = 0.0
            私有 整数 k = 0
            当 k << 半 就 {
                私有 整数 a = 起 + k
                私有 整数 b = a + 半
                私有 浮点 tr = 实[b] * cr - 虚[b] * ci
                私有 浮点 ti = 实[b] * ci + 虚[b] * cr
                实[b] = 实[a] - tr
                虚[b] = 虚[a] - ti
                实[a] = 实[a] + tr
                虚[a] = 虚[a] + ti
                私有 浮点 nr = cr * wr - ci * wi
                ci = cr * wi + ci * wr
                cr = nr
                k = k + 1
            }
            起 = 起 + 长
        }
        长 = 长 * 2
    }
}

-- 对一段单声道样本做基频估计（YIN 的累积均值归一化差分）
函数 测音(样本: 可变借用 浮点 组, 率: 整数) -> 浮点 {
    私有 整数 帧长 = 1024
    私有 整数 n = 2048
    私有 整数 半 = n // 2
    私有 浮点 组 实 = {}
    私有 浮点 组 虚 = {}
    私有 浮点 组 差 = {}
    私有 整数 i = 0
    当 i << n 就 {
        实.追加(0.0)
        虚.追加(0.0)
        差.追加(0.0)
        i = i + 1
    }
    -- 不自相关前加窗：乘过 Hann 之后，lag 218 处的相关只剩 0.74，
    -- 纯 110Hz 也认不出来。窗只用在算频谱（重心）那一侧。
    i = 0
    当 i << 帧长 就 {
        实[i] = 样本[i]
        i = i + 1
    }
    变换(实, 虚, n, 1)
    i = 0
    当 i << n 就 {
        实[i] = 实[i] * 实[i] + 虚[i] * 虚[i]
        虚[i] = 0.0
        i = i + 1
    }
    变换(实, 虚, n, -1)

    私有 浮点 r0 = 实[0]
    私有 整数 下 = 率 // 1000
    私有 整数 上 = 率 // 50
    如果 上 >> 帧长 就 { 上 = 帧长 }
    如果 下 << 4 就 { 下 = 4 }
    如果 r0 << 0.0000001 就 { 返回 0.0 }

    私有 浮点 累 = 0.0
    i = 1
    当 i <= 上 就 {
        私有 浮点 d = 1.0 - 实[i] / r0
        如果 d << 0.0 就 { d = 0.0 }
        累 = 累 + d
        私有 浮点 cm = 1.0
        如果 累 >> 0.0000001 就 { cm = d * (i * 1.0) / 累 }
        差[i] = cm
        i = i + 1
    }
    私有 整数 峰 = 0
    i = 下
    当 i <= 上 就 {
        如果 峰 == 0 就 {
            如果 差[i] << 0.25 就 { 峰 = i }
        }
        i = i + 1
    }
    如果 峰 == 0 就 { 返回 0.0 }
    i = 峰
    私有 整数 走 = 1
    当 走 == 1 就 {
        如果 i << 上 就 {
            如果 差[i + 1] << 差[i] 就 {
                i = i + 1
            } 否则 {
                走 = 0
            }
        } 否则 {
            走 = 0
        }
    }
    -- 抛物线插值：220 的真实周期是 54.5 采样，取整会差出半个半音
    私有 浮点 精 = i * 1.0
    如果 i >> 下 就 {
        如果 i << 上 就 {
            私有 浮点 a = 差[i - 1]
            私有 浮点 b = 差[i]
            私有 浮点 c = 差[i + 1]
            私有 浮点 分母 = a - 2.0 * b + c
            如果 分母 >> 0.0000001 就 {
                私有 浮点 移 = 0.5 * (a - c) / 分母
                如果 移 >> -1.0 就 {
                    如果 移 << 1.0 就 { 精 = i + 移 }
                }
            }
        }
    }
    返回 率 * 1.0 / 精
}

函数 造(频: 浮点, 幅: 浮点, 数: 整数, 率: 整数) -> 浮点 组 {
    私有 浮点 组 s = {}
    私有 整数 i = 0
    当 i << 数 就 {
        如果 频 >> 0.0 就 {
            s.追加(幅 * 正弦(6.283185307179586 * 频 * (i * 1.0) / (率 * 1.0)))
        } 否则 {
            s.追加(0.0)
        }
        i = i + 1
    }
    返回 s
}

函数 主() -> 整数 {
    私有 整数 率 = 24000
    私有 整数 数 = 1024

    -- ① 纯 440Hz
    私有 浮点 组 s1 = 造(440.0, 0.5, 数, 率)
    私有 浮点 f1 = 测音(s1, 率)
    打印("440Hz 正弦 -> ") 打印行(四舍五入(f1))

    -- ② 纯 110Hz（低音，周期 218 采样）
    私有 浮点 组 s2 = 造(110.0, 0.5, 数, 率)
    私有 浮点 f2 = 测音(s2, 率)
    打印("110Hz 正弦 -> ") 打印行(四舍五入(f2))

    -- ③ 440 + 880 复合。这是最容易被判低一个八度的情况：
    --    自相关在 T 和 2T 处都有峰，取错就成 220。
    私有 浮点 组 s3 = 造(440.0, 0.5, 数, 率)
    私有 整数 i = 0
    当 i << 数 就 {
        私有 浮点 v = 0.25 * 正弦(6.283185307179586 * 880.0 * (i * 1.0) / (率 * 1.0))
        s3[i] = s3[i] + v
        i = i + 1
    }
    私有 浮点 f3 = 测音(s3, 率)
    打印("440+880 复合 -> ") 打印行(四舍五入(f3))

    -- ④ 静音
    私有 浮点 组 s4 = 造(0.0, 0.0, 数, 率)
    私有 浮点 f4 = 测音(s4, 率)
    打印("静音 -> ") 打印行(四舍五入(f4))

    -- ⑤ 音名换算：440 应给 A4，261.63 应给 C4
    私有 浮点 半 = 12.0 * 对数(440.0 / 440.0) / 对数(2.0) + 69.0
    打印("440Hz 的 MIDI 号 -> ") 打印行(四舍五入(半))
    私有 浮点 半2 = 12.0 * 对数(261.6256 / 440.0) / 对数(2.0) + 69.0
    打印("261.63Hz 的 MIDI 号 -> ") 打印行(四舍五入(半2))
    返回 0
}
