模块 用例.大数

-- 大整数与小数。这个文件只碰纯计算，不读文件、不看时间，输出必然一样。
--
-- 重点是那些"边界"：除零、负数开方、指数越界、非法字符串、精度切换。
-- 这些地方 C 库各有各的脾气（整数除零是 UB、mpd 给 Infinity），
-- 简言把它们统一成"不崩、给个说得通的值"，这里逐条钉住。

-- 小助手：从字符串起一个大整数。失败就返回 0，测试里的输入都合法。
函数 大(s: 借用 字符串) -> 大整数 {
    结果[大整数, 字符串] r = 读大数(s)
    如果 r.是成功 就 { 返回 r.取值 }
    返回 大数(0)
}

函数 小(s: 借用 字符串) -> 小数 {
    结果[小数, 字符串] r = 读小数(s)
    如果 r.是成功 就 { 返回 r.取值 }
    返回 变小数(0.0)
}

-- 阶乘：最经典的"int64 装不下"的例子。20! 就已经过了 2^63。
函数 阶乘(n: 整数) -> 大整数 {
    私有 大整数 果 = 大数(1)
    私有 整数 i = 2
    当 i <= n 就 {
        果 = 果.乘(大数(i))
        i = i + 1
    }
    返回 果
}

-- 传参不用写 `借用`：大整数是"复制类型"（不可变 + 指针），
-- 这是拿"不可变"换掉一整片生命周期标注的直接结果。
函数 加倍(x: 大整数) -> 大整数 {
    返回 x.乘(大数(2))
}

函数 主() -> 整数 {
    -- ---------------- 大整数 ----------------
    私有 大整数 f20 = 阶乘(20)
    打印("20! ") 打印行(f20.文本())

    私有 大整数 f100 = 阶乘(100)
    打印("100! ") 打印行(f100.文本())
    打印("100! 位数 ") 打印行(f100.位())

    -- 100! / 99! 正好是 100（验乘法和除法互为逆运算）
    打印("100!/99! ") 打印行(f100.除(阶乘(99)).文本())
    打印("100!/100! ") 打印行(f100.除(f100).文本())

    -- 2 的幂
    私有 大整数 二 = 大数(2)
    私有 大整数 十 = 大数(10)
    私有 大整数 p1000 = 二.幂(1000)
    打印("2^1000 位数 ") 打印行(p1000.位())
    -- 末 10 位靠取余，不靠切字符串
    打印("2^1000 末10位 ") 打印行(p1000.余(十.幂(10)).文本())
    打印("2^1000 / 2^990 ") 打印行(p1000.除(二.幂(990)).文本())

    -- 平方根
    打印("2^100 的根 ") 打印行(二.幂(100).根().文本())
    打印("2 的根 ") 打印行(二.根().文本())

    -- 边界：全都不许崩
    打印("指数为负 ") 打印行(二.幂(-1).文本())
    打印("除零 ") 打印行(二.除(大数(0)).文本())
    打印("模零 ") 打印行(二.余(大数(0)).文本())
    打印("负数的根 ") 打印行(大数(0).减(大数(9)).根().文本())

    -- 余数与截断方向：向零截断，和 C 一致
    打印("-7 除 2 ") 打印行(大数(0).减(大数(7)).除(大数(2)).文本())
    打印("-7 余 2 ") 打印行(大数(0).减(大数(7)).余(大数(2)).文本())

    -- 进制前缀（字符串里的写法，和源码字面量是两回事）
    打印("0xff ") 打印行(大("0xff").文本())
    打印("0b1010 ") 打印行(大("0b1010").文本())
    打印("0o777 ") 打印行(大("0o777").文本())
    打印("带空格 ") 打印行(大("  42  ").文本())

    -- 比较
    打印("3 比 5 ") 打印行(大数(3).比(大数(5)))
    打印("5 比 3 ") 打印行(大数(5).比(大数(3)))
    打印("4 比 4 ") 打印行(大数(4).比(大数(4)))

    -- 赋值是复制指针，但对象不可变，所以改乙不影响甲
    私有 大整数 甲 = 大数(5)
    私有 大整数 乙 = 甲
    乙 = 乙.加(大数(1))
    打印("甲 ") 打印(甲.文本()) 打印(" 乙 ") 打印行(乙.文本())

    打印("加倍 21 ") 打印行(加倍(大数(21)).文本())

    -- 解析失败要给出人话，而不是崩掉
    私有 结果[大整数, 字符串] 坏 = 读大数("12abc")
    如果 坏.是失败 就 { 打印("坏输入 ") 打印行(坏.错误值) }
    私有 结果[大整数, 字符串] 空的 = 读大数("")
    如果 空的.是失败 就 { 打印行("空串也失败") }

    -- ---------------- 小数 ----------------
    定小数精度(34)
    打印("默认精度 ") 打印行(小数精度())

    -- 这几行是 double 做不到的事
    打印("0.1+0.2 ") 打印行(小("0.1").加(小("0.2")).文本())
    打印("0.1*3 ") 打印行(小("0.1").乘(小("3")).文本())
    打印("1-0.9 ") 打印行(小("1").减(小("0.9")).文本())

    打印("1/3 @34 ") 打印行(小("1").除(小("3")).文本())

    定小数精度(20)
    打印("1/3 @20 ") 打印行(小("1").除(小("3")).文本())

    定小数精度(5)
    打印("1/3 @5 ") 打印行(小("1").除(小("3")).文本())
    打印("2/3 @5 ") 打印行(小("2").除(小("3")).文本())

    定小数精度(34)
    打印("恢复 34 ") 打印行(小("1").除(小("3")).文本())

    -- 除零给 无穷，不崩
    打印("1/0 ") 打印行(小("1").除(小("0")).文本())

    -- 科学计数法输入，出来还是普通写法
    打印("1e10 ") 打印行(小("1e10").文本())
    打印("1e-10 ") 打印行(小("0.0000000001").文本())

    -- 浮点转过来会暴露 double 的真值：0.1 在二进制里不是 0.1
    打印("变小数(0.1) ") 打印行(变小数(0.1).文本())

    -- 比较
    打印("0.1 比 0.2 ") 打印行(小("0.1").比(小("0.2")))

    -- 两种数都能拼进同一行输出
    打印("拼一下 ") 打印(小("3.14").文本()) 打印(" / ") 打印行(f100.位())

    返回 0
}
