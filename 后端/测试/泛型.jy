模块 例子.泛型

函数 最大[T: 可比较](甲: T, 乙: T) -> T {
    如果 甲 >> 乙 就 { 返回 甲 }
    返回 乙
}

函数 最小[T: 可比较](甲: T, 乙: T) -> T {
    如果 甲 << 乙 就 { 返回 甲 }
    返回 乙
}

函数 三个最大[T: 可比较](甲: T, 乙: T, 丙: T) -> T {
    返回 最大(最大(甲, 乙), 丙)
}

函数 主() -> 整数 {
    打印("最大(3, 9) = ")
    打印行(最大(3, 9))
    打印("最大(1.5, 2.5) = ")
    打印行(最大(1.5, 2.5))
    打印("最大(\"abc\", \"abd\") = ")
    打印行(最大("abc", "abd"))
    打印("三个最大(7, 2, 5) = ")
    打印行(三个最大(7, 2, 5))
    打印("最小(3.0, -1.0) = ")
    打印行(最小(3.0, -1.0))
    返回 0
}
