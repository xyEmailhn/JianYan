模块 例子.构造

-- `新建 点{ ... }`：给结构体字面量一个显式的头。
--
-- 不写 新建 的时候，`点{1, 2}` 在语句开头会被拆成"名字 点 + 代码块 {1, 2}"，
-- 因为花括号有两种身份。所以以前只能在声明右边用 `点 p = {1, 2}`（靠左边的类型猜），
-- 表达式位置——返回、实参、组元素——一律写不出来。

结构 点 {
    x: 浮点
    y: 浮点
}

结构 段 {
    起: 点
    止: 点
    名: 字符串
}

函数 长度平方(s: 借用 段) -> 浮点 {
    私有 浮点 dx = s.止.x - s.起.x
    私有 浮点 dy = s.止.y - s.起.y
    返回 dx * dx + dy * dy
}

-- 结构体可以当返回值：表达式位置构造，这是以前做不到的
函数 中点(s: 借用 段) -> 点 {
    返回 新建 点{
        x: (s.起.x + s.止.x) * 0.5,
        y: (s.起.y + s.止.y) * 0.5
    }
}

函数 主() -> 整数 {
    -- 按名字给，顺序随便
    私有 点 a = 新建 点{ x: 1.0, y: 2.0 }
    -- 按声明顺序给
    私有 点 b = 新建 点{ 4.0, 6.0 }
    打印("a = (") 打印(a.x) 打印(", ") 打印(a.y) 打印行(")")
    打印("b = (") 打印(b.x) 打印(", ") 打印(b.y) 打印行(")")

    私有 段 s = 新建 段{ 起: a, 止: b, 名: "斜线" }
    打印("段：") 打印行(s.名)
    打印("长度平方 = ") 打印行(长度平方(s))

    私有 点 m = 中点(s)
    打印("中点 = (") 打印(m.x) 打印(", ") 打印(m.y) 打印行(")")

    -- 只给一部分字段：没给的 C 会清零
    私有 段 半 = 新建 段{ 止: b }
    打印("半段的起点 = (") 打印(半.起.x) 打印(", ") 打印(半.起.y) 打印行(")")

    -- 空构造 = 全零
    私有 点 零 = 新建 点{}
    打印("零 = (") 打印(零.x) 打印(", ") 打印(零.y) 打印行(")")
    返回 0
}
