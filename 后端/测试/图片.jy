模块 用例.图片

-- 图的读写会碰文件系统，所以只碰 /tmp 下一个固定名字，跑完不删（下次覆盖）。
-- 比的是"像素值对不对"，不是"PNG 字节流对不对"——后者会随 stb 版本变。

函数 合(r: 整数, g: 整数, b: 整数) -> 整数 {
    返回 r * 16777216 + g * 65536 + b * 256 + 255
}

函数 主() -> 整数 {
    私有 图 甲 = 新建图(8, 4)
    打印("宽高 ") 打印(甲.宽) 打印(" ") 打印行(甲.高)

    -- 新图默认是不透明黑
    打印("空白 ") 打印行(甲.取(0, 0))

    甲.设(0, 0, 合(255, 0, 0))
    甲.设(7, 3, 合(0, 0, 255))
    打印("红 ") 打印行(甲.取(0, 0))
    打印("蓝 ") 打印行(甲.取(7, 3))

    -- 越界要安静地返回 0，不能崩
    打印("越界 ") 打印行(甲.取(99, 99))

    私有 结果[空值, 字符串] 存 = 甲.存("/tmp/简言测试.png")
    如果 存.是成功 就 { 打印行("存 OK") } 否则 { 打印("存失败 ") 打印行(存.错误值) }

    -- 读回来，逐像素比对
    私有 结果[图, 字符串] 读 = 读图("/tmp/简言测试.png")
    如果 读.是成功 就 {
        私有 图 乙 = 读.取值
        打印("读回 ") 打印(乙.宽) 打印(" ") 打印行(乙.高)
        打印("红 ") 打印行(乙.取(0, 0))
        打印("蓝 ") 打印行(乙.取(7, 3))
    } 否则 {
        打印("读失败 ") 打印行(读.错误值)
    }

    -- 缩放：缩到一半，还是红色（左上角）
    私有 图 丙 = 甲.缩放(4, 2)
    打印("缩放 ") 打印(丙.宽) 打印(" ") 打印行(丙.高)

    -- 不存在的文件：失败，但错误信息里的人话要在
    私有 结果[图, 字符串] 无 = 读图("/tmp/简言没有这个文件.png")
    如果 无.是失败 就 { 打印行("失败符合预期") }

    -- 换个扩展名也认
    私有 结果[空值, 字符串] bmp = 甲.存("/tmp/简言测试.bmp")
    如果 bmp.是成功 就 { 打印行("bmp OK") }

    返回 0
}
