模块 用例.声音

-- 声音只有四个数：帧数、声道、采样率、样本指针。
-- 这个用例把四件事钉住：边界、句柄语义（放大不改原声）、
-- 16 位量化误差、以及失败时给不给得出人话。

函数 主() -> 整数 {
    声音 s = 新建声音(2400, 24000, 1)
    打印("帧数 ") 打印行(s.帧数)
    打印("采样率 ") 打印行(s.采样率)
    打印("声道 ") 打印行(s.声道)
    打印("时长 ") 打印行(s.时长)

    -- 新建出来必须是静音，不是随机内存
    打印("空白 ") 打印行(s.取(100, 0))

    s.设(0, 0, 0.5)
    s.设(1, 0, 0.0 - 0.25)
    s.设(2, 0, 1.5)
    打印("设 0 ") 打印行(s.取(0, 0))
    打印("设 1 ") 打印行(s.取(1, 0))
    打印("设 2 ") 打印行(s.取(2, 0))

    -- 越界：读给 0，写静默丢弃，都不许崩
    打印("越界读 ") 打印行(s.取(2400, 0))
    打印("越界读负 ") 打印行(s.取(0 - 1, 0))
    s.设(9999, 0, 9.0)
    打印("越界写后 ") 打印行(s.取(9999, 0))

    -- 混是累加，不是覆盖
    s.混(0, 0, 0.25)
    打印("混后 0 ") 打印行(s.取(0, 0))

    -- 放大不改原声（句柄语义下最容易踩的一脚）
    声音 倍 = s.放大(2.0)
    打印("放大后 0 ") 打印行(倍.取(0, 0))
    打印("原声 0 ") 打印行(s.取(0, 0))

    -- 归一化：峰值那一个样本正好 0.98
    声音 齐 = s.归一化()
    打印("归一化 2 ") 打印行(齐.取(2, 0))

    -- 存成 wav 再读回来，误差应当只有量化误差
    结果[空值, 字符串] w = s.存("/tmp/简言_声音测试.wav")
    如果 w.是失败 就 {
        打印("存失败 ") 打印行(w.错误值)
        返回 1
    }
    打印行("存 wav 成功")

    结果[声音, 字符串] r = 载入声音("/tmp/简言_声音测试.wav")
    如果 r.是失败 就 {
        打印("读回失败 ") 打印行(r.错误值)
        返回 1
    }
    声音 回 = r.取值
    打印("读回 帧数 ") 打印行(回.帧数)
    打印("读回 采样率 ") 打印行(回.采样率)
    打印("读回 0 ") 打印行(回.取(0, 0))
    打印("读回 1 ") 打印行(回.取(1, 0))

    -- 找不到文件：要给出能看懂的原因，不能静默返回空
    结果[声音, 字符串] 坏 = 载入声音("/tmp/没有这个文件.mp3")
    如果 坏.是失败 就 {
        打印("不存在 ") 打印行(坏.错误值)
    }

    返回 0
}
