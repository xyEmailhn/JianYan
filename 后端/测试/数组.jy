模块 例子.数组

函数 最大(数: 借用 整数 组) -> 整数 {
    私有 整数 大 = 数[0]
    对 x 在 数 {
        如果 x >> 大 就 { 大 = x }
    }
    返回 大
}

函数 倒序(数: 可变借用 整数 组) {
    数.反转()
}

函数 主() -> 整数 {
    私有 整数 组 数 = {8, 3, 15, 7, 22, 1}
    打印("长度 = ")
    打印行(#数)
    打印("最大 = ")
    打印行(最大(数))

    数.追加(99)
    打印("追加后长度 = ")
    打印行(#数)
    打印("包含 15 = ")
    打印行(数.包含(15))
    打印("包含 42 = ")
    打印行(数.包含(42))

    倒序(数)
    打印("倒序第一个 = ")
    打印行(数[0])

    数.排序()
    打印("排序后第一个 = ")
    打印行(数[0])
    打印("弹出 = ")
    打印行(数.弹出)
    打印("弹出后长度 = ")
    打印行(#数)

    私有 字符串 组 名 = {"甲", "乙", "丙"}
    打印("名字：")
    对 n 在 名 {
        打印(n)
        打印(" ")
    }
    打印行("")
    返回 0
}
