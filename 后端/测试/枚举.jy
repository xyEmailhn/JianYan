模块 例子.枚举型

枚举 形状 {
    圆(半径: 浮点)
    矩(宽: 浮点, 高: 浮点)
    点
}

函数 面积(s: 借用 形状) -> 浮点 {
    匹配 s {
        例 形状.圆(半径): { 返回 3.14159 * 半径 * 半径 }
        例 形状.矩(宽, 高): { 返回 宽 * 高 }
        例 形状.点: { 返回 0.0 }
    }
}

函数 名字(s: 借用 形状) -> 字符串 {
    匹配 s {
        例 形状.圆(半径): { 返回 "圆" }
        例 形状.矩(宽, 高): { 返回 "矩形" }
        例 形状.点: { 返回 "点" }
    }
}

函数 主() -> 整数 {
    私有 形状 a = 形状.圆(2.0)
    私有 形状 b = 形状.矩(3.0, 4.0)
    私有 形状 c = 形状.点

    打印(名字(a))
    打印(" 面积 ")
    打印行(面积(a))
    打印(名字(b))
    打印(" 面积 ")
    打印行(面积(b))
    打印(名字(c))
    打印(" 面积 ")
    打印行(面积(c))
    返回 0
}
