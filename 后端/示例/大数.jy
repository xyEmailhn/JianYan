模块 示例.大数

-- 这个示例只做一件事：把"int64 装不下、double 算不准"的两类问题，
-- 在同一次运行里摊开给你看。
--
-- 全部输出来自 libtommath（任意精度整数）和 mpdecimal（十进制浮点）。
-- 注意最后那条 double 对比：不是要证明浮点"坏"，而是让人看清
-- 0.1 + 0.1 + ... 十次为什么不是 1.0——这是十进制与二进制之间的事，
-- 跟精度位数没关系，加到 100 位也一样。

-- ------------------------------------------------------------ 大整数 --

函数 阶乘(n: 整数) -> 大整数 {
    私有 大整数 果 = 大数(1)
    私有 整数 i = 2
    当 i <= n 就 {
        果 = 果.乘(大数(i))
        i = i + 1
    }
    返回 果
}

-- 用 Stirling 公式给个量级估计，回头和真实位数对一下。
-- log10(n!) ≈ 0.5*log10(2πn) + n*(log10 n - log10 e)
函数 斯特林位数(n: 浮点) -> 整数 {
    -- 表达式不能跨行（换行就是语句结束），所以挤一行写
    私有 浮点 头 = 0.5 * 对数10(6.283185307179586 * n)
    私有 浮点 尾2 = n * (对数10(n) - 0.4342944819032518)
    私有 浮点 估 = 头 + 尾2
    -- 向下取整 返回浮点，转回整数再 +1
    返回 四舍五入(向下取整(估)) + 1
}

-- 斐波那契：第 300 项已经 63 位，第 1000 项 209 位
函数 斐波那契(n: 整数) -> 大整数 {
    私有 大整数 甲 = 大数(0)
    私有 大整数 乙 = 大数(1)
    私有 整数 i = 0
    当 i << n 就 {
        私有 大整数 新 = 甲.加(乙)
        甲 = 乙
        乙 = 新
        i = i + 1
    }
    返回 甲
}

-- -------------------------------------------------------------- 小数 --

-- atan(1/x) 的泰勒展开：1/x - 1/(3x³) + 1/(5x⁵) - ...
-- 每多一项，误差乘 1/x²。x = 5 时约 28 项得 40 位，
-- 这里跑 400 项，够 200 位用。
函数 反正切(倒: 整数) -> 小数 {
    私有 小数 x = 变小数(倒 * 1.0)
    私有 小数 反 = 变小数(1.0).除(x)
    私有 小数 平方 = 反.乘(反)
    私有 小数 项 = 反
    私有 小数 果 = 反
    私有 整数 k = 1
    当 k << 400 就 {
        项 = 项.乘(平方)
        私有 小数 份 = 项.除(变小数((2 * k + 1) * 1.0))
        如果 k % 2 == 1 就 {
            果 = 果.减(份)
        } 否则 {
            果 = 果.加(份)
        }
        k = k + 1
    }
    返回 果
}

-- Machin 公式：π/4 = 4·atan(1/5) - atan(1/239)
-- 1706 年提出，到今天还是算 π 最省事的办法之一：两项级数，都收敛得快。
函数 圆周率() -> 小数 {
    私有 小数 四分之一 = 反正切(5).乘(变小数(4.0)).减(反正切(239))
    返回 四分之一.乘(变小数(4.0))
}

函数 主() -> 整数 {
    -- ---------------- 整数：从 20! 到 1000! ----------------
    打印("20!  ") 打印(阶乘(20).文本())
    打印("   （int64 上限 ") 打印(9223372036854775807) 打印行("）")

    私有 大整数 千 = 阶乘(1000)
    打印("1000! 位数 ") 打印(千.位())
    打印("  Stirling 估 ") 打印行(斯特林位数(1000.0))

    -- 只有大整数能回答的问题：1000! 末尾有几个 0
    私有 大整数 十 = 大数(10)
    私有 大整数 尾 = 千
    私有 整数 零数 = 0
    当 尾.余(十).比(大数(0)) == 0 就 {
        尾 = 尾.除(十)
        零数 = 零数 + 1
    }
    打印("1000! 末尾 0 的个数 ") 打印行(零数)
    打印("1000! 去掉这些 0 之后，末 12 位 ") 打印行(尾.余(十.幂(12)).文本())

    -- ---------------- 2 的幂 ----------------
    私有 大整数 二 = 大数(2)
    私有 大整数 万 = 二.幂(10000)
    打印("2^10000 位数 ") 打印行(万.位())
    打印("2^10000 末 20 位 ") 打印行(万.余(十.幂(20)).文本())
    打印("2^10000 / 2^9990 ") 打印行(万.除(二.幂(9990)).文本())

    -- ---------------- 斐波那契 ----------------
    私有 大整数 第千 = 斐波那契(1000)
    打印("F(1000) 位数 ") 打印(第千.位())
    打印("  前 20 位 ") 打印行(第千.文本())

    -- ---------------- 高精度 π ----------------
    定小数精度(110)
    私有 小数 派 = 圆周率()
    定小数精度(100)
    -- 精度只在"下一次运算"时生效，所以要乘个 1 把 110 位的 π 舍到 100 位
    私有 小数 派百 = 派.乘(变小数(1.0))
    打印行("")
    打印行("π 的 100 位（Machin 公式，用小数算的）：")
    打印行(派百.文本())

    -- 用这 100 位 π 干点实事：算第一百万个数的正弦？不，算周长。
    -- 半径 1 的圆周长 = 2π，这里精确到 98 位小数。
    定小数精度(100)
    私有 小数 周长 = 派百.乘(变小数(2.0))
    打印("半径 1 的圆周长 ") 打印行(周长.文本())

    -- ---------------- 十进制 vs 二进制 ----------------
    打印行("")
    打印行("同一个循环，两种数：")
    私有 小数 十进 = 变小数(0.0)
    -- 0.1 必须先从文字读成十进制数；源码里的 0.1 是 double
    结果[小数, 字符串] 读 = 读小数("0.1")
    私有 小数 十分之一 = 变小数(0.0)
    如果 读.是成功 就 { 十分之一 = 读.取值 }
    私有 浮点 二进 = 0.0
    私有 整数 i = 0
    当 i << 10 就 {
        十进 = 十进.加(十分之一)
        二进 = 二进 + 0.1
        i = i + 1
    }
    打印("  小数累加 10 次 = ") 打印行(十进.文本())
    打印("  浮点累加 10 次 = ") 打印(二进)
    打印("   与 1.0 的差 ×1e17 = ") 打印行((二进 - 1.0) * 100000000000000000.0)

    -- ---------------- 复利 ----------------
    -- 一分钱每天翻倍，30 天。int64 勉强装得下，60 天就不行了。
    私有 大整数 钱 = 大数(1)
    钱 = 二.幂(30)
    打印行("")
    打印("一分钱翻倍 30 天 = ") 打印(钱.文本()) 打印行(" 分")
    打印("一分钱翻倍 60 天 = ") 打印(二.幂(60).文本()) 打印行(" 分")
    打印("一分钱翻倍 200 天 = ") 打印(二.幂(200).文本()) 打印行(" 分")

    返回 0
}
