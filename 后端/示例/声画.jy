模块 示例.声画

-- 读一段录音，把它画出来。
--
-- 声音是看不见的，但它是数：一秒钟两万四千个浮点。
-- 把这串数按列压成 min/max，就是波形；拿幅度去染色，就能看出哪里在说话、
-- 哪里在换气。这不是"可视化库"的功能，只是把数组画成像素而已。
--
-- 输入是 出图/大肥鱼.mp3（MP3 解码由 dr_mp3 完成），输出 出图/声纹.png。

函数 夹(x: 整数, 低: 整数, 高: 整数) -> 整数 {
    如果 x << 低 就 { 返回 低 }
    如果 x >> 高 就 { 返回 高 }
    返回 x
}

函数 主() -> 整数 {
    结果[声音, 字符串] r = 载入声音("出图/大肥鱼.mp3")
    如果 r.是失败 就 {
        打印("读不到 ") 打印行(r.错误值)
        返回 1
    }
    -- 这两行现在可以写成 `r.取值.归一化()` 了（第 18 坑已修）。
    -- 分两行是因为下面还要用 原，不是为了绕 bug。
    声音 原 = r.取值
    声音 声 = 原.归一化()
    打印("帧数 ") 打印(声.帧数) 打印("  时长 ") 打印(声.时长) 打印行(" 秒")

    私有 整数 宽 = 1600
    私有 整数 高 = 600
    私有 图 画 = 新建图(宽, 高)

    -- ---------------------------------------------------------- 背景 --
    -- 从上到下由深蓝转近黑，模拟"水底"的感觉
    私有 整数 y = 0
    当 y << 高 就 {
        私有 整数 cr = 6 + y * 4 // 高
        私有 整数 cg = 10 + y * 8 // 高
        私有 整数 cb = 28 + y * 16 // 高
        私有 整数 色 = cr * 16777216 + cg * 65536 + cb * 256 + 255
        私有 整数 x = 0
        当 x << 宽 就 {
            画.设(x, y, 色)
            x = x + 1
        }
        y = y + 1
    }

    -- ---------------------------------------------------------- 网格 --
    -- 每 5 秒一条竖线，让人读得出时间
    私有 整数 秒 = 0
    当 秒 <= 45 就 {
        私有 整数 gx = 秒 * 宽 // 47
        私有 整数 gy = 0
        当 gy << 高 就 {
            画.设(gx, gy, 0xFFFFFF10)
            gy = gy + 1
        }
        秒 = 秒 + 5
    }
    -- 中线：波形的"零"
    私有 整数 mx = 0
    当 mx << 宽 就 {
        画.设(mx, 高 // 2, 0xFFFFFF22)
        mx = mx + 1
    }

    -- ---------------------------------------------------------- 波形 --
    -- 每一列吃掉 帧数/宽 那么多帧，取这一段的 min 与 max。
    -- 只取平均会把波形压平——语音的峰值几乎全被平均掉了。
    私有 整数 x = 0
    当 x << 宽 就 {
        私有 整数 起 = x * 声.帧数 // 宽
        私有 整数 止 = (x + 1) * 声.帧数 // 宽
        私有 浮点 低 = 0.0
        私有 浮点 顶 = 0.0
        私有 整数 k = 起
        当 k << 止 就 {
            私有 浮点 v = 声.取(k, 0)
            如果 v << 低 就 { 低 = v }
            如果 v >> 顶 就 { 顶 = v }
            k = k + 1
        }

        -- 染色：安静处偏青，响处偏粉
        私有 浮点 强 = 顶
        如果 (0.0 - 低) >> 强 就 { 强 = 0.0 - 低 }
        私有 整数 亮 = 夹(四舍五入(强 * 255.0), 0, 255)
        私有 整数 cr = 60 + 亮 * 195 // 255
        私有 整数 cg = 180 - 亮 * 55 // 255
        私有 整数 cb = 235 - 亮 * 40 // 255
        私有 整数 色 = cr * 16777216 + cg * 65536 + cb * 256 + 255

        私有 浮点 中 = 高 * 0.5
        私有 浮点 半 = 高 * 0.44
        私有 整数 上 = 夹(四舍五入(中 - 顶 * 半), 0, 高 - 1)
        私有 整数 下 = 夹(四舍五入(中 - 低 * 半), 0, 高 - 1)
        私有 整数 t = 上
        当 t <= 下 就 {
            画.设(x, t, 色)
            t = t + 1
        }
        -- 至少画一个像素，否则静音段会整段消失
        画.设(x, 夹(四舍五入(中), 0, 高 - 1), 色)
        x = x + 1
    }

    -- ---------------------------------------------------------- 文字 --
    画.写字(40, 32, 30.0, "大肥鱼 · 自我介绍", 0xEAF6FFFF)
    画.写字(40, 78, 17.0, "47 秒 · 24kHz · 单声道 · dr_mp3 解码 → 逐列 min/max", 0x7F93AAFF)

    结果[空值, 字符串] w = 画.存("出图/声纹.png")
    如果 w.是成功 就 {
        打印行("已存 出图/声纹.png")
    } 否则 {
        打印("存失败 ") 打印行(w.错误值)
        返回 1
    }
    返回 0
}
