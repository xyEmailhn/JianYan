模块 示例.光线

-- 用简言写的光线追踪器。不调用任何 C 数学库：
-- 开方用牛顿迭代，幂次用连续平方，三角函数干脆避开。
-- 输出 PPM（P3 文本格式），第一行是尺寸。
--
-- 编译：简编译 示例/光线.jy -o 光线
-- 出图：./光线 > 光线.ppm
--
-- 上一版的球看着悬空，查下来是三件事：
--   1. 地板是一颗放大 200 倍的球，接缝处没法算接触阴影
--      现在换成真正的平面 y = -1，求交一行就够
--   2. 软阴影把"半弦长"当成了"垂距"用，判别式开方直接当距离，
--      结果贴地那圈几乎全亮——阴影丢了，球自然浮着
--   3. 球心 y 是随手写的，球底离地还有半个球高
--      现在球心一律写作 (0.0 - 1.0) + 半径
-- 另外补上：接触处的环境光遮蔽、地板倒影、伽马校正、棋盘格。

结构 三 {
    x: 浮点
    y: 浮点
    z: 浮点
}

结构 球 {
    心: 三
    半径: 浮点
    色: 三
}

-- 一次求交的结果。种：0 没打中，1 打中球，2 打中地面。
结构 碰 {
    种: 整数
    号: 整数
    t: 浮点
}

-- ---------------------------------------------------------------- 向量 --

函数 造(x: 浮点, y: 浮点, z: 浮点) -> 三 {
    私有 三 v = {x, y, z}
    返回 v
}

函数 加(a: 三, b: 三) -> 三 {
    返回 造(a.x + b.x, a.y + b.y, a.z + b.z)
}

函数 减(a: 三, b: 三) -> 三 {
    返回 造(a.x - b.x, a.y - b.y, a.z - b.z)
}

函数 乘(a: 三, k: 浮点) -> 三 {
    返回 造(a.x * k, a.y * k, a.z * k)
}

函数 点乘(a: 三, b: 三) -> 浮点 {
    返回 a.x * b.x + a.y * b.y + a.z * b.z
}

函数 开方(x: 浮点) -> 浮点 {
    如果 x << 0.0000001 就 { 返回 0.0 }
    私有 浮点 猜 = x
    私有 整数 i = 0
    当 i << 32 就 {
        猜 = (猜 + x / 猜) * 0.5
        i = i + 1
    }
    返回 猜
}

函数 归一(v: 三) -> 三 {
    私有 浮点 长 = 开方(点乘(v, v))
    如果 长 << 0.0000001 就 { 返回 造(0.0, 0.0, 0.0) }
    返回 乘(v, 1.0 / 长)
}

-- 没有 pow()，就用连续平方凑。h^32
函数 三十二次(x: 浮点) -> 浮点 {
    私有 浮点 a = x * x
    私有 浮点 b = a * a
    私有 浮点 c = b * b
    私有 浮点 d = c * c
    返回 d * d
}

函数 三次(x: 浮点) -> 浮点 {
    返回 x * x * x
}

函数 五次(x: 浮点) -> 浮点 {
    私有 浮点 a = x * x
    返回 a * a * x
}

函数 夹(x: 浮点) -> 浮点 {
    如果 x << 0.0 就 { 返回 0.0 }
    如果 x >> 1.0 就 { 返回 1.0 }
    返回 x
}

函数 混(a: 三, b: 三, k: 浮点) -> 三 {
    返回 造(a.x + (b.x - a.x) * k,
             a.y + (b.y - a.y) * k,
             a.z + (b.z - a.z) * k)
}

-- ---------------------------------------------------------------- 求交 --

函数 碰撞(起: 三, 向: 三, 球们: 借用 球 组) -> 碰 {
    私有 碰 果 = {0, -1, 1.0e30}

    私有 整数 i = 0
    当 i << #球们 就 {
        私有 三 oc = 减(起, 球们[i].心)
        私有 浮点 b = 点乘(oc, 向)
        私有 浮点 c = 点乘(oc, oc) - 球们[i].半径 * 球们[i].半径
        私有 浮点 判别 = b * b - c
        如果 判别 >> 0.0 就 {
            私有 浮点 t = 0.0 - b - 开方(判别)
            如果 t >> 0.001 就 {
                如果 t << 果.t 就 {
                    果.种 = 1
                    果.号 = i
                    果.t = t
                }
            }
        }
        i = i + 1
    }

    -- 地面是无限平面 y = -1。向.y 不为负就说明这条线往上走，碰不到地板。
    如果 向.y << -0.0001 就 {
        私有 浮点 t = (0.0 - 1.0 - 起.y) / 向.y
        如果 t >> 0.001 就 {
            如果 t << 果.t 就 {
                果.种 = 2
                果.号 = -1
                果.t = t
            }
        }
    }
    返回 果
}

-- 软阴影：从交点朝光源打一条线，看得见多少光。
--
-- 判别式 判别 = b² - c 展开就是 r² - 垂距²，也就是光线被球切下的
-- 半弦长平方——不是垂距本身。上一版把 开方(判别) 当垂距去算
-- "1 - d/r"，中心处恰好算出 0 遮挡，贴地那一圈于是全亮。
-- 正确的写法是拿半弦长当遮挡比例：正中穿过 ≈ 1，擦边 ≈ 0，
-- 中间连续过渡，阴影边缘自带半影。
函数 可见(点: 三, 光向: 三, 球们: 借用 球 组, 自号: 整数) -> 浮点 {
    私有 浮点 透 = 1.0
    私有 整数 i = 0
    当 i << #球们 就 {
        如果 i != 自号 就 {
            私有 三 oc = 减(点, 球们[i].心)
            私有 浮点 b = 点乘(oc, 光向)
            如果 b << 0.0 就 {
                私有 浮点 c = 点乘(oc, oc) - 球们[i].半径 * 球们[i].半径
                私有 浮点 判别 = b * b - c
                如果 判别 >> 0.0 就 {
                    私有 浮点 弦 = 开方(判别) / 球们[i].半径 * 1.05
                    如果 弦 >> 1.0 就 { 弦 = 1.0 }
                    透 = 透 * (1.0 - 0.95 * 弦 * 弦)
                }
            }
        }
        i = i + 1
    }
    返回 夹(透)
}

-- 接触阴影（环境光遮蔽）：离别的球越近，属于自己的天光越少。
-- 球底和地面挨着的那一圈，物理上本来就接收不到几缕天光。
-- 这一项加上去，"坐在地上"和"飘在空中"的差别立刻出来。
函数 遮蔽(点: 三, 自号: 整数, 球们: 借用 球 组) -> 浮点 {
    私有 浮点 和 = 0.0
    私有 整数 i = 0
    当 i << #球们 就 {
        如果 i != 自号 就 {
            私有 三 d = 减(点, 球们[i].心)
            私有 浮点 距 = 开方(点乘(d, d)) - 球们[i].半径
            如果 距 << 0.0 就 { 距 = 0.0 }
            私有 浮点 r2 = 球们[i].半径 * 球们[i].半径
            和 = 和 + r2 / (r2 + 距 * 距 * 1.6)
        }
        i = i + 1
    }
    返回 1.0 / (1.0 + 和 * 3.4)
}

-- ---------------------------------------------------------------- 天空 --

函数 天空(向: 三) -> 三 {
    私有 浮点 高 = 夹(向.y * 0.9 + 0.28)
    -- 天顶近黑 → 地平线冷灰蓝
    私有 三 色 = 混(造(0.060, 0.078, 0.115), 造(0.008, 0.014, 0.034), 高 * 高)
    -- 地平线附近一抹暖光：太阳在画面左后方
    私有 浮点 竖 = 向.y
    如果 竖 << 0.0 就 { 竖 = 0.0 - 竖 }
    私有 浮点 暖 = 夹(1.0 - 竖 * 6.5)
    返回 造(色.x + 暖 * 0.070, 色.y + 暖 * 0.042, 色.z + 暖 * 0.016)
}

-- ---------------------------------------------------------------- 着色 --

函数 追踪(起: 三, 向: 三, 球们: 借用 球 组, 深: 整数) -> 三 {
    私有 碰 h = 碰撞(起, 向, 球们)
    如果 h.种 == 0 就 { 返回 天空(向) }

    私有 三 点 = 加(起, 乘(向, h.t))
    私有 三 视 = 乘(向, -1.0)
    私有 三 光 = 归一(造(-0.58, 0.60, 0.55))
    私有 三 光色 = 造(1.00, 0.90, 0.78)

    -- ---------- 地面 ----------
    如果 h.种 == 2 就 {
        -- 棋盘格。格子随距离收窄，是画面里唯一明确的透视标尺。
        私有 整数 格x = 整数(点.x * 0.62)
        私有 整数 格z = 整数(点.z * 0.62)
        私有 三 底 = 造(0.150, 0.155, 0.170)
        如果 (格x + 格z) % 2 == 0 就 { 底 = 造(0.105, 0.109, 0.122) }
        -- 远处的格子会密到像素级，变成一片噪点。让格子随距离淡出，
        -- 混到两色的平均值上——这是抗锯齿里最省事的一招（远处等于平均值）。
        私有 浮点 淡 = 夹((h.t - 6.0) / 9.0)
        底 = 混(底, 造(0.128, 0.132, 0.146), 淡)

        私有 三 法 = 造(0.0, 1.0, 0.0)
        私有 浮点 漫 = 点乘(法, 光)
        私有 浮点 亮 = 可见(点, 光, 球们, -1)
        私有 浮点 ao = 遮蔽(点, -1, 球们)

        -- 环境光只给一点点：地板要暗下去，球才立得起来
        -- 环境光遮蔽压的虽然是环境光，但球挡住的不只是天光，
        -- 还有一大片漫射过来的光。所以近处连直射项一起收一点，
        -- 球底那一圈才会有一道"接缝"，看着才不是贴上去的。
        私有 浮点 接 = 0.26 + 0.74 * ao
        私有 三 色 = 造(底.x * (0.10 * ao + 漫 * 亮 * 1.90 * 接),
                         底.y * (0.10 * ao + 漫 * 亮 * 1.86 * 接),
                         底.z * (0.12 * ao + 漫 * 亮 * 1.78 * 接))

        -- 倒影：地板不是镜子，只有掠射角才亮（菲涅尔）。
        -- 正下方几乎看不见倒影，越往远越像水面——这是"平面"最强的暗示。
        如果 深 >> 0 就 {
            私有 浮点 正 = 夹(0.0 - 点乘(视, 法))
            私有 浮点 菲 = 0.26 + 0.42 * 五次(1.0 - 正)
            私有 三 反向 = 减(向, 乘(法, 2.0 * 点乘(向, 法)))
            私有 三 反色 = 追踪(加(点, 乘(法, 0.006)), 反向, 球们, 0)
            色 = 混(色, 乘(反色, 0.85), 菲 * ao)
        }

        -- 远处淡入天空，免得地板一直铺到画框外像块没边的板子
        私有 浮点 雾 = 夹((h.t - 10.0) / 22.0)
        返回 混(色, 天空(向), 雾 * 0.7)
    }

    -- ---------- 球 ----------
    私有 三 法 = 归一(减(点, 球们[h.号].心))
    私有 三 底 = 球们[h.号].色
    私有 浮点 漫 = 点乘(法, 光)
    如果 漫 << 0.0 就 { 漫 = 0.0 }
    私有 浮点 亮 = 可见(点, 光, 球们, h.号)
    私有 浮点 ao = 遮蔽(点, h.号, 球们)

    -- 高光：Blinn-Phong 半程向量，32 次方当"光滑度"
    私有 三 半 = 归一(加(光, 视))
    私有 浮点 高 = 点乘(法, 半)
    私有 浮点 反 = 0.0
    如果 高 >> 0.0 就 { 反 = 三十二次(高) * 亮 * 0.62 }

    -- 天光：法线朝上吃得更多，球底自然压暗。
    -- 注意这里必须乘材质颜色：天光是"照在漆面上"的光，
    -- 不是往画面上加一层白。上一版当白色加，红的球被冲成粉色。
    私有 浮点 天 = (法.y + 1.0) * 0.5

    -- 这里本来加过一道"轮廓光"，想在边缘透点冷光把球从背景里剥出来。
    -- 结果它在球底糊出一条蓝带，正好盖住接缝——那才是最该暗的地方。
    -- 主光在画面左前方，物理上也没有背后的冷光，删掉。
    私有 浮点 正 = 夹(0.0 - 点乘(视, 法))

    私有 三 色 = 造(底.x * (漫 * 亮 * 2.05 + 天 * 0.40 * ao),
                    底.y * (漫 * 亮 * 2.00 + 天 * 0.33 * ao),
                    底.z * (漫 * 亮 * 1.92 + 天 * 0.40 * ao))
    色 = 造(色.x + 反 * 光色.x, 色.y + 反 * 光色.y, 色.z + 反 * 光色.z)

    -- 球面反射邻居：只在掠射角给一点，正中几乎看不出
    如果 深 >> 0 就 {
        私有 浮点 菲 = 0.008 + 0.035 * 五次(1.0 - 正)
        私有 三 反向 = 减(向, 乘(法, 2.0 * 点乘(向, 法)))
        私有 三 反色 = 追踪(加(点, 乘(法, 0.006)), 反向, 球们, 0)
        色 = 混(色, 乘(反色, 0.55), 菲 * ao)
    }
    返回 色
}

-- ---------------------------------------------------------------- 像素 --

-- 伽马校正：光线算出来的是线性光，屏幕要的是 sRGB。
-- 少了这一步，暗部糊成一团、亮部又平——立体感就是这么丢的。
-- 没有 pow()，用 sqrt 打个补丁：sqrt 之后再往上抬一点，
-- 在 0.01~0.95 全程贴住 x^(1/2.2)，误差不到 0.01。
函数 伽马(x: 浮点) -> 浮点 {
    私有 浮点 s = 开方(夹(x))
    返回 夹(s * (1.0 + 0.09 * (1.0 - s)))
}

-- 定影：先做一次 ACES 曲线的近似，再上伽马。
-- 线性值直接上屏，亮部会一片白、暗部一团灰，中间调扁得像塑料。
-- 这条曲线只有加减乘除，不需要 pow：高光滚降，暗部压深，颜色反而更饱和。
函数 定影(x: 浮点) -> 浮点 {
    私有 浮点 v = 夹(x) * 1.18
    私有 浮点 y = (v * (2.51 * v + 0.03)) / (v * (2.43 * v + 0.59) + 0.14)
    返回 伽马(y)
}

函数 像素(px: 浮点, py: 浮点, 球们: 借用 球 组, 眼睛: 三, 宽: 浮点, 高: 浮点) -> 三 {
    私有 浮点 u = (px - 宽 * 0.5) / 宽 * 0.86
    私有 浮点 v = (高 * 0.5 - py) / 宽 * 0.86
    -- 相机略低头：地平线抬到画面上三分之一，脚下多留地板，空间才压得住
    私有 三 向 = 归一(造(u, v - 0.15, -1.0))
    私有 三 色 = 追踪(眼睛, 向, 球们, 1)
    -- 暗角：四角压一点，视线自然收到画面中间
    私有 浮点 dx = (px - 宽 * 0.5) / 宽
    私有 浮点 dy = (py - 高 * 0.5) / 高
    私有 浮点 暗 = 1.0 - (dx * dx + dy * dy) * 0.95
    返回 乘(色, 暗)
}

函数 主() -> 整数 {
    私有 整数 宽 = 640
    私有 整数 高 = 400

    -- 球心一律写作 "地面 + 半径"：底和地面严丝合缝，一颗都不许飘
    私有 球 组 球们 = {}
    球们.追加({造(0.00, (0.0 - 1.0) + 1.02, 0.00), 1.02, 造(0.62, 0.045, 0.032)})
    球们.追加({造(-1.78, (0.0 - 1.0) + 0.58, 0.45), 0.58, 造(0.030, 0.135, 0.560)})
    球们.追加({造(1.66, (0.0 - 1.0) + 0.40, 0.62), 0.40, 造(0.700, 0.310, 0.035)})

    私有 三 眼睛 = 造(0.0, 1.30, 7.10)

    打印行("P3")
    打印(宽)
    打印(" ")
    打印(高)
    打印行("")
    打印行("255")

    私有 整数 y = 0
    当 y << 高 就 {
        私有 整数 x = 0
        当 x << 宽 就 {
            -- 2×2 超采样
            私有 三 累 = 造(0.0, 0.0, 0.0)
            累 = 加(累, 像素(浮点(x) + 0.25, 浮点(y) + 0.25, 球们, 眼睛, 浮点(宽), 浮点(高)))
            累 = 加(累, 像素(浮点(x) + 0.75, 浮点(y) + 0.25, 球们, 眼睛, 浮点(宽), 浮点(高)))
            累 = 加(累, 像素(浮点(x) + 0.25, 浮点(y) + 0.75, 球们, 眼睛, 浮点(宽), 浮点(高)))
            累 = 加(累, 像素(浮点(x) + 0.75, 浮点(y) + 0.75, 球们, 眼睛, 浮点(宽), 浮点(高)))
            私有 三 色 = 乘(累, 0.25)

            打印(整数(定影(色.x) * 255.0))
            打印(" ")
            打印(整数(定影(色.y) * 255.0))
            打印(" ")
            打印(整数(定影(色.z) * 255.0))
            打印(" ")
            x = x + 1
        }
        打印行("")
        y = y + 1
    }
    返回 0
}
