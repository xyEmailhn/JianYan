模块 示例.光线

-- 用简言写的光线追踪器。不调用任何 C 数学库：
-- 开方用牛顿迭代，向量运算自己写。
-- 输出 PPM（P3 文本格式），第一行是尺寸。
--
-- 编译：简编译 示例/光线.jy -o 光线
-- 出图：./光线 > 光线.ppm

结构 三 {
    x: 浮点
    y: 浮点
    z: 浮点
}

结构 球 {
    心: 三
    半径: 浮点
    色: 三
}

-- ---------------------------------------------------------------- 向量 --

函数 造(x: 浮点, y: 浮点, z: 浮点) -> 三 {
    私有 三 v = {x, y, z}
    返回 v
}

函数 加(a: 三, b: 三) -> 三 {
    私有 三 r = {a.x + b.x, a.y + b.y, a.z + b.z}
    返回 r
}

函数 减(a: 三, b: 三) -> 三 {
    私有 三 r = {a.x - b.x, a.y - b.y, a.z - b.z}
    返回 r
}

函数 乘(a: 三, k: 浮点) -> 三 {
    私有 三 r = {a.x * k, a.y * k, a.z * k}
    返回 r
}

函数 点乘(a: 三, b: 三) -> 浮点 {
    返回 a.x * b.x + a.y * b.y + a.z * b.z
}

函数 开方(x: 浮点) -> 浮点 {
    如果 x << 0.0000001 就 { 返回 0.0 }
    私有 浮点 猜 = x
    私有 整数 i = 0
    当 i << 40 就 {
        猜 = (猜 + x / 猜) * 0.5
        i = i + 1
    }
    返回 猜
}

函数 归一(v: 三) -> 三 {
    私有 浮点 长 = 开方(点乘(v, v))
    如果 长 << 0.0000001 就 { 返回 造(0.0, 0.0, 0.0) }
    返回 乘(v, 1.0 / 长)
}

-- ---------------------------------------------------------------- 求交 --

-- 返回最近的命中距离；没打中返回 -1。
-- 以 命中的球 作为「输出参数」是麻烦事，这里改成返回球号，距离单独算一次。
函数 求交(起: 三, 向: 三, 球们: 借用 球 组) -> 整数 {
    私有 整数 最近 = -1
    私有 浮点 最近t = 1.0e30
    私有 整数 i = 0
    当 i << #球们 就 {
        私有 三 oc = 减(起, 球们[i].心)
        私有 浮点 b = 点乘(oc, 向)
        私有 浮点 c = 点乘(oc, oc) - 球们[i].半径 * 球们[i].半径
        私有 浮点 判别 = b * b - c
        如果 判别 >> 0.0 就 {
            私有 浮点 t = 0.0 - b - 开方(判别)
            如果 t >> 0.001 就 {
                如果 t << 最近t 就 {
                    最近t = t
                    最近 = i
                }
            }
        }
        i = i + 1
    }
    返回 最近
}

函数 命中距离(起: 三, 向: 三, 球们: 借用 球 组) -> 浮点 {
    私有 浮点 最近t = 1.0e30
    私有 整数 i = 0
    当 i << #球们 就 {
        私有 三 oc = 减(起, 球们[i].心)
        私有 浮点 b = 点乘(oc, 向)
        私有 浮点 c = 点乘(oc, oc) - 球们[i].半径 * 球们[i].半径
        私有 浮点 判别 = b * b - c
        如果 判别 >> 0.0 就 {
            私有 浮点 t = 0.0 - b - 开方(判别)
            如果 t >> 0.001 就 {
                如果 t << 最近t 就 { 最近t = t }
            }
        }
        i = i + 1
    }
    返回 最近t
}

-- ---------------------------------------------------------------- 着色 --

-- 软阴影：从交点朝光源打一条线，被挡多少就暗多少
函数 可见(交点: 三, 光向: 三, 球们: 借用 球 组) -> 浮点 {
    私有 整数 i = 0
    私有 浮点 遮 = 1.0
    当 i << #球们 就 {
        私有 三 oc = 减(交点, 球们[i].心)
        私有 浮点 b = 点乘(oc, 光向)
        私有 浮点 c = 点乘(oc, oc) - 球们[i].半径 * 球们[i].半径
        私有 浮点 判别 = b * b - c
        如果 判别 >> 0.0 就 {
            私有 浮点 t = 0.0 - b - 开方(判别)
            如果 t >> 0.01 就 {
                -- 越靠近遮挡物，阴影越硬；这里简单地按距离削弱
                遮 = 遮 - 0.92 / (1.0 + t * 0.55)
            }
        }
        i = i + 1
    }
    如果 遮 << 0.0 就 { 返回 0.0 }
    返回 遮
}

函数 夹(x: 浮点) -> 浮点 {
    如果 x << 0.0 就 { 返回 0.0 }
    如果 x >> 1.0 就 { 返回 1.0 }
    返回 x
}

-- ---------------------------------------------------------------- 像素 --

函数 像素(px: 浮点, py: 浮点, 球们: 借用 球 组, 眼睛: 三, 光: 三, 宽: 浮点, 高: 浮点) -> 三 {
    私有 浮点 u = (px - 宽 * 0.5) / 宽 * 1.34
    私有 浮点 v = (高 * 0.5 - py) / 宽 * 1.34
    私有 三 向 = 归一(造(u, v, -1.55))

    -- 背景：上深下浅的渐变，让画面不闷
    私有 浮点 天向 = 0.5 - py / 高
    私有 三 色 = 造(0.10 + 天向 * 0.10, 0.12 + 天向 * 0.14, 0.19 + 天向 * 0.20)

    私有 整数 号 = 求交(眼睛, 向, 球们)
    如果 号 << 0 就 { 返回 色 }

    私有 浮点 t = 命中距离(眼睛, 向, 球们)
    私有 三 点 = 加(眼睛, 乘(向, t))
    私有 三 法 = 归一(减(点, 球们[号].心))

    -- 直接光
    私有 浮点 漫 = 点乘(法, 光)
    如果 漫 << 0.0 就 { 漫 = 0.0 }
    私有 浮点 光量 = 可见(点, 光, 球们)

    -- 环境光：法线朝上的地方吃更多天光，球底自然压暗
    私有 浮点 天 = (法.y + 1.0) * 0.5
    私有 浮点 亮 = 0.22 + 0.85 * 漫 * 光量

    -- 高光：Blinn-Phong 的半程向量，4 次方当"光滑度"
    私有 三 视 = 乘(向, -1.0)
    私有 三 半 = 归一(加(光, 视))
    私有 浮点 高 = 点乘(法, 半)
    私有 浮点 反 = 0.0
    如果 高 >> 0.0 就 {
        私有 浮点 高2 = 高 * 高
        私有 浮点 高4 = 高2 * 高2
        反 = 高4 * 光量 * 0.55
    }

    私有 三 底 = 球们[号].色
    返回 造(底.x * 亮 + 天 * 0.12 + 反,
             底.y * 亮 + 天 * 0.15 + 反,
             底.z * 亮 + 天 * 0.24 + 反)
}

函数 主() -> 整数 {
    私有 整数 宽 = 400
    私有 整数 高 = 250

    -- 场景：一颗主体球，两侧各一颗陪衬，下面一颗大球当地面
    私有 球 组 球们 = {}
    球们.追加({造(0.0, 0.10, 0.0), 1.12, 造(0.90, 0.30, 0.26)})
    球们.追加({造(-1.68, 0.34, 0.62), 0.62, 造(0.24, 0.50, 0.86)})
    球们.追加({造(1.62, 0.06, 0.70), 0.44, 造(0.94, 0.78, 0.26)})
    球们.追加({造(0.0, -201.0, 0.0), 200.0, 造(0.44, 0.46, 0.50)})

    私有 三 眼睛 = 造(0.0, 0.30, 6.0)
    私有 三 光 = 归一(造(-0.42, 0.80, 0.44))

    打印行("P3")
    打印(宽)
    打印(" ")
    打印(高)
    打印行("")
    打印行("255")

    私有 整数 y = 0
    当 y << 高 就 {
        私有 整数 x = 0
        当 x << 宽 就 {
            -- 2×2 超采样：每像素打四条线再平均。锯齿和噪点一起压下去。
            私有 三 累 = 造(0.0, 0.0, 0.0)
            累 = 加(累, 像素(浮点(x) + 0.25, 浮点(y) + 0.25, 球们, 眼睛, 光, 浮点(宽), 浮点(高)))
            累 = 加(累, 像素(浮点(x) + 0.75, 浮点(y) + 0.25, 球们, 眼睛, 光, 浮点(宽), 浮点(高)))
            累 = 加(累, 像素(浮点(x) + 0.25, 浮点(y) + 0.75, 球们, 眼睛, 光, 浮点(宽), 浮点(高)))
            累 = 加(累, 像素(浮点(x) + 0.75, 浮点(y) + 0.75, 球们, 眼睛, 光, 浮点(宽), 浮点(高)))
            私有 三 色 = 乘(累, 0.25)

            打印(整数(夹(色.x) * 255.0))
            打印(" ")
            打印(整数(夹(色.y) * 255.0))
            打印(" ")
            打印(整数(夹(色.z) * 255.0))
            打印(" ")
            x = x + 1
        }
        打印行("")
        y = y + 1
    }
    返回 0
}
