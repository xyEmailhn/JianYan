模块 示例.动画

-- 会动的光线追踪。
--
-- 和 光线.jy 是同一套求交、着色，区别只在相机：
-- 每一帧把眼睛绕着场景转 6°，六十帧正好一圈。
-- 光钉死在世界上不动，所以影子会从球身上扫过去——转台的灵魂在这。
--
-- 没有 sin / cos，怎么转？用旋转矩阵连乘：
--   x' = x·c - z·s
--   z' = x·s + z·c
-- 6° 的 c、s 是常数，事先算好写在代码里。每帧把眼睛转一次，
-- 六十次之后误差不到万分之一，够用了。
--
-- 编译：简编译 示例/动画.jy -o 动画
-- 出帧：./动画 > 帧.txt        （每帧前面一行 "帧 N"）
-- 合帧：见 出图.sh

结构 三 {
    x: 浮点
    y: 浮点
    z: 浮点
}

结构 球 {
    心: 三
    半径: 浮点
    色: 三
}

结构 碰 {
    种: 整数
    号: 整数
    t: 浮点
}

-- ---------------------------------------------------------------- 向量 --

函数 造(x: 浮点, y: 浮点, z: 浮点) -> 三 {
    私有 三 v = {x, y, z}
    返回 v
}

函数 加(a: 三, b: 三) -> 三 {
    返回 造(a.x + b.x, a.y + b.y, a.z + b.z)
}

函数 减(a: 三, b: 三) -> 三 {
    返回 造(a.x - b.x, a.y - b.y, a.z - b.z)
}

函数 乘(a: 三, k: 浮点) -> 三 {
    返回 造(a.x * k, a.y * k, a.z * k)
}

函数 点乘(a: 三, b: 三) -> 浮点 {
    返回 a.x * b.x + a.y * b.y + a.z * b.z
}

函数 叉乘(a: 三, b: 三) -> 三 {
    返回 造(a.y * b.z - a.z * b.y,
             a.z * b.x - a.x * b.z,
             a.x * b.y - a.y * b.x)
}

函数 开方(x: 浮点) -> 浮点 {
    如果 x << 0.0000001 就 { 返回 0.0 }
    私有 浮点 猜 = x
    私有 整数 i = 0
    当 i << 30 就 {
        猜 = (猜 + x / 猜) * 0.5
        i = i + 1
    }
    返回 猜
}

函数 归一(v: 三) -> 三 {
    私有 浮点 长 = 开方(点乘(v, v))
    如果 长 << 0.0000001 就 { 返回 造(0.0, 0.0, 0.0) }
    返回 乘(v, 1.0 / 长)
}

函数 三次(x: 浮点) -> 浮点 {
    返回 x * x * x
}

函数 五次(x: 浮点) -> 浮点 {
    私有 浮点 a = x * x
    返回 a * a * x
}

函数 三十二次(x: 浮点) -> 浮点 {
    私有 浮点 a = x * x
    私有 浮点 b = a * a
    私有 浮点 c = b * b
    私有 浮点 d = c * c
    返回 d * d
}

函数 夹(x: 浮点) -> 浮点 {
    如果 x << 0.0 就 { 返回 0.0 }
    如果 x >> 1.0 就 { 返回 1.0 }
    返回 x
}

函数 混(a: 三, b: 三, k: 浮点) -> 三 {
    返回 造(a.x + (b.x - a.x) * k,
             a.y + (b.y - a.y) * k,
             a.z + (b.z - a.z) * k)
}

-- ---------------------------------------------------------------- 求交 --

函数 碰撞(起: 三, 向: 三, 球们: 借用 球 组) -> 碰 {
    私有 碰 果 = {0, -1, 1.0e30}
    私有 整数 i = 0
    当 i << #球们 就 {
        私有 三 oc = 减(起, 球们[i].心)
        私有 浮点 b = 点乘(oc, 向)
        私有 浮点 c = 点乘(oc, oc) - 球们[i].半径 * 球们[i].半径
        私有 浮点 判别 = b * b - c
        如果 判别 >> 0.0 就 {
            私有 浮点 t = 0.0 - b - 开方(判别)
            如果 t >> 0.001 就 {
                如果 t << 果.t 就 {
                    果.种 = 1
                    果.号 = i
                    果.t = t
                }
            }
        }
        i = i + 1
    }
    如果 向.y << -0.0001 就 {
        私有 浮点 t = (0.0 - 1.0 - 起.y) / 向.y
        如果 t >> 0.001 就 {
            如果 t << 果.t 就 {
                果.种 = 2
                果.号 = -1
                果.t = t
            }
        }
    }
    返回 果
}

函数 可见(点: 三, 光向: 三, 球们: 借用 球 组, 自号: 整数) -> 浮点 {
    私有 浮点 透 = 1.0
    私有 整数 i = 0
    当 i << #球们 就 {
        如果 i != 自号 就 {
            私有 三 oc = 减(点, 球们[i].心)
            私有 浮点 b = 点乘(oc, 光向)
            如果 b << 0.0 就 {
                私有 浮点 c = 点乘(oc, oc) - 球们[i].半径 * 球们[i].半径
                私有 浮点 判别 = b * b - c
                如果 判别 >> 0.0 就 {
                    私有 浮点 弦 = 开方(判别) / 球们[i].半径 * 1.05
                    如果 弦 >> 1.0 就 { 弦 = 1.0 }
                    透 = 透 * (1.0 - 0.95 * 弦 * 弦)
                }
            }
        }
        i = i + 1
    }
    返回 夹(透)
}

函数 遮蔽(点: 三, 自号: 整数, 球们: 借用 球 组) -> 浮点 {
    私有 浮点 和 = 0.0
    私有 整数 i = 0
    当 i << #球们 就 {
        如果 i != 自号 就 {
            私有 三 d = 减(点, 球们[i].心)
            私有 浮点 距 = 开方(点乘(d, d)) - 球们[i].半径
            如果 距 << 0.0 就 { 距 = 0.0 }
            私有 浮点 r2 = 球们[i].半径 * 球们[i].半径
            和 = 和 + r2 / (r2 + 距 * 距 * 1.6)
        }
        i = i + 1
    }
    返回 1.0 / (1.0 + 和 * 3.4)
}

-- ---------------------------------------------------------------- 着色 --

函数 天空(向: 三) -> 三 {
    私有 浮点 高 = 夹(向.y * 0.9 + 0.28)
    私有 三 色 = 混(造(0.060, 0.078, 0.115), 造(0.008, 0.014, 0.034), 高 * 高)
    私有 浮点 竖 = 向.y
    如果 竖 << 0.0 就 { 竖 = 0.0 - 竖 }
    私有 浮点 暖 = 夹(1.0 - 竖 * 6.5)
    -- 太阳在左边：暖光也偏左，转台转过来时天边的颜色会跟着变
    如果 向.x << 0.0 就 { 暖 = 暖 * 1.25 }
    返回 造(色.x + 暖 * 0.070, 色.y + 暖 * 0.042, 色.z + 暖 * 0.016)
}

函数 追踪(起: 三, 向: 三, 球们: 借用 球 组, 深: 整数) -> 三 {
    私有 碰 h = 碰撞(起, 向, 球们)
    如果 h.种 == 0 就 { 返回 天空(向) }

    私有 三 点 = 加(起, 乘(向, h.t))
    私有 三 视 = 乘(向, -1.0)
    私有 三 光 = 归一(造(-0.58, 0.60, 0.55))
    私有 三 光色 = 造(1.00, 0.90, 0.78)

    如果 h.种 == 2 就 {
        私有 整数 格x = 整数(点.x * 0.62)
        私有 整数 格z = 整数(点.z * 0.62)
        私有 三 底 = 造(0.150, 0.155, 0.170)
        如果 (格x + 格z) % 2 == 0 就 { 底 = 造(0.105, 0.109, 0.122) }
        私有 浮点 淡 = 夹((h.t - 6.0) / 9.0)
        底 = 混(底, 造(0.128, 0.132, 0.146), 淡)

        私有 三 法 = 造(0.0, 1.0, 0.0)
        私有 浮点 漫 = 点乘(法, 光)
        私有 浮点 亮 = 可见(点, 光, 球们, -1)
        私有 浮点 ao = 遮蔽(点, -1, 球们)
        私有 浮点 接 = 0.26 + 0.74 * ao
        私有 三 色 = 造(底.x * (0.10 * ao + 漫 * 亮 * 1.90 * 接),
                         底.y * (0.10 * ao + 漫 * 亮 * 1.86 * 接),
                         底.z * (0.12 * ao + 漫 * 亮 * 1.78 * 接))

        如果 深 >> 0 就 {
            私有 浮点 正 = 夹(0.0 - 点乘(视, 法))
            私有 浮点 菲 = 0.26 + 0.42 * 五次(1.0 - 正)
            私有 三 反向 = 减(向, 乘(法, 2.0 * 点乘(向, 法)))
            私有 三 反色 = 追踪(加(点, 乘(法, 0.006)), 反向, 球们, 0)
            色 = 混(色, 乘(反色, 0.85), 菲 * ao)
        }
        私有 浮点 雾 = 夹((h.t - 10.0) / 22.0)
        返回 混(色, 天空(向), 雾 * 0.7)
    }

    私有 三 法 = 归一(减(点, 球们[h.号].心))
    私有 三 底 = 球们[h.号].色
    私有 浮点 漫 = 点乘(法, 光)
    如果 漫 << 0.0 就 { 漫 = 0.0 }
    私有 浮点 亮 = 可见(点, 光, 球们, h.号)
    私有 浮点 ao = 遮蔽(点, h.号, 球们)
    私有 三 半 = 归一(加(光, 视))
    私有 浮点 高 = 点乘(法, 半)
    私有 浮点 反 = 0.0
    如果 高 >> 0.0 就 { 反 = 三十二次(高) * 亮 * 0.62 }
    私有 浮点 天 = (法.y + 1.0) * 0.5

    私有 三 色 = 造(底.x * (漫 * 亮 * 2.05 + 天 * 0.30 * ao),
                    底.y * (漫 * 亮 * 2.00 + 天 * 0.33 * ao),
                    底.z * (漫 * 亮 * 1.92 + 天 * 0.40 * ao))
    返回 造(色.x + 反 * 光色.x, 色.y + 反 * 光色.y, 色.z + 反 * 光色.z)
}

-- ---------------------------------------------------------------- 定影 --

函数 定影(x: 浮点) -> 浮点 {
    私有 浮点 v = 夹(x) * 1.18
    私有 浮点 y = (v * (2.51 * v + 0.03)) / (v * (2.43 * v + 0.59) + 0.14)
    私有 浮点 s = 开方(夹(y))
    返回 夹(s * (1.0 + 0.09 * (1.0 - s)))
}

-- ---------------------------------------------------------------- 主 --

函数 主() -> 整数 {
    私有 整数 宽 = 480
    私有 整数 高 = 300
    私有 整数 总帧 = 60

    私有 球 组 球们 = {}
    球们.追加({造(0.00, (0.0 - 1.0) + 1.02, 0.00), 1.02, 造(0.62, 0.045, 0.032)})
    球们.追加({造(-1.78, (0.0 - 1.0) + 0.58, 0.45), 0.58, 造(0.030, 0.135, 0.560)})
    球们.追加({造(1.66, (0.0 - 1.0) + 0.40, 0.62), 0.40, 造(0.700, 0.310, 0.035)})

    -- 相机绕原点转：一开始在 +z，半径 7.1
    私有 浮点 眼x = 0.0
    私有 浮点 眼z = 7.10
    -- 6° 的余弦、正弦，写死在这里
    私有 浮点 步c = 0.994522
    私有 浮点 步s = 0.104528

    私有 整数 帧 = 0
    当 帧 << 总帧 就 {
        私有 三 眼 = 造(眼x, 1.42, 眼z)
        私有 三 目标 = 造(0.0, 0.05, 0.0)
        私有 三 前 = 归一(减(目标, 眼))
        私有 三 右 = 归一(叉乘(前, 造(0.0, 1.0, 0.0)))
        私有 三 上 = 叉乘(右, 前)

        -- 帧头：给下面的拆帧脚本一个记号
        打印("帧 ") 打印(帧) 打印行("")
        打印行("P3")
        打印(宽)
        打印(" ")
        打印(高)
        打印行("")
        打印行("255")

        私有 整数 y = 0
        当 y << 高 就 {
            私有 整数 x = 0
            当 x << 宽 就 {
                私有 三 累 = 造(0.0, 0.0, 0.0)
                私有 整数 子 = 0
                当 子 << 4 就 {
                    私有 浮点 偏x = 0.25
                    私有 浮点 偏y = 0.25
                    如果 子 == 1 就 { 偏x = 0.75 }
                    如果 子 == 2 就 { 偏y = 0.75 }
                    如果 子 == 3 就 { 偏x = 0.75  偏y = 0.75 }
                    私有 浮点 u = (浮点(x) + 偏x - 浮点(宽) * 0.5) / 浮点(宽) * 0.92
                    私有 浮点 v = (浮点(高) * 0.5 - 浮点(y) - 偏y) / 浮点(宽) * 0.92
                    私有 三 向 = 归一(加(前, 加(乘(右, u), 乘(上, v))))
                    累 = 加(累, 追踪(眼, 向, 球们, 1))
                    子 = 子 + 1
                }
                私有 三 色 = 乘(累, 0.25)
                打印(整数(定影(色.x) * 255.0))
                打印(" ")
                打印(整数(定影(色.y) * 255.0))
                打印(" ")
                打印(整数(定影(色.z) * 255.0))
                打印(" ")
                x = x + 1
            }
            打印行("")
            y = y + 1
        }

        -- 眼睛转一步：x' = x·c - z·s，z' = x·s + z·c
        私有 浮点 新x = 眼x * 步c - 眼z * 步s
        私有 浮点 新z = 眼x * 步s + 眼z * 步c
        眼x = 新x
        眼z = 新z
        帧 = 帧 + 1
    }
    返回 0
}
