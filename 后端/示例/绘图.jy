模块 示例.绘图

-- 用简言画一张矢量海报。
--
-- 不写 PPM，直接吐 SVG：文本格式，坐标想写几位写几位，
-- 出来是真正的矢量图，放大到 4000 宽也不糊。
--
-- 编译：简编译 示例/绘图.jy -o 绘图
-- 出图：./绘图 > 绘图.svg
--
-- 这张图里没有一行是手写的坐标：山脊是伪随机数滚出来的，
-- 星星是抖出来的，海面的碎光是按距离算的，船和鸟都是算出来的路径。

-- ---------------------------------------------------------------- 工具 --

-- 保留两位小数。SVG 里 0.30000001 这种尾巴只会让文件变大。
函数 数(x: 浮点) -> 字符串 {
    私有 整数 t = 整数(x * 100.0 + 0.5)
    返回 字符串(浮点(t) / 100.0)
}

-- Lehmer 伪随机。没有 rand()，就自己滚一个：
-- 种 = 种 * 16807 % 2147483647，够画山、撒星星用了。
函数 随(种: 整数) -> 整数 {
    返回 (种 * 16807) % 2147483647
}

-- 平滑插值：t 从 0 到 1，两头平、中间快，山脊才不会像折线。
函数 平滑(t: 浮点) -> 浮点 {
    返回 t * t * (3.0 - 2.0 * t)
}

-- 把一串控制点连成一条平滑的山脊路径。
-- 做法是"过中点画二次曲线"：每个原始点当控制点，中点当落点，
-- 接缝处切线连续，看起来是自然的山形而不是锯齿。
函数 山脊(宽: 整数, 基准: 浮点, 振幅: 浮点, 段: 整数, 种: 整数) {
    私有 整数 i = 0
    私有 整数 状 = 种
    私有 浮点 组 高组 = {}

    当 i << 段 就 {
        状 = 随(状)
        私有 浮点 抖 = 浮点(状 % 1000) / 1000.0
        高组.追加(基准 - 抖 * 振幅)
        i = i + 1
    }

    私有 浮点 步 = 浮点(宽) / 浮点(段 - 1)
    打印("M 0 ") 打印(数(高组[0]))

    i = 1
    当 i << 段 就 {
        -- 上一个中点到这一个中点，以控制点为把手
        私有 浮点 中x = 步 * (浮点(i) - 0.5)
        私有 浮点 中y = (高组[i - 1] + 高组[i]) * 0.5
        打印(" Q ") 打印(数(步 * 浮点(i - 1))) 打印(" ") 打印(数(高组[i - 1]))
        打印(" ") 打印(数(中x)) 打印(" ") 打印(数(中y))
        i = i + 1
    }
    打印(" L ") 打印(数(浮点(宽))) 打印(" ") 打印(数(高组[段 - 1]))
}

-- ---------------------------------------------------------------- 画面 --

函数 主() -> 整数 {
    私有 整数 宽 = 1200
    私有 整数 高 = 750
    私有 浮点 地平 = 470.0

    打印行("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1200\" height=\"750\" viewBox=\"0 0 1200 750\">")

    -- ---------------- 渐变 ----------------
    打印行("<defs>")
    打印行("<linearGradient id=\"天\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">")
    打印行("<stop offset=\"0\" stop-color=\"#070a18\"/>")
    打印行("<stop offset=\"0.40\" stop-color=\"#181430\"/>")
    打印行("<stop offset=\"0.68\" stop-color=\"#43203c\"/>")
    打印行("<stop offset=\"0.90\" stop-color=\"#8c3f38\"/>")
    打印行("<stop offset=\"1\" stop-color=\"#c96238\"/>")
    打印行("</linearGradient>")

    打印行("<linearGradient id=\"海\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">")
    打印行("<stop offset=\"0\" stop-color=\"#2b1a30\"/>")
    打印行("<stop offset=\"0.35\" stop-color=\"#1a1224\"/>")
    打印行("<stop offset=\"1\" stop-color=\"#07050c\"/>")
    打印行("</linearGradient>")

    打印行("<radialGradient id=\"日\" cx=\"0.5\" cy=\"0.5\" r=\"0.5\">")
    打印行("<stop offset=\"0\" stop-color=\"#fff8e2\"/>")
    打印行("<stop offset=\"0.45\" stop-color=\"#ffd287\"/>")
    打印行("<stop offset=\"1\" stop-color=\"#ff8a3d\" stop-opacity=\"0\"/>")
    打印行("</radialGradient>")

    打印行("<radialGradient id=\"晕\" cx=\"0.5\" cy=\"0.5\" r=\"0.5\">")
    打印行("<stop offset=\"0\" stop-color=\"#ffb066\" stop-opacity=\"0.42\"/>")
    打印行("<stop offset=\"0.45\" stop-color=\"#e2663f\" stop-opacity=\"0.13\"/>")
    打印行("<stop offset=\"1\" stop-color=\"#e2663f\" stop-opacity=\"0\"/>")
    打印行("</radialGradient>")

    打印行("<linearGradient id=\"暖雾\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">")
    打印行("<stop offset=\"0\" stop-color=\"#ff9a5a\" stop-opacity=\"0\"/>")
    打印行("<stop offset=\"0.55\" stop-color=\"#ff9a5a\" stop-opacity=\"0.16\"/>")
    打印行("<stop offset=\"1\" stop-color=\"#ff9a5a\" stop-opacity=\"0\"/>")
    打印行("</linearGradient>")

    打印行("<radialGradient id=\"暗角\" cx=\"0.5\" cy=\"0.46\" r=\"0.72\">")
    打印行("<stop offset=\"0.55\" stop-color=\"#000000\" stop-opacity=\"0\"/>")
    打印行("<stop offset=\"1\" stop-color=\"#000000\" stop-opacity=\"0.55\"/>")
    打印行("</radialGradient>")
    打印行("</defs>")

    -- ---------------- 天 ----------------
    打印行("<rect width=\"1200\" height=\"750\" fill=\"url(#天)\"/>")

    -- 星星：越靠上越密，靠近地平线就被霞光吃掉了
    私有 整数 星 = 0
    私有 整数 状 = 5
    当 星 << 46 就 {
        状 = 随(状)
        私有 浮点 星x = 浮点(状 % 1200)
        状 = 随(状)
        私有 浮点 星y = 浮点(状 % 300)
        状 = 随(状)
        私有 浮点 亮 = 0.10 + 浮点(状 % 60) / 160.0
        私有 浮点 大 = 0.6 + 浮点(状 % 7) / 8.0
        打印("<circle cx=\"") 打印(数(星x)) 打印("\" cy=\"") 打印(数(星y))
        打印("\" r=\"") 打印(数(大)) 打印("\" fill=\"#e8e6ff\" opacity=\"") 打印(数(亮)) 打印("\"/>")
        打印行("")
        星 = 星 + 1
    }

    -- 太阳：外圈是大光晕，里面一颗实心，压在地平线上方一点
    打印("<circle cx=\"806\" cy=\"400\" r=\"290\" fill=\"url(#晕)\"/>")
    打印行("")
    打印("<circle cx=\"806\" cy=\"400\" r=\"66\" fill=\"url(#日)\"/>")
    打印行("")

    -- 云带：几道被压扁的椭圆，只有一点点亮度
    私有 整数 云 = 0
    当 云 << 5 就 {
        私有 浮点 云y = 236.0 + 浮点(云) * 34.0
        私有 浮点 云x = 250.0 + 浮点(云) * 176.0
        私有 浮点 云宽 = 430.0 - 浮点(云) * 44.0
        打印("<ellipse cx=\"") 打印(数(云x)) 打印("\" cy=\"") 打印(数(云y))
        打印("\" rx=\"") 打印(数(云宽 * 0.5)) 打印("\" ry=\"") 打印(数(5.0 + 浮点(云) * 1.5))
        打印("\" fill=\"#ffb98a\" opacity=\"") 打印(数(0.045 + 浮点(云) * 0.012)) 打印("\"/>")
        打印行("")
        云 = 云 + 1
    }

    -- 鸟：三只，越远越小
    私有 整数 鸟 = 0
    当 鸟 << 3 就 {
        私有 浮点 鸟x = 268.0 + 浮点(鸟) * 52.0
        私有 浮点 鸟y = 196.0 + 浮点(鸟) * 15.0
        私有 浮点 翅 = 11.0 - 浮点(鸟) * 1.6
        打印("<path d=\"M ") 打印(数(鸟x - 翅)) 打印(" ") 打印(数(鸟y))
        打印(" Q ") 打印(数(鸟x - 翅 * 0.4)) 打印(" ") 打印(数(鸟y - 翅 * 0.75))
        打印(" ") 打印(数(鸟x)) 打印(" ") 打印(数(鸟y))
        打印(" Q ") 打印(数(鸟x + 翅 * 0.4)) 打印(" ") 打印(数(鸟y - 翅 * 0.75))
        打印(" ") 打印(数(鸟x + 翅)) 打印(" ") 打印(数(鸟y))
        打印("\" fill=\"none\" stroke=\"#0f0a18\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>")
        打印行("")
        鸟 = 鸟 + 1
    }

    -- ---------------- 远山 ----------------
    -- 三层，越近越黑：空气透视就是这样，远处的山被大气"洗"淡。
    -- 路径要收在地平线上，不能一路填到画框底——上一版就是这样
    -- 把整片海盖住了，船看起来停在半山腰。
    打印("<path d=\"") 打印(山脊(宽, 432.0, 36.0, 9, 7)) 打印(" L 1200 472 L 0 472 Z\" fill=\"#5c3f5c\" opacity=\"0.62\"/>")
    打印行("")
    打印("<path d=\"") 打印(山脊(宽, 452.0, 22.0, 7, 31)) 打印(" L 1200 472 L 0 472 Z\" fill=\"#2f2039\"/>")
    打印行("")
    打印("<path d=\"") 打印(山脊(宽, 464.0, 10.0, 6, 103)) 打印(" L 1200 472 L 0 472 Z\" fill=\"#180f24\"/>")
    打印行("")

    -- ---------------- 海 ----------------
    打印("<rect x=\"0\" y=\"") 打印(数(地平)) 打印("\" width=\"1200\" height=\"") 打印(数(浮点(高) - 地平)) 打印("\" fill=\"url(#海)\"/>")
    打印行("")

    -- 地平线上一道暖雾，把山脚和海面缝在一起
    打印行("<rect x=\"0\" y=\"404\" width=\"1200\" height=\"116\" fill=\"url(#暖雾)\"/>")

    -- 日光的倒影：不是一根亮柱子，是一片被浪切碎的光。
    -- 每行撒四五段，位置、宽窄、浓淡都抖一下；纵向也抖两像素，
    -- 否则几十行排下来还是一条虚线。
    私有 整数 条 = 0
    当 条 << 58 就 {
        私有 浮点 t = 浮点(条) / 58.0
        私有 浮点 条y = 地平 + 2.0 + t * t * 274.0
        私有 浮点 条宽 = 10.0 + t * t * 210.0
        私有 浮点 厚 = 0.9 + t * 1.9
        私有 整数 段 = 0
        当 段 << 4 就 {
            私有 整数 种 = (条 * 7919 + 段 * 104729 + 13) % 1000
            私有 浮点 抖 = 浮点(种) / 1000.0
            私有 整数 种2 = (条 * 2731 + 段 * 6151 + 97) % 1000
            私有 浮点 抖2 = 浮点(种2) / 1000.0
            私有 浮点 片宽 = 条宽 * (0.05 + 抖 * 0.10)
            私有 浮点 片x = 806.0 + (抖2 - 0.5) * 条宽
            私有 浮点 片y = 条y + (抖 - 0.5) * 4.0
            打印("<rect x=\"") 打印(数(片x - 片宽 * 0.5))
            打印("\" y=\"") 打印(数(片y))
            打印("\" width=\"") 打印(数(片宽))
            打印("\" height=\"") 打印(数(厚))
            打印("\" rx=\"") 打印(数(厚 * 0.5))
            打印("\" fill=\"#ffcf9a\" opacity=\"") 打印(数((0.30 - t * 0.20) * (0.35 + 抖 * 0.65))) 打印("\"/>")
            打印行("")
            段 = 段 + 1
        }
        条 = 条 + 1
    }

    -- 近处几道浪：细长的弧线，压住海面的"平"
    私有 整数 浪 = 0
    当 浪 << 8 就 {
        私有 浮点 浪y = 520.0 + 浮点(浪) * 26.0
        私有 浮点 浪x = 100.0 + 浮点((浪 * 173) % 700)
        私有 浮点 浪长 = 90.0 + 浮点((浪 * 61) % 140)
        打印("<path d=\"M ") 打印(数(浪x)) 打印(" ") 打印(数(浪y))
        打印(" Q ") 打印(数(浪x + 浪长 * 0.5)) 打印(" ") 打印(数(浪y - 3.2))
        打印(" ") 打印(数(浪x + 浪长)) 打印(" ") 打印(数(浪y))
        打印("\" fill=\"none\" stroke=\"#8d6a86\" stroke-width=\"1.2\" opacity=\"0.22\"/>")
        打印行("")
        浪 = 浪 + 1
    }

    -- ---------------- 一艘船 ----------------
    打印行("<g transform=\"translate(300 512) scale(0.92)\" fill=\"#0b0812\">")
    打印行("<path d=\"M -46 0 Q 0 22 46 0 L 34 14 Q 0 26 -34 14 Z\"/>")
    打印行("<rect x=\"-1.5\" y=\"-92\" width=\"3\" height=\"92\"/>")
    打印行("<path d=\"M 3 -86 L 44 -8 L 3 -8 Z\"/>")
    打印行("<path d=\"M -3 -74 L -38 -14 L -3 -14 Z\" opacity=\"0.85\"/>")
    打印行("</g>")
    -- 船底倒影：压扁、淡，跟船身对得上
    打印行("<g transform=\"translate(300 512) scale(0.92 -0.5)\" fill=\"#0b0812\" opacity=\"0.30\">")
    打印行("<path d=\"M -46 0 Q 0 22 46 0 L 34 14 Q 0 26 -34 14 Z\"/>")
    打印行("</g>")

    -- ---------------- 字 ----------------
    打印行("<g font-family=\"'Noto Serif CJK SC','Songti SC',serif\">")
    打印行("<text x=\"92\" y=\"604\" font-size=\"104\" fill=\"#120c18\" opacity=\"0.5\" letter-spacing=\"10\">简言</text>")
    打印行("<text x=\"90\" y=\"600\" font-size=\"104\" fill=\"#f7f0e4\" letter-spacing=\"10\">简言</text>")
    打印行("<text x=\"96\" y=\"640\" font-size=\"14\" fill=\"#c9a887\" letter-spacing=\"8\">JIAN YAN</text>")
    打印行("</g>")
    打印行("<rect x=\"96\" y=\"656\" width=\"58\" height=\"2\" fill=\"#c9a887\" opacity=\"0.85\"/>")
    打印行("<g font-family=\"'Noto Sans CJK SC','PingFang SC',sans-serif\">")
    打印行("<text x=\"96\" y=\"690\" font-size=\"21\" fill=\"#bab0a2\">一门写起来像说话的语言</text>")
    打印行("<text x=\"1120\" y=\"44\" font-size=\"12\" fill=\"#7a7088\" text-anchor=\"end\">示例/绘图.jy · 1200×750 · 纯矢量输出</text>")
    打印行("</g>")

    -- 暗角收边
    打印行("<rect width=\"1200\" height=\"750\" fill=\"url(#暗角)\"/>")

    打印行("</svg>")
    返回 0
}
