模块 示例.绘图

-- 用简言画一张矢量海报。
--
-- 不写 PPM，直接吐 SVG：文本格式，坐标想写几位写几位，
-- 出来是真正的矢量图，放大到 4000 宽也不糊。
--
-- 编译：简编译 示例/绘图.jy -o 绘图
-- 出图：./绘图 > 绘图.svg
--
-- 这张图里没有一行是手写的坐标：山脊是伪随机数滚出来的，
-- 星星是抖出来的，海面的碎光是按距离算的，船和鸟都是算出来的路径。

-- ---------------------------------------------------------------- 工具 --

-- 保留两位小数。SVG 里 0.30000001 这种尾巴只会让文件变大。
函数 数(x: 浮点) -> 字符串 {
    私有 整数 t = 整数(x * 100.0 + 0.5)
    返回 字符串(浮点(t) / 100.0)
}

-- Lehmer 伪随机。没有 rand()，就自己滚一个：
-- 种 = 种 * 16807 % 2147483647，够画山、撒星星用了。
函数 随(种: 整数) -> 整数 {
    返回 (种 * 16807) % 2147483647
}

-- 平滑插值：t 从 0 到 1，两头平、中间快。
函数 平滑(t: 浮点) -> 浮点 {
    返回 t * t * (3.0 - 2.0 * t)
}

-- 太阳附近的"垭口"：山到这里压低，让落日的下半截能衔在山脊上。
--
-- 这是上一版最缺的一笔。山脊是一条从头贯到尾的等高线，太阳要么整颗
-- 浮在它上面（看着像贴纸），要么被它削掉一半（看着像日食）。
-- 真山有山口，太阳是从山口落下去的——所以这里按到 806 的距离做一段
-- 平滑的"下凹"，中间的振幅只剩 22%，两侧恢复满高。
函数 垭口(x: 浮点) -> 浮点 {
    私有 浮点 d = x - 806.0
    如果 d << 0.0 就 { d = 0.0 - d }
    如果 d >> 190.0 就 { 返回 1.0 }
    返回 0.20 + 0.80 * 平滑(d / 190.0)
}

-- 一道山脊：输出一条【开放】折线，每个"峰"由肩 → 顶 → 下切 → 谷四笔组成。
--
-- 为什么是折线，不是上一版那种"过中点二次曲线"？
-- 因为山是尖的。二次曲线会把每个峰削成馒头，九个馒头连起来，
-- 远看就是一片起伏的雾——用户的原话是"你不说这是山，我还以为是太阳光"。
-- 真实的山剪影：一个尖顶，两侧是不对称的斜坡，峰与峰之间是低下去的鞍部。
-- 所以这里每座峰都带一个偏心的峰顶和一段陡的下切，峰高、偏心、肩高全随机。
函数 峰线(宽: 整数, 基准: 浮点, 振幅: 浮点, 峰数: 整数, 种: 整数) {
    私有 整数 状 = 种
    私有 浮点 步 = 浮点(宽) / 浮点(峰数)

    打印("M -60 ") 打印(数(基准))

    私有 整数 i = 0
    当 i << 峰数 就 {
        状 = 随(状)
        私有 浮点 抖 = 浮点(状 % 1000) / 1000.0      -- 峰有多高
        状 = 随(状)
        私有 浮点 抖2 = 浮点(状 % 1000) / 1000.0     -- 峰顶偏左还是偏右
        状 = 随(状)
        私有 浮点 抖3 = 浮点(状 % 1000) / 1000.0     -- 肩有多高

        私有 浮点 偏 = 0.30 + 抖2 * 0.40
        私有 浮点 峰x = 步 * (浮点(i) + 偏)
        私有 浮点 掩 = 垭口(峰x)
        -- 主次峰：每三座里有一座拔高，其余压到六成。
        -- 全一样高的山，看着像一排锯齿，不像一条山脉。
        私有 浮点 高 = 0.55 + 抖 * 0.45
        如果 i % 3 == 0 就 { 高 = 高 * 1.18 } 否则 { 高 = 高 * 0.72 }
        私有 浮点 顶 = 基准 - 振幅 * 高 * 掩

        -- 上坡的肩：让峰看起来不是等腰三角形
        私有 浮点 肩 = 顶 + 振幅 * (0.16 + 抖3 * 0.26) * 掩
        -- 下切：陡一点，山才有"背阴面"
        私有 浮点 切 = 顶 + 振幅 * (0.22 + 抖 * 0.26) * 掩

        -- 谷底：比基准略低，两个峰之间才有鞍部
        私有 浮点 谷 = 基准 - 振幅 * (0.02 + 抖3 * 0.10) * 垭口(步 * 浮点(i + 1))

        打印(" L ") 打印(数(步 * (浮点(i) + 偏 * 0.44))) 打印(" ") 打印(数(肩))
        打印(" L ") 打印(数(峰x)) 打印(" ") 打印(数(顶))
        打印(" L ") 打印(数(峰x + 步 * 0.13)) 打印(" ") 打印(数(切))
        -- 谷底不是一点，是一小段坡：先缓一下，再落到底
        打印(" L ") 打印(数(步 * (浮点(i + 1) - 0.16))) 打印(" ") 打印(数(谷 + 振幅 * 0.06 * 掩))
        打印(" L ") 打印(数(步 * 浮点(i + 1))) 打印(" ") 打印(数(谷))
        i = i + 1
    }
    打印(" L ") 打印(数(浮点(宽) + 60.0)) 打印(" ") 打印(数(基准))
}

-- 闭合版本：把脊线往下收到 底，成为一块可以填色的山体。
-- 注意必须收在山脚下（476），不能一路填到画框底——
-- 上一版就是这样把整片海盖住了，船看起来停在半山腰。
函数 山峰(宽: 整数, 基准: 浮点, 振幅: 浮点, 峰数: 整数, 种: 整数, 底: 浮点) {
    峰线(宽, 基准, 振幅, 峰数, 种)
    打印(" L ") 打印(数(浮点(宽) + 60.0)) 打印(" ") 打印(数(底))
    打印(" L -60 ") 打印(数(底))
    打印(" Z")
}

-- ---------------------------------------------------------------- 画面 --

函数 主() -> 整数 {
    私有 整数 宽 = 1200
    私有 整数 高 = 750
    私有 浮点 地平 = 470.0
    私有 浮点 日x = 806.0
    私有 浮点 日y = 402.0
    私有 浮点 日r = 57.0

    打印行("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1200\" height=\"750\" viewBox=\"0 0 1200 750\">")

    -- ---------------- 渐变 ----------------
    打印行("<defs>")
    打印行("<linearGradient id=\"天\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">")
    打印行("<stop offset=\"0\" stop-color=\"#070a18\"/>")
    打印行("<stop offset=\"0.38\" stop-color=\"#171331\"/>")
    打印行("<stop offset=\"0.66\" stop-color=\"#3d1e3c\"/>")
    打印行("<stop offset=\"0.88\" stop-color=\"#873b38\"/>")
    打印行("<stop offset=\"1\" stop-color=\"#cf6b3c\"/>")
    打印行("</linearGradient>")

    打印行("<linearGradient id=\"海\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">")
    打印行("<stop offset=\"0\" stop-color=\"#3a2233\"/>")
    打印行("<stop offset=\"0.30\" stop-color=\"#1b1226\"/>")
    打印行("<stop offset=\"1\" stop-color=\"#06040a\"/>")
    打印行("</linearGradient>")

    打印行("<radialGradient id=\"日\" cx=\"50%\" cy=\"50%\" r=\"50%\">")
    打印行("<stop offset=\"0\" stop-color=\"#fffaea\"/>")
    打印行("<stop offset=\"0.50\" stop-color=\"#ffd68c\"/>")
    打印行("<stop offset=\"1\" stop-color=\"#ff8a3d\" stop-opacity=\"0\"/>")
    打印行("</radialGradient>")

    打印行("<radialGradient id=\"晕\" cx=\"50%\" cy=\"50%\" r=\"50%\">")
    打印行("<stop offset=\"0\" stop-color=\"#ffb066\" stop-opacity=\"0.40\"/>")
    打印行("<stop offset=\"0.42\" stop-color=\"#e2663f\" stop-opacity=\"0.12\"/>")
    打印行("<stop offset=\"1\" stop-color=\"#e2663f\" stop-opacity=\"0\"/>")
    打印行("</radialGradient>")

    打印行("<linearGradient id=\"暖雾\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">")
    打印行("<stop offset=\"0\" stop-color=\"#ff9a5a\" stop-opacity=\"0\"/>")
    打印行("<stop offset=\"0.55\" stop-color=\"#ff9a5a\" stop-opacity=\"0.14\"/>")
    打印行("<stop offset=\"1\" stop-color=\"#ff9a5a\" stop-opacity=\"0\"/>")
    打印行("</linearGradient>")

    -- 倒影的底：一条很淡的竖直辉光，边是软的。
    -- 只有碎光没有底，光带会显得"干"；只有底没有碎光，又像一块抹布。
    打印行("<linearGradient id=\"山影\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">")
    打印行("<stop offset=\"0\" stop-color=\"#0a0614\" stop-opacity=\"0.60\"/>")
    打印行("<stop offset=\"0.35\" stop-color=\"#0a0614\" stop-opacity=\"0.26\"/>")
    打印行("<stop offset=\"0.72\" stop-color=\"#0a0614\" stop-opacity=\"0.07\"/>")
    打印行("<stop offset=\"1\" stop-color=\"#0a0614\" stop-opacity=\"0\"/>")
    打印行("</linearGradient>")

    打印行("<radialGradient id=\"倒影底\" cx=\"50%\" cy=\"50%\" r=\"50%\">")
    打印行("<stop offset=\"0\" stop-color=\"#ffbb78\" stop-opacity=\"0.20\"/>")
    打印行("<stop offset=\"0.45\" stop-color=\"#ff9a52\" stop-opacity=\"0.075\"/>")
    打印行("<stop offset=\"1\" stop-color=\"#ff8a3d\" stop-opacity=\"0\"/>")
    打印行("</radialGradient>")

    打印行("<radialGradient id=\"暗角\" cx=\"50%\" cy=\"46%\" r=\"72%\">")
    打印行("<stop offset=\"0.55\" stop-color=\"#000000\" stop-opacity=\"0\"/>")
    打印行("<stop offset=\"1\" stop-color=\"#000000\" stop-opacity=\"0.42\"/>")
    打印行("</radialGradient>")
    打印行("</defs>")

    -- ---------------- 天 ----------------
    打印行("<rect width=\"1200\" height=\"750\" fill=\"url(#天)\"/>")

    -- 星星：越靠上越密，靠近地平线就被霞光吃掉了
    私有 整数 星 = 0
    私有 整数 状 = 5
    当 星 << 46 就 {
        状 = 随(状)
        私有 浮点 星x = 浮点(状 % 1200)
        状 = 随(状)
        私有 浮点 星y = 浮点(状 % 300)
        状 = 随(状)
        私有 浮点 亮 = 0.10 + 浮点(状 % 60) / 160.0
        私有 浮点 大 = 0.6 + 浮点(状 % 7) / 8.0
        打印("<circle cx=\"") 打印(数(星x)) 打印("\" cy=\"") 打印(数(星y))
        打印("\" r=\"") 打印(数(大)) 打印("\" fill=\"#e8e6ff\" opacity=\"") 打印(数(亮)) 打印("\"/>")
        打印行("")
        星 = 星 + 1
    }

    -- 太阳：外圈是大光晕，里面一颗实心
    打印("<circle cx=\"") 打印(数(日x)) 打印("\" cy=\"") 打印(数(日y))
    打印("\" r=\"235\" fill=\"url(#晕)\"/>")
    打印行("")
    打印("<circle cx=\"") 打印(数(日x)) 打印("\" cy=\"") 打印(数(日y))
    打印("\" r=\"") 打印(数(日r)) 打印("\" fill=\"url(#日)\"/>")
    打印行("")

    -- 云带：几道被压扁的椭圆，只有一点点亮度
    私有 整数 云 = 0
    当 云 << 5 就 {
        私有 浮点 云y = 236.0 + 浮点(云) * 34.0
        私有 浮点 云x = 250.0 + 浮点(云) * 176.0
        私有 浮点 云宽 = 430.0 - 浮点(云) * 44.0
        打印("<ellipse cx=\"") 打印(数(云x)) 打印("\" cy=\"") 打印(数(云y))
        打印("\" rx=\"") 打印(数(云宽 * 0.5)) 打印("\" ry=\"") 打印(数(5.0 + 浮点(云) * 1.5))
        打印("\" fill=\"#ffb98a\" opacity=\"") 打印(数(0.045 + 浮点(云) * 0.012)) 打印("\"/>")
        打印行("")
        云 = 云 + 1
    }

    -- 鸟：三只，越远越小
    私有 整数 鸟 = 0
    当 鸟 << 3 就 {
        私有 浮点 鸟x = 268.0 + 浮点(鸟) * 52.0
        私有 浮点 鸟y = 196.0 + 浮点(鸟) * 15.0
        私有 浮点 翅 = 11.0 - 浮点(鸟) * 1.6
        打印("<path d=\"M ") 打印(数(鸟x - 翅)) 打印(" ") 打印(数(鸟y))
        打印(" Q ") 打印(数(鸟x - 翅 * 0.4)) 打印(" ") 打印(数(鸟y - 翅 * 0.75))
        打印(" ") 打印(数(鸟x)) 打印(" ") 打印(数(鸟y))
        打印(" Q ") 打印(数(鸟x + 翅 * 0.4)) 打印(" ") 打印(数(鸟y - 翅 * 0.75))
        打印(" ") 打印(数(鸟x + 翅)) 打印(" ") 打印(数(鸟y))
        打印("\" fill=\"none\" stroke=\"#0f0a18\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>")
        打印行("")
        鸟 = 鸟 + 1
    }

    -- ---------------- 山 ----------------
    -- 三层，越近越黑：空气透视就是这样，远处的山被大气"洗"淡。
    -- 每层都描一条极淡的脊线——这一笔比什么都管用，
    -- 它把"这是山的轮廓"直接告诉眼睛，比堆颜色快得多。

    -- 远山：最淡，峰也最密
    打印("<path d=\"")
    山峰(宽, 458.0, 92.0, 9, 17, 480.0)
    打印("\" fill=\"#4a3552\"/>")
    打印行("")
    打印("<path d=\"")
    峰线(宽, 458.0, 92.0, 9, 17)
    打印("\" fill=\"none\" stroke=\"#ffcfae\" stroke-width=\"1.2\" opacity=\"0.24\"/>")
    打印行("")

    -- 中山
    打印("<path d=\"")
    山峰(宽, 466.0, 70.0, 7, 91, 480.0)
    打印("\" fill=\"#2b1c37\"/>")
    打印行("")

    -- 近山：几乎纯黑，峰最少也最大
    打印("<path d=\"")
    山峰(宽, 472.0, 44.0, 5, 233, 480.0)
    打印("\" fill=\"#120c1b\"/>")
    打印行("")

    -- ---------------- 海 ----------------
    打印("<rect x=\"0\" y=\"") 打印(数(地平)) 打印("\" width=\"1200\" height=\"") 打印(数(浮点(高) - 地平)) 打印("\" fill=\"url(#海)\"/>")
    打印行("")

    -- 山脚在水里的暗部。
    -- 少了这一条，山和海面就是两张贴在一起的纸——山"站"在水上，
    -- 而不是"伸进"水里。真实的水面一定先映出近岸的暗，才轮得到日光。
    打印行("<rect x=\"0\" y=\"470\" width=\"1200\" height=\"62\" fill=\"url(#山影)\"/>")

    -- 地平线上一道暖雾，把山脚和海面缝在一起
    打印行("<rect x=\"0\" y=\"404\" width=\"1200\" height=\"116\" fill=\"url(#暖雾)\"/>")

    -- ---------------- 日光倒影 ----------------
    -- 水面上的倒影不是一根光柱，是"被浪切成一段一段、越远越散"的光。
    --
    -- 上一版的毛病：72 行，每行独立撒四段，段的横坐标各自随机。
    -- 于是每一行的位置都对不上，连起来就是一座斜塔——用户圈出来问"这是什么"。
    -- 现在的做法：
    --   1. 先铺一层很淡的竖直辉光当底，把光带的大形给出来；
    --   2. 每行只画一条主光斑，宽度随距离扩展，中心固定在太阳正下方；
    --   3. 再撒两条侧光斑，位置由主光斑往两侧推，不另起随机；
    --   4. 行距用 t*t，近处稀、远处密，跟透视一致。
    打印("<ellipse cx=\"") 打印(数(日x)) 打印("\" cy=\"560\" rx=\"72\" ry=\"225\" fill=\"url(#倒影底)\"/>")
    打印行("")

    私有 整数 条 = 0
    当 条 << 64 就 {
        私有 浮点 t = 浮点(条) / 64.0
        -- 行距：一半线性一半平方。纯平方会把前二十行全挤在地平线上一两个像素里，
        -- 叠成一根死亮的竖条——那正是"塔"的来源。
        私有 浮点 条y = 地平 + 2.0 + (t * 0.5 + t * t * 0.5) * 260.0
        私有 整数 种1 = (条 * 7919 + 13) % 1000
        私有 浮点 抖 = 浮点(种1) / 1000.0
        私有 整数 种2 = (条 * 2731 + 97) % 1000
        私有 浮点 抖2 = 浮点(种2) / 1000.0
        私有 整数 种3 = (条 * 5591 + 211) % 1000
        私有 浮点 抖3 = 浮点(种3) / 1000.0

        -- 光带的宽度也跟着抖，不然两条边会是一条笔直的斜线，一眼就是"塔"
        私有 浮点 宽基 = (18.0 + t * t * 96.0) * (0.62 + 抖 * 0.76)

        -- 约两成的行干脆不画。水面的反光本来就是断断续续的，
        -- 行行都亮、行行等长，连起来就是一把梯子。
        如果 抖2 >> (0.06 + t * 0.34) 就 {
            -- 宽度从"一小截"到"跨过整条光带"都有，水面的反光本来就是这样
            私有 浮点 主宽 = 宽基 * (0.42 + 抖 * 1.15)
            -- 两个随机数相加再减一，分布往中间聚：中间密、两边稀
            私有 浮点 主x = 日x + (抖 + 抖3 - 1.0) * 宽基 * 1.35
            私有 浮点 主y = 条y + (抖 - 0.5) * 4.5
            私有 浮点 厚 = 0.8 + 抖3 * 1.7
            私有 浮点 亮 = (0.34 - t * t * 0.30) * (0.30 + 抖 * 0.70)

            打印("<rect x=\"") 打印(数(主x - 主宽 * 0.5))
            打印("\" y=\"") 打印(数(主y))
            打印("\" width=\"") 打印(数(主宽))
            打印("\" height=\"") 打印(数(厚))
            打印("\" rx=\"") 打印(数(厚 * 0.62))
            打印("\" fill=\"#ffd39c\" opacity=\"") 打印(数(亮)) 打印("\"/>")
            打印行("")

            -- 三成的行再往两侧甩一小片散光。
            -- 只有中轴一条，倒影就是一根羽毛；撒开几片，才像整片水面在反光。
            如果 抖3 >> 0.66 就 {
                私有 浮点 散向 = 1.0
                如果 抖2 >> 0.5 就 { 散向 = 0.0 - 1.0 }
                私有 浮点 散宽 = 宽基 * (0.08 + 抖 * 0.22)
                私有 浮点 散x = 主x + 散向 * 宽基 * (0.85 + 抖2 * 0.9)
                打印("<rect x=\"") 打印(数(散x - 散宽 * 0.5))
                打印("\" y=\"") 打印(数(主y + (抖2 - 0.5) * 2.0))
                打印("\" width=\"") 打印(数(散宽))
                打印("\" height=\"") 打印(数(厚 * 0.75))
                打印("\" rx=\"") 打印(数(厚 * 0.35))
                打印("\" fill=\"#ffcf9a\" opacity=\"") 打印(数(亮 * 0.55)) 打印("\"/>")
                打印行("")
            }

            -- 偶尔两行靠得很近、亮度加起来像"浪尖闪了一下"
            如果 抖 >> 0.80 就 {
                打印("<rect x=\"") 打印(数(主x - 主宽 * 0.22))
                打印("\" y=\"") 打印(数(主y + 3.0))
                打印("\" width=\"") 打印(数(主宽 * 0.44))
                打印("\" height=\"") 打印(数(厚 * 1.2))
                打印("\" rx=\"") 打印(数(厚 * 0.6))
                打印("\" fill=\"#fff0d0\" opacity=\"") 打印(数(亮 * 1.5)) 打印("\"/>")
                打印行("")
            }
        }
        条 = 条 + 1
    }

    -- 近处几道浪：细长的弧线，压住海面的"平"
    私有 整数 浪 = 0
    当 浪 << 8 就 {
        私有 浮点 浪y = 520.0 + 浮点(浪) * 26.0
        私有 浮点 浪x = 100.0 + 浮点((浪 * 173) % 700)
        私有 浮点 浪长 = 90.0 + 浮点((浪 * 61) % 140)
        打印("<path d=\"M ") 打印(数(浪x)) 打印(" ") 打印(数(浪y))
        打印(" Q ") 打印(数(浪x + 浪长 * 0.5)) 打印(" ") 打印(数(浪y - 3.2))
        打印(" ") 打印(数(浪x + 浪长)) 打印(" ") 打印(数(浪y))
        打印("\" fill=\"none\" stroke=\"#8d6a86\" stroke-width=\"1.2\" opacity=\"0.20\"/>")
        打印行("")
        浪 = 浪 + 1
    }

    -- ---------------- 一艘船 ----------------
    打印行("<g transform=\"translate(300 512) scale(0.92)\" fill=\"#0b0812\">")
    打印行("<path d=\"M -46 0 Q 0 22 46 0 L 34 14 Q 0 26 -34 14 Z\"/>")
    打印行("<rect x=\"-1.5\" y=\"-92\" width=\"3\" height=\"92\"/>")
    打印行("<path d=\"M 3 -86 L 44 -8 L 3 -8 Z\"/>")
    打印行("<path d=\"M -3 -74 L -38 -14 L -3 -14 Z\" opacity=\"0.85\"/>")
    打印行("</g>")
    -- 船底倒影：压扁、淡，跟船身对得上
    打印行("<g transform=\"translate(300 512) scale(0.92 -0.5)\" fill=\"#0b0812\" opacity=\"0.28\">")
    打印行("<path d=\"M -46 0 Q 0 22 46 0 L 34 14 Q 0 26 -34 14 Z\"/>")
    打印行("</g>")

    -- ---------------- 字 ----------------
    打印行("<g font-family=\"'Noto Serif CJK SC','Songti SC',serif\">")
    打印行("<text x=\"92\" y=\"604\" font-size=\"104\" fill=\"#120c18\" opacity=\"0.5\" letter-spacing=\"10\">简言</text>")
    打印行("<text x=\"90\" y=\"600\" font-size=\"104\" fill=\"#f7f0e4\" letter-spacing=\"10\">简言</text>")
    打印行("<text x=\"96\" y=\"640\" font-size=\"14\" fill=\"#c9a887\" letter-spacing=\"8\">JIAN YAN</text>")
    打印行("</g>")
    打印行("<rect x=\"96\" y=\"656\" width=\"58\" height=\"2\" fill=\"#c9a887\" opacity=\"0.85\"/>")
    打印行("<g font-family=\"'Noto Sans CJK SC','PingFang SC',sans-serif\">")
    打印行("<text x=\"96\" y=\"690\" font-size=\"21\" fill=\"#bab0a2\">一门写起来像说话的语言</text>")
    打印行("<text x=\"1120\" y=\"44\" font-size=\"12\" fill=\"#9c92aa\" text-anchor=\"end\">示例/绘图.jy · 1200×750 · 纯矢量输出</text>")
    打印行("</g>")

    -- 暗角收边
    打印行("<rect width=\"1200\" height=\"750\" fill=\"url(#暗角)\"/>")

    打印行("</svg>")
    返回 0
}
