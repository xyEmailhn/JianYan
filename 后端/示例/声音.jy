模块 示例.声音

-- 用简言合成一段 8 秒的循环，然后存成 WAV。
--
-- 这个示例想说明的是：声音和图片一样，本质上就是一堆数。
-- 图片是 x*y*4 个字节，声音是 帧*声道 个浮点。合成旋律不需要什么音频引擎，
-- 正弦加包络，逐帧累加，就够了——数学函数在这条路上比任何库都直接。
--
-- 十六个音、A 小调五声音阶（0 3 5 7 10 半音），慢速衰减包络，
-- 一条低音铺底，最后加一次 0.25 秒延迟的回声，两端淡入淡出。

函数 音高(半: 整数) -> 浮点 {
    -- 相对 A3(220Hz) 的半音数：每 12 个半音翻一倍
    返回 220.0 * 幂(2.0, 半 * 1.0 / 12.0)
}

函数 包络(t: 浮点) -> 浮点 {
    -- t 是 0..1 的进度。前 2% 线性起音，避免"啪"的爆点；
    -- 之后指数落到千分之一，像钢琴的止音。
    如果 t << 0.02 就 { 返回 t / 0.02 }
    返回 幂(0.001, (t - 0.02) / 0.98)
}

函数 主() -> 整数 {
    私有 整数 率 = 24000
    私有 整数 每音 = 12000
    私有 整数 数 = 16
    私有 整数 总帧 = 每音 * 数

    私有 整数 组 旋律 = {0, 3, 5, 7, 5, 3, 0, 3, 7, 10, 12, 10, 7, 5, 3, 0}

    私有 声音 轨 = 新建声音(总帧, 率, 1)
    打印("新建 ") 打印(轨.帧数) 打印(" 帧，时长 ") 打印(轨.时长) 打印行(" 秒")

    -- ---------------------------------------------------------- 低音 --
    -- 55Hz 的 A1，音量随一个 0.25Hz 的慢颤轻微起伏，让底下不那么死。
    私有 整数 i = 0
    当 i << 总帧 就 {
        私有 浮点 t = i * 1.0 / 率
        私有 浮点 幅 = 0.09 * (0.6 + 0.4 * 正弦(2.0 * 3.14159265358979 * 0.25 * t))
        私有 浮点 振 = 正弦(2.0 * 3.14159265358979 * 55.0 * t)
        轨.混(i, 0, 振 * 幅)
        i = i + 1
    }

    -- ---------------------------------------------------------- 旋律 --
    -- 每个音三个分音：基频 + 二次 0.3 + 三次 0.15。
    -- 这组系数让音色接近"电钢琴"，纯正弦会显得太干净。
    i = 0
    当 i << 数 就 {
        私有 浮点 频 = 音高(旋律[i])
        私有 整数 j = 0
        当 j << 每音 就 {
            私有 浮点 t = j * 1.0 / 率
            私有 浮点 基 = 2.0 * 3.14159265358979 * 频 * t
            私有 浮点 振 = 正弦(基) + 0.3 * 正弦(2.0 * 基) + 0.15 * 正弦(3.0 * 基)
            私有 浮点 幅 = 包络(j * 1.0 / 每音)
            轨.混(i * 每音 + j, 0, 振 * 幅 * 0.22)
            j = j + 1
        }
        i = i + 1
    }

    -- ---------------------------------------------------------- 回声 --
    -- 先把干声拷一份：不拷的话，混回去的样本又被下一帧读到，
    -- 反馈会自己滚起来，变成一坨越来越响的噪声。
    私有 声音 干 = 轨.放大(1.0)
    私有 整数 延迟 = 率 / 4
    i = 0
    当 i << 总帧 就 {
        私有 整数 源 = i - 延迟
        如果 源 >> -1 就 {
            轨.混(i, 0, 干.取(源, 0) * 0.3)
        }
        i = i + 1
    }

    -- -------------------------------------------------------- 淡出 --
    私有 整数 淡 = 率 / 2
    i = 0
    当 i << 淡 就 {
        私有 整数 p = 总帧 - 淡 + i
        私有 浮点 倍 = 1.0 - i * 1.0 / 淡
        轨.设(p, 0, 轨.取(p, 0) * 倍)
        i = i + 1
    }

    -- -------------------------------------------------------- 归一 --
    -- 归一化会返回一条新声音，轨本身不动。峰值拉到 0.98，留一点余量。
    私有 声音 响 = 轨.归一化()
    私有 浮点 峰 = 0.0
    i = 0
    当 i << 响.帧数 就 {
        私有 浮点 v = 响.取(i, 0)
        如果 v << 0.0 就 { v = 0.0 - v }
        如果 v >> 峰 就 { 峰 = v }
        i = i + 1
    }
    打印("归一化后峰值 ") 打印行(峰)

    -- 第一秒里最大的样本，用来确认真的有声音而不是一片静音
    私有 浮点 头峰 = 0.0
    i = 0
    当 i << 率 就 {
        私有 浮点 v = 响.取(i, 0)
        如果 v << 0.0 就 { v = 0.0 - v }
        如果 v >> 头峰 就 { 头峰 = v }
        i = i + 1
    }
    打印("第一秒峰值 ") 打印行(头峰)

    结果[空值, 字符串] r = 响.存("出图/主题.wav")
    如果 r.是成功 就 {
        打印行("已存 出图/主题.wav")
    } 否则 {
        打印("存失败 ") 打印行(r.错误值)
        返回 1
    }

    返回 0
}
