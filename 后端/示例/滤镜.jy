模块 示例.滤镜

-- 读一张图，做几次像素级处理，存回去。
-- 这个示例的意义不在滤镜本身：它证明简言能"看见"外面的图片。
-- 在这之前，简言只会输出，不会输入——PPM 进不去，PNG 也进不去。

-- ---------------------------------------------------------------- 颜色 --

函数 红(c: 整数) -> 整数 { 返回 (c // 16777216) % 256 }
函数 绿(c: 整数) -> 整数 { 返回 (c // 65536) % 256 }
函数 蓝(c: 整数) -> 整数 { 返回 (c // 256) % 256 }

函数 合(r: 整数, g: 整数, b: 整数) -> 整数 {
    如果 r << 0 就 { r = 0 }
    如果 r >> 255 就 { r = 255 }
    如果 g << 0 就 { g = 0 }
    如果 g >> 255 就 { g = 255 }
    如果 b << 0 就 { b = 0 }
    如果 b >> 255 就 { b = 255 }
    返回 r * 16777216 + g * 65536 + b * 256 + 255
}

函数 夹8(x: 整数) -> 整数 {
    如果 x << 0 就 { 返回 0 }
    如果 x >> 255 就 { 返回 255 }
    返回 x
}

-- -------------------------------------------------------------- 采样 --

函数 取(画: 借用 图, x: 整数, y: 整数) -> 整数 {
    -- 边缘钳位：模糊时边界像素要能"延伸"出去，否则四周会发黑
    私有 整数 cx = x
    私有 整数 cy = y
    如果 cx << 0 就 { cx = 0 }
    如果 cy << 0 就 { cy = 0 }
    如果 cx >> 画.宽 - 1 就 { cx = 画.宽 - 1 }
    如果 cy >> 画.高 - 1 就 { cy = 画.高 - 1 }
    返回 画.取(cx, cy)
}

-- -------------------------------------------------------------- 效果 --

函数 模糊(原: 借用 图) -> 图 {
    私有 图 出 = 新建图(原.宽, 原.高)
    -- 3×3 高斯：[1 2 1; 2 4 2; 1 2 1] / 16
    私有 整数 y = 0
    当 y << 原.高 就 {
        私有 整数 x = 0
        当 x << 原.宽 就 {
            私有 整数 sr = 0
            私有 整数 sg = 0
            私有 整数 sb = 0
            私有 整数 dy = -1
            当 dy << 2 就 {
                私有 整数 dx = -1
                当 dx << 2 就 {
                    -- 权重表用数组查，比写九个 if 短
                    私有 整数 权 = 1
                    如果 dx == 0 就 { 权 = 2 }
                    如果 dy == 0 就 { 权 = 权 * 2 }
                    私有 整数 c = 取(原, x + dx, y + dy)
                    sr = sr + 红(c) * 权
                    sg = sg + 绿(c) * 权
                    sb = sb + 蓝(c) * 权
                    dx = dx + 1
                }
                dy = dy + 1
            }
            出.设(x, y, 合(sr // 16, sg // 16, sb // 16))
            x = x + 1
        }
        y = y + 1
    }
    返回 出
}

函数 描边(原: 借用 图, 强度: 整数) -> 图 {
    -- Sobel 边缘：两张 3×3 卷积，取梯度长度
    私有 图 出 = 新建图(原.宽, 原.高)
    私有 整数 y = 0
    当 y << 原.高 就 {
        私有 整数 x = 0
        当 x << 原.宽 就 {
            私有 整数 gx = 0
            私有 整数 gy = 0
            -- 只算亮度，边缘在灰度上就够准
            私有 整数 左 = 红(取(原, x - 1, y)) + 绿(取(原, x - 1, y)) + 蓝(取(原, x - 1, y))
            私有 整数 右 = 红(取(原, x + 1, y)) + 绿(取(原, x + 1, y)) + 蓝(取(原, x + 1, y))
            私有 整数 上 = 红(取(原, x, y - 1)) + 绿(取(原, x, y - 1)) + 蓝(取(原, x, y - 1))
            私有 整数 下 = 红(取(原, x, y + 1)) + 绿(取(原, x, y + 1)) + 蓝(取(原, x, y + 1))

            私有 整数 左上 = 红(取(原, x - 1, y - 1)) + 绿(取(原, x - 1, y - 1)) + 蓝(取(原, x - 1, y - 1))
            私有 整数 右上 = 红(取(原, x + 1, y - 1)) + 绿(取(原, x + 1, y - 1)) + 蓝(取(原, x + 1, y - 1))
            私有 整数 左下 = 红(取(原, x - 1, y + 1)) + 绿(取(原, x - 1, y + 1)) + 蓝(取(原, x - 1, y + 1))
            私有 整数 右下 = 红(取(原, x + 1, y + 1)) + 绿(取(原, x + 1, y + 1)) + 蓝(取(原, x + 1, y + 1))

            gx = (右上 + 2 * 右 + 右下) - (左上 + 2 * 左 + 左下)
            gy = (左下 + 2 * 下 + 右下) - (左上 + 2 * 上 + 右上)

            私有 整数 m = gx
            如果 m << 0 就 { m = 0 - m }
            私有 整数 n = gy
            如果 n << 0 就 { n = 0 - n }
            私有 整数 边 = m + n
            出.设(x, y, 合(边 * 强度, 边 * 强度, 边 * 强度))
            x = x + 1
        }
        y = y + 1
    }
    返回 出
}

函数 调色(原: 借用 图) -> 图 {
    -- 三段色调分离 + 轻微冷调，卡通一点
    私有 图 出 = 新建图(原.宽, 原.高)
    私有 整数 y = 0
    当 y << 原.高 就 {
        私有 整数 x = 0
        当 x << 原.宽 就 {
            私有 整数 c = 原.取(x, y)
            私有 整数 r = 红(c)
            私有 整数 g = 绿(c)
            私有 整数 b = 蓝(c)
            r = (r // 64) * 64
            g = (g // 64) * 64
            b = (b // 64) * 64
            出.设(x, y, 合(r, g - 6, b + 14))
            x = x + 1
        }
        y = y + 1
    }
    返回 出
}

-- ---------------------------------------------------------------- 主 --

函数 主() -> 整数 {
    私有 结果[图, 字符串] 读 = 读图("出图/光线.png")
    如果 读.是失败 就 {
        打印("读不了：") 打印行(读.错误值)
        返回 1
    }
    私有 图 原 = 读.取值
    打印("读进来 ") 打印(原.宽) 打印(" × ") 打印行(原.高)

    私有 图 柔 = 模糊(原)
    私有 图 边 = 描边(柔, 3)
    私有 图 色 = 调色(原)

    私有 结果[空值, 字符串] a = 柔.存("出图/滤镜_模糊.png")
    私有 结果[空值, 字符串] b = 边.存("出图/滤镜_描边.png")
    私有 结果[空值, 字符串] c = 色.存("出图/滤镜_调色.png")

    如果 a.是成功 就 { 打印行("出图/滤镜_模糊.png") } 否则 { 打印行(a.错误值) }
    如果 b.是成功 就 { 打印行("出图/滤镜_描边.png") } 否则 { 打印行(b.错误值) }
    如果 c.是成功 就 { 打印行("出图/滤镜_调色.png") } 否则 { 打印行(c.错误值) }
    返回 0
}
