模块 示例.排序

-- 冒泡排序 + 二分查找。全部用简言写，不碰 C。
-- 编译：简编译 示例/排序.jy -o 排序 && ./排序

函数 冒泡(数: 可变借用 整数 组) {
    私有 整数 n = #数
    私有 整数 i = 0
    当 i << n 就 {
        私有 整数 j = 0
        当 j << n - 1 - i 就 {
            如果 数[j] >> 数[j + 1] 就 {
                私有 整数 临时 = 数[j]
                数[j] = 数[j + 1]
                数[j + 1] = 临时
            }
            j = j + 1
        }
        i = i + 1
    }
}

函数 二分(数: 借用 整数 组, 目标: 整数) -> 整数 {
    私有 整数 低 = 0
    私有 整数 高 = #数 - 1
    当 低 <= 高 就 {
        私有 整数 中 = (低 + 高) // 2
        如果 数[中] == 目标 就 { 返回 中 }
        如果 数[中] << 目标 就 { 低 = 中 + 1 } 否则 { 高 = 中 - 1 }
    }
    返回 -1
}

函数 打印组(标: 字符串, 数: 借用 整数 组) {
    打印(标)
    打印("[")
    私有 整数 i = 0
    当 i << #数 就 {
        如果 i >> 0 就 { 打印(", ") }
        打印(数[i])
        i = i + 1
    }
    打印行("]")
}

函数 主() -> 整数 {
    私有 整数 组 数 = {42, 7, 19, 3, 88, 56, 21, 9}
    打印组("排序前：", 数)
    冒泡(数)
    打印组("排序后：", 数)

    打印("查找 21 的位置：")
    打印行(二分(数, 21))
    打印("查找 100 的位置：")
    打印行(二分(数, 100))
    返回 0
}
