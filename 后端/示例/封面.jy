模块 示例.封面

-- 不经过 SVG、不经过浏览器、不经过 cairosvg。
-- 从一张空白像素缓冲开始，画完直接存 PNG。
-- 这在 v0.7 之前是做不到的：没有地方画像素，也没有地方写字。

-- ---------------------------------------------------------------- 颜色 --

函数 合(r: 整数, g: 整数, b: 整数) -> 整数 {
    如果 r << 0 就 { r = 0 }
    如果 r >> 255 就 { r = 255 }
    如果 g << 0 就 { g = 0 }
    如果 g >> 255 就 { g = 255 }
    如果 b << 0 就 { b = 0 }
    如果 b >> 255 就 { b = 255 }
    返回 r * 16777216 + g * 65536 + b * 256 + 255
}

-- 混合两个颜色，t 从 0 到 1
函数 混(a: 整数, b: 整数, t: 浮点) -> 整数 {
    私有 整数 ar = (a // 16777216) % 256
    私有 整数 ag = (a // 65536) % 256
    私有 整数 ab = (a // 256) % 256
    私有 整数 br = (b // 16777216) % 256
    私有 整数 bg = (b // 65536) % 256
    私有 整数 bb = (b // 256) % 256
    返回 合(整数(浮点(ar) + (浮点(br) - 浮点(ar)) * t),
             整数(浮点(ag) + (浮点(bg) - 浮点(ag)) * t),
             整数(浮点(ab) + (浮点(bb) - 浮点(ab)) * t))
}

-- ------------------------------------------------------------ 绘制原语 --

-- 径向光晕：中心最亮，按 (1 - d/R)^2 衰减到 0。
-- 用平方而不是线性，边缘才没有一圈明显的"罩子"。
函数 光晕(画: 可变借用 图, cx: 浮点, cy: 浮点, 半径: 浮点, 色: 整数, 强度: 浮点) {
    私有 整数 x0 = 整数(cx - 半径)
    私有 整数 x1 = 整数(cx + 半径)
    私有 整数 y0 = 整数(cy - 半径)
    私有 整数 y1 = 整数(cy + 半径)
    如果 x0 << 0 就 { x0 = 0 }
    如果 y0 << 0 就 { y0 = 0 }
    如果 x1 >> 画.宽 就 { x1 = 画.宽 }
    如果 y1 >> 画.高 就 { y1 = 画.高 }

    私有 整数 y = y0
    当 y << y1 就 {
        私有 整数 x = x0
        当 x << x1 就 {
            私有 浮点 dx = 浮点(x) - cx
            私有 浮点 dy = 浮点(y) - cy
            私有 浮点 d = 开方(dx * dx + dy * dy)
            如果 d << 半径 就 {
                私有 浮点 t = 1.0 - d / 半径
                私有 浮点 k = t * t * 强度
                画.设(x, y, 混(画.取(x, y), 色, k))
            }
            x = x + 1
        }
        y = y + 1
    }
}

-- 描边环：只画 |d - 半径| 小于线宽的那一圈，边上有 1.5 像素软过渡。
-- 早先这里画的是实心圆，三层叠起来中心就成了一块实心盘——
-- 环才是"装饰"，盘是"主体"，两者抢的位置不一样。
函数 环(画: 可变借用 图, cx: 浮点, cy: 浮点, 半径: 浮点, 线宽: 浮点, 色: 整数, 透明: 浮点) {
    私有 整数 x0 = 整数(cx - 半径 - 线宽 - 2.0)
    私有 整数 x1 = 整数(cx + 半径 + 线宽 + 2.0)
    私有 整数 y0 = 整数(cy - 半径 - 线宽 - 2.0)
    私有 整数 y1 = 整数(cy + 半径 + 线宽 + 2.0)
    如果 x0 << 0 就 { x0 = 0 }
    如果 y0 << 0 就 { y0 = 0 }
    如果 x1 >> 画.宽 就 { x1 = 画.宽 }
    如果 y1 >> 画.高 就 { y1 = 画.高 }

    私有 整数 y = y0
    当 y << y1 就 {
        私有 整数 x = x0
        当 x << x1 就 {
            私有 浮点 dx = 浮点(x) + 0.5 - cx
            私有 浮点 dy = 浮点(y) + 0.5 - cy
            私有 浮点 d = 开方(dx * dx + dy * dy)
            -- 到圆环中心线的距离
            私有 浮点 偏 = d - 半径
            如果 偏 << 0.0 就 { 偏 = 0.0 - 偏 }
            私有 浮点 盖 = 线宽 * 0.5 + 1.5 - 偏
            如果 盖 >> 0.0 就 {
                如果 盖 >> 1.5 就 { 盖 = 1.5 }
                画.设(x, y, 混(画.取(x, y), 色, 盖 / 1.5 * 透明))
            }
            x = x + 1
        }
        y = y + 1
    }
}

-- 细线：从 (x0,y) 到 (x1,y)，1 像素高
函数 横线(画: 可变借用 图, x0: 整数, x1: 整数, y: 整数, 色: 整数, 透明: 浮点) {
    私有 整数 x = x0
    当 x << x1 就 {
        如果 x >> -1 就 {
            如果 x << 画.宽 就 {
                如果 y >> -1 就 {
                    如果 y << 画.高 就 {
                        画.设(x, y, 混(画.取(x, y), 色, 透明))
                    }
                }
            }
        }
        x = x + 1
    }
}

-- 很小的实心圆，用在环心
函数 圆点(画: 可变借用 图, cx: 浮点, cy: 浮点, 半径: 浮点, 色: 整数, 透明: 浮点) {
    私有 整数 y = 整数(cy - 半径)
    当 y << 整数(cy + 半径) 就 {
        私有 整数 x = 整数(cx - 半径)
        当 x << 整数(cx + 半径) 就 {
            私有 浮点 dx = 浮点(x) + 0.5 - cx
            私有 浮点 dy = 浮点(y) + 0.5 - cy
            私有 浮点 d = 开方(dx * dx + dy * dy)
            私有 浮点 盖 = 半径 - d
            如果 盖 >> 0.0 就 {
                如果 盖 >> 1.0 就 { 盖 = 1.0 }
                画.设(x, y, 混(画.取(x, y), 色, 盖 * 透明))
            }
            x = x + 1
        }
        y = y + 1
    }
}

-- ---------------------------------------------------------------- 主 --

函数 主() -> 整数 {
    私有 整数 宽 = 1200
    私有 整数 高 = 750
    私有 图 画 = 新建图(宽, 高)

    -- 背景：从近黑到深蓝的竖向渐变，同时右下角稍微提亮
    私有 整数 顶 = 合(9, 10, 16)
    私有 整数 底 = 合(22, 26, 42)
    私有 整数 y = 0
    当 y << 高 就 {
        私有 浮点 t = 浮点(y) / 浮点(高)
        私有 整数 行色 = 混(顶, 底, t)
        私有 整数 x = 0
        当 x << 宽 就 {
            画.设(x, y, 行色)
            x = x + 1
        }
        y = y + 1
    }

    -- 两团光：右上青、左下品红。位置故意不对称
    光晕(画, 980.0, 120.0, 620.0, 合(46, 132, 168), 0.30)
    光晕(画, 120.0, 690.0, 520.0, 合(150, 52, 120), 0.22)

    -- 网格：每 60 像素一条，几乎透明。它不给画面加东西，只给"秩序感"
    -- 横线直接调，竖线得自己循环（没有"竖线"原语，也没必要有）
    私有 整数 线 = 0
    当 线 << 高 就 {
        横线(画, 0, 宽, 线, 合(255, 255, 255), 0.055)
        线 = 线 + 60
    }
    私有 整数 竖线 = 0
    当 竖线 << 宽 就 {
        私有 整数 yy = 0
        当 yy << 高 就 {
            画.设(竖线, yy, 混(画.取(竖线, yy), 合(255, 255, 255), 0.055))
            yy = yy + 1
        }
        竖线 = 竖线 + 60
    }

    -- 装饰：三个环，颜色递减。放在右侧，跟标题错开
    环(画, 900.0, 320.0, 250.0, 1.2, 合(90, 200, 230), 0.55)
    环(画, 900.0, 320.0, 196.0, 1.2, 合(110, 210, 238), 0.42)
    环(画, 900.0, 320.0, 148.0, 1.2, 合(140, 220, 245), 0.30)
    环(画, 900.0, 320.0, 96.0,  1.6, 合(190, 240, 252), 0.34)

    -- 环心一小块实心：没有它，四个环看着像"靶纸"
    圆点(画, 900.0, 320.0, 30.0, 合(150, 225, 248), 0.18)

    -- 一条竖向色条：给画面一个"锚"
    私有 整数 条 = 0
    当 条 << 176 就 {
        画.设(88, 258 + 条, 合(90, 200, 230))
        条 = 条 + 1
    }

    -- 标题。`写字` 的 y 是这一行的"顶边"，跟 CSS 的 text-baseline 不同
    画.写字(88, 250, 168.0, "简言", 合(255, 255, 255))
    画.写字(92, 448, 30.0, "JIAN YAN  ·  一门中文编程语言", 合(140, 200, 220))
    画.写字(92, 505, 24.0, "从源码到 PNG，中间不经过任何画图程序。", 合(150, 158, 178))
    画.写字(92, 545, 24.0, "像素、字形、编解码，全部由 简言 自己完成。", 合(150, 158, 178))

    -- 页脚
    画.写字(92, 660, 19.0, "v0.7  ·  C 参考后端  ·  stb_image / stb_truetype / nanosvg", 合(96, 104, 124))

    -- 这条线最后画，压在所有东西上面，看着像"装订线"
    横线(画, 0, 宽, 646, 合(90, 200, 230), 0.16)

    私有 结果[空值, 字符串] r = 画.存("出图/封面.png")
    如果 r.是成功 就 {
        打印("出图/封面.png  ") 打印(宽) 打印("×") 打印行(高)
    } 否则 {
        打印("存图失败：") 打印行(r.错误值)
        返回 1
    }
    返回 0
}
