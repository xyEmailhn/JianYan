模块 示例.听音

-- ════════════════════════════════════════════════════════════════════
--  听音：把一段音频读成一份「可读的体检报告」
--
--  背景：这段音频是简言自己合成的，但写代码的我听不见它。
--  听不见就没法验收——「0.98 峰值」是数字，不是「好不好听」。
--
--  这个程序做两件事：
--    1. 算出一串声学量（响度、音高、频谱重心、谐波度、分段）
--    2. 把它们排成一张有形状的文本表，让读的人靠文字「看见」声音
--
--  不靠任何识别模型。就是把波形拆成短时频谱，再从频谱里量出
--  人耳（和人读表）在意的那几个维度。
--
--  参数：帧长 1024（42.7ms @24kHz），帧移 512（50% 重叠）
--        1024 点基 2 FFT，自相关用「功率谱逆变换」求
-- ════════════════════════════════════════════════════════════════════

-- ─── 位反转置换 ───
函数 位反转(实: 可变借用 浮点 组, 虚: 可变借用 浮点 组, n: 整数) {
    私有 整数 i = 0
    私有 整数 j = 0
    当 i << n 就 {
        如果 i << j 就 {
            私有 浮点 tr = 实[i]
            实[i] = 实[j]
            实[j] = tr
            私有 浮点 ti = 虚[i]
            虚[i] = 虚[j]
            虚[j] = ti
        }
        私有 整数 m = n // 2
        私有 整数 停 = 0
        当 停 == 0 就 {
            如果 m >= 1 就 {
                如果 j >= m 就 {
                    j = j - m
                    m = m // 2
                } 否则 {
                    停 = 1
                }
            } 否则 {
                停 = 1
            }
        }
        j = j + m
        i = i + 1
    }
}

-- ─── 迭代基 2 FFT，反 = 1 正变换，反 = -1 逆变换（不除 n）───
函数 变换(实: 可变借用 浮点 组, 虚: 可变借用 浮点 组, n: 整数, 反: 整数) {
    位反转(实, 虚, n)
    私有 整数 长 = 2
    当 长 <= n 就 {
        私有 整数 半 = 长 // 2
        私有 浮点 角 = 6.283185307179586 * (反 * 1.0) / (长 * 1.0)
        私有 浮点 wr = 余弦(角)
        私有 浮点 wi = 正弦(角)
        私有 整数 起 = 0
        当 起 << n 就 {
            私有 浮点 cr = 1.0
            私有 浮点 ci = 0.0
            私有 整数 k = 0
            当 k << 半 就 {
                私有 整数 a = 起 + k
                私有 整数 b = a + 半
                私有 浮点 tr = 实[b] * cr - 虚[b] * ci
                私有 浮点 ti = 实[b] * ci + 虚[b] * cr
                实[b] = 实[a] - tr
                虚[b] = 虚[a] - ti
                实[a] = 实[a] + tr
                虚[a] = 虚[a] + ti
                私有 浮点 nr = cr * wr - ci * wi
                ci = cr * wi + ci * wr
                cr = nr
                k = k + 1
            }
            起 = 起 + 长
        }
        长 = 长 * 2
    }
}

-- ─── 小工具：定点字符串、补位、条形字符 ───
函数 定点(x: 浮点, 位: 整数) -> 字符串 {
    私有 整数 倍 = 1
    私有 整数 t = 0
    当 t << 位 就 {
        倍 = 倍 * 10
        t = t + 1
    }
    私有 整数 n = 四舍五入(x * (倍 * 1.0))
    私有 字符串 负号 = ""
    如果 n << 0 就 {
        负号 = "-"
        n = 0 - n
    }
    私有 整数 整部 = n // 倍
    私有 整数 小部 = n % 倍
    私有 字符串 s = 整部.转字符串()
    如果 位 >> 0 就 {
        s = s .. "."
        私有 整数 尺 = 倍 // 10
        当 尺 >> 1 就 {
            如果 小部 << 尺 就 { s = s .. "0" }
            尺 = 尺 // 10
        }
        s = s .. 小部.转字符串()
    }
    返回 负号 .. s
}

函数 补宽(s: 字符串, 宽: 整数) -> 字符串 {
    私有 字符串 r = s
    当 r.长度 << 宽 就 { r = r .. " " }
    返回 r
}

函数 补左(s: 字符串, 宽: 整数) -> 字符串 {
    私有 字符串 r = s
    当 r.长度 << 宽 就 { r = " " .. r }
    返回 r
}

函数 条(v: 浮点) -> 字符串 {
    如果 v << 0.0625 就 { 返回 "·" }
    如果 v << 0.1875 就 { 返回 "▁" }
    如果 v << 0.3125 就 { 返回 "▂" }
    如果 v << 0.4375 就 { 返回 "▃" }
    如果 v << 0.5625 就 { 返回 "▄" }
    如果 v << 0.6875 就 { 返回 "▅" }
    如果 v << 0.8125 就 { 返回 "▆" }
    如果 v << 0.9375 就 { 返回 "▇" }
    返回 "█"
}

-- ─── 音名：把 Hz 换成「A4」这种写法，读表时比 440.0 直观 ───
函数 音名(hz: 浮点) -> 字符串 {
    如果 hz << 20.0 就 { 返回 "—" }
    私有 浮点 半音 = 12.0 * 对数(hz / 440.0) / 对数(2.0) + 69.0
    私有 整数 m = 四舍五入(半音)
    私有 整数 名号 = m % 12
    私有 整数 八度 = (m // 12) - 1
    私有 字符串 名 = "C"
    如果 名号 == 1 就 { 名 = "C#" }
    如果 名号 == 2 就 { 名 = "D" }
    如果 名号 == 3 就 { 名 = "D#" }
    如果 名号 == 4 就 { 名 = "E" }
    如果 名号 == 5 就 { 名 = "F" }
    如果 名号 == 6 就 { 名 = "F#" }
    如果 名号 == 7 就 { 名 = "G" }
    如果 名号 == 8 就 { 名 = "G#" }
    如果 名号 == 9 就 { 名 = "A" }
    如果 名号 == 10 就 { 名 = "A#" }
    如果 名号 == 11 就 { 名 = "B" }
    返回 名 .. 八度.转字符串()
}

-- ════════════════════════════════════════════════════════════════════
--  主分析
-- ════════════════════════════════════════════════════════════════════
函数 分析(声: 借用 声音, 名: 字符串, 格: 整数) {
    -- 帧长 1024，但 FFT 补零到 2048。
    -- * 为什么：功率谱逆变换给的是「循环自相关」，1024 点时 lag 一大
    -- * 就会绕回来和另一端的样本相关，基频估计被污染成倍频跳变。
    -- * 补零到两倍，lag <= 1024 之内都没有环绕。
    私有 整数 帧长 = 1024
    私有 整数 n = 2048
    私有 整数 步 = 512
    私有 整数 半 = n // 2
    私有 整数 总帧 = 声.帧数
    私有 整数 声道 = 声.声道
    私有 整数 率 = 声.采样率

    -- ① 混成单声道
    私有 浮点 组 单 = {}
    私有 整数 i = 0
    当 i << 总帧 就 {
        如果 声道 == 1 就 {
            单.追加(声.取(i, 0))
        } 否则 {
            私有 浮点 和 = 0.0
            私有 整数 c = 0
            当 c << 声道 就 {
                和 = 和 + 声.取(i, c)
                c = c + 1
            }
            单.追加(和 / (声道 * 1.0))
        }
        i = i + 1
    }

    -- ② 全局统计
    私有 浮点 峰 = 0.0
    私有 浮点 平方和 = 0.0
    私有 浮点 直流和 = 0.0
    私有 整数 削波 = 0
    i = 0
    当 i << 总帧 就 {
        私有 浮点 v = 单[i]
        直流和 = 直流和 + v
        平方和 = 平方和 + v * v
        私有 浮点 a = v
        如果 a << 0.0 就 { a = 0.0 - a }
        如果 a >> 峰 就 { 峰 = a }
        如果 a >= 0.999 就 { 削波 = 削波 + 1 }
        i = i + 1
    }
    私有 浮点 均方 = 0.0
    如果 总帧 >> 0 就 { 均方 = 平方和 / (总帧 * 1.0) }
    私有 浮点 有效 = 开方(均方)
    私有 浮点 峰db = -120.0
    如果 峰 >> 0.0000001 就 { 峰db = 20.0 * 对数10(峰) }
    私有 浮点 均db = -120.0
    如果 有效 >> 0.0000001 就 { 均db = 20.0 * 对数10(有效) }
    私有 浮点 直流 = 0.0
    如果 总帧 >> 0 就 { 直流 = 直流和 / (总帧 * 1.0) }

    打印行("")
    打印行("╔══ 听言 / 1 ═══════════════════════════════════════════════════")
    打印行("║ 文件  " .. 名)
    打印("║ 采样  ") 打印(率.转字符串()) 打印(" Hz · ")
    如果 声道 == 1 就 { 打印("单声道") } 否则 { 打印(声道.转字符串() .. " 声道") }
    打印(" · ") 打印(定点(总帧 * 1.0 / 率, 3)) 打印(" 秒 · ") 打印(总帧.转字符串()) 打印行(" 帧")
    打印("║ 响度  峰值 ") 打印(定点(峰db, 2)) 打印(" dBFS · 均方根 ")
    打印(定点(均db, 2)) 打印(" dBFS · 峰均差 ") 打印(定点(峰db - 均db, 1)) 打印行(" dB")
    打印("║ 体检  ")
    如果 削波 >> 0 就 {
        打印("✗ 削波 " .. 削波.转字符串() .. " 个样本  ")
    } 否则 {
        打印("✓ 无削波  ")
    }
    私有 浮点 直偏 = 直流
    如果 直偏 << 0.0 就 { 直偏 = 0.0 - 直偏 }
    如果 直偏 >> 0.01 就 {
        打印("⚠ 直流偏移 " .. 定点(直流, 4) .. "  ")
    } 否则 {
        打印("✓ 无直流  ")
    }
    如果 峰 << 0.02 就 {
        打印("✗ 几乎无声")
    } 否则 {
        打印("✓ 有信号")
    }
    打印行("")

    -- ③ 分帧
    私有 整数 帧数 = 0
    如果 总帧 >= 帧长 就 { 帧数 = (总帧 - 帧长) // 步 + 1 }
    如果 帧数 << 1 就 {
        打印行("║ 太短了，分析不了")
        打印行("╚══════════════════════════════════════════════════════════════")
        返回
    }

    私有 浮点 组 窗 = {}
    i = 0
    当 i << 帧长 就 {
        窗.追加(0.5 - 0.5 * 余弦(6.283185307179586 * (i * 1.0) / ((帧长 - 1) * 1.0)))
        i = i + 1
    }

    私有 浮点 组 能量 = {}
    私有 浮点 组 音高 = {}
    私有 浮点 组 清晰 = {}
    私有 浮点 组 重心 = {}
    私有 浮点 组 起势 = {}
    i = 0
    当 i << 帧数 就 {
        能量.追加(0.0)
        音高.追加(0.0)
        清晰.追加(0.0)
        重心.追加(0.0)
        起势.追加(0.0)
        i = i + 1
    }

    私有 浮点 组 实 = {}
    私有 浮点 组 虚 = {}
    私有 浮点 组 差 = {}
    私有 浮点 组 上谱 = {}
    i = 0
    当 i << n 就 {
        实.追加(0.0)
        虚.追加(0.0)
        差.追加(0.0)
        上谱.追加(0.0)
        i = i + 1
    }

    -- chroma 的查表：每个音级 5 个八度（100–2000Hz）对应哪个 bin。
    -- 音级 0 = A（440Hz），i 就是离 A 的半音数。
    私有 整数 组 目位 = {}
    私有 整数 组 目级 = {}
    i = 0
    当 i << 12 就 {
        私有 整数 oct = -3
        当 oct <= 2 就 {
            私有 浮点 f = 440.0 * 幂(2.0, (i + oct * 12) * 1.0 / 12.0)
            如果 f >= 100.0 就 {
                如果 f <= 2000.0 就 {
                    私有 整数 b = 四舍五入(f * (n * 1.0) / (率 * 1.0))
                    如果 b >= 1 就 {
                        如果 b << 半 就 {
                            目位.追加(b)
                            目级.追加(i)
                        }
                    }
                }
            }
            oct = oct + 1
        }
        i = i + 1
    }
    私有 浮点 组 色 = {}
    私有 浮点 组 色低 = {}
    i = 0
    当 i << 12 就 {
        色.追加(0.0)
        色低.追加(0.0)
        i = i + 1
    }

    -- ④ 逐帧：窗 → FFT → 功率谱 → 重心 → 自相关 → 基频
    -- 搜索 50–1000 Hz。曾经写的是 60–400，两个方向都不够：
    -- *   440Hz 的周期 54.5 采样，比下限 60 还短，于是只能抓到 2T，
    -- *   纯 440 被判成 A3(220)。低音 55Hz 的周期 436 又超过上限 400。
    -- * 范围一放开，倍频错误还在——所以下面改成「取第一个显著峰」。
    私有 整数 下 = 率 // 1000
    私有 整数 上 = 率 // 50
    如果 上 >> 帧长 就 { 上 = 帧长 }
    如果 下 << 4 就 { 下 = 4 }

    私有 整数 f = 0
    当 f << 帧数 就 {
        私有 整数 起 = f * 步
        私有 整数 k = 0
        私有 浮点 帧功 = 0.0
        当 k << n 就 {
            如果 k << 帧长 就 {
                实[k] = 单[起 + k]
                帧功 = 帧功 + 实[k] * 实[k]
            } 否则 {
                实[k] = 0.0
            }
            虚[k] = 0.0
            k = k + 1
        }
        私有 浮点 帧均 = 开方(帧功 / (帧长 * 1.0))
        私有 浮点 d = -120.0
        如果 帧均 >> 0.0000001 就 { d = 20.0 * 对数10(帧均) }
        能量[f] = d

        变换(实, 虚, n, 1)

        -- 谱通量：这一帧的频谱比上一帧「新长出多少」。
        -- 起音检测用它比用能量差分靠谱：能量差在长音上恒为零，
        -- 而谱通量对「换音」和「辅音起始」都敏感，也不受缓音影响。
        私有 浮点 通量 = 0.0
        k = 1
        当 k << 半 就 {
            私有 浮点 p = 实[k] * 实[k] + 虚[k] * 虚[k]
            私有 浮点 幅 = 对数10(p + 1.0)
            私有 浮点 增 = 幅 - 上谱[k]
            如果 增 >> 0.0 就 { 通量 = 通量 + 增 }
            上谱[k] = 幅
            k = k + 1
        }
        起势[f] = 通量

        -- 重心（只取 1..半-1，跳过直流）
        私有 浮点 总功 = 0.0
        私有 浮点 加权 = 0.0
        私有 浮点 峰功 = 0.0
        k = 1
        当 k << 半 就 {
            私有 浮点 p = 实[k] * 实[k] + 虚[k] * 虚[k]
            总功 = 总功 + p
            加权 = 加权 + p * (k * 1.0 * 率 / (n * 1.0))
            如果 p >> 峰功 就 { 峰功 = p }
            k = k + 1
        }
        私有 浮点 心 = 0.0
        如果 总功 >> 0.0 就 { 心 = 加权 / 总功 }
        重心[f] = 心

        -- 功率谱放回实部，逆变换得自相关
        k = 0
        当 k << n 就 {
            实[k] = 实[k] * 实[k] + 虚[k] * 虚[k]
            虚[k] = 0.0
            k = k + 1
        }
        变换(实, 虚, n, -1)

        -- 自相关在 T、2T、3T 处都有峰，取全局最大有一半机会落到 2T 上。
        -- 用 YIN 的累积均值归一化差分：d(τ) 除以累积均值，把窗带来的
        -- 随 lag 衰减抵消掉，第一个掉到阈值以下的 τ 才是真周期。
        -- 前置条件：这一帧不能加窗——乘过 Hann 之后，lag 218 处的
        -- 相关只剩 0.74，纯 110Hz 也认不出来。
        私有 浮点 r0 = 实[0]
        私有 浮点 累 = 0.0
        私有 浮点 最大 = 0.0
        k = 1
        当 k <= 上 就 {
            私有 浮点 d = 1.0 - 实[k] / r0
            如果 d << 0.0 就 { d = 0.0 }
            累 = 累 + d
            私有 浮点 cm = 1.0
            如果 累 >> 0.0000001 就 { cm = d * (k * 1.0) / 累 }
            差[k] = cm
            如果 k >= 下 就 {
                如果 1.0 - cm >> 最大 就 { 最大 = 1.0 - cm }
            }
            k = k + 1
        }
        私有 整数 峰位 = 0
        k = 下
        当 k <= 上 就 {
            如果 峰位 == 0 就 {
                如果 差[k] << 0.25 就 { 峰位 = k }
            }
            k = k + 1
        }
        如果 峰位 >> 0 就 {
            k = 峰位
            私有 整数 走 = 1
            当 走 == 1 就 {
                如果 k << 上 就 {
                    如果 差[k + 1] << 差[k] 就 {
                        k = k + 1
                    } 否则 {
                        走 = 0
                    }
                } 否则 {
                    走 = 0
                }
            }
            峰位 = k
        }
        清晰[f] = 最大
        如果 峰位 >> 0 就 {
            -- 抛物线插值：440Hz 的真实周期是 54.545 采样，
            -- 只取整数 lag 的话误差 1%，唱出来就差 4 个音分以上。
            私有 浮点 精 = 峰位 * 1.0
            如果 峰位 >> 下 就 {
                如果 峰位 << 上 就 {
                    私有 浮点 a = 实[峰位 - 1] / r0
                    私有 浮点 b = 实[峰位] / r0
                    私有 浮点 c = 实[峰位 + 1] / r0
                    私有 浮点 分母 = a - 2.0 * b + c
                    如果 分母 << -0.0000001 就 {
                        私有 浮点 移 = 0.5 * (a - c) / 分母
                        如果 移 >> -1.0 就 {
                            如果 移 << 1.0 就 { 精 = 峰位 + 移 }
                        }
                    }
                }
            }
            音高[f] = 率 * 1.0 / 精
        }
        f = f + 1
    }

    -- chroma：按「实测基频」统计音级分布，不做频谱折叠。
    -- 频谱折叠会把谐波网络全点亮（A 的 3 次谐波是 E，E 的又是 B……），
    -- 最后 12 个音级一样高，什么也说明不了。基频是逐帧验证过的，
    -- 直接数它，得到的才是「这段音乐落在哪几个音上」。
    f = 0
    当 f << 帧数 就 {
        如果 音高[f] >> 0.0 就 {
            私有 浮点 半音 = 12.0 * 对数(音高[f] / 440.0) / 对数(2.0)
            私有 整数 g2 = 四舍五入(半音) % 12
            如果 g2 << 0 就 { g2 = g2 + 12 }
            色[g2] = 色[g2] + 清晰[f]
        }
        f = f + 1
    }

    -- ⑤ 起音检测：能量的一阶差分。
    -- 谱通量也试过：对数谱在衰减尾巴上抖得厉害，16 个音数出 25 个。
    -- 能量差分虽然粗糙，但「突然变响」这件事它抓得最准。
    f = 1
    当 f << 帧数 就 {
        私有 浮点 增 = 能量[f] - 能量[f - 1]
        如果 增 << 0.0 就 { 增 = 0.0 }
        起势[f] = 增
        f = f + 1
    }
    私有 浮点 起门 = 4.5
    私有 整数 组 事件帧 = {}
    私有 浮点 组 事件强 = {}
    私有 整数 上次 = -100
    f = 1
    当 f << 帧数 - 1 就 {
        私有 浮点 v = 起势[f]
        如果 v >= 起门 就 {
            如果 v >= 起势[f - 1] 就 {
                如果 v >= 起势[f + 1] 就 {
                    如果 f - 上次 >= 10 就 {
                        事件帧.追加(f)
                        事件强.追加(v)
                        上次 = f
                    }
                }
            }
        }
        f = f + 1
    }

    -- ⑥ 分句：能量低于门算静音；缝短于 8 帧（170ms）的合并成一句
    私有 浮点 门 = 峰db - 30.0
    如果 门 << -75.0 就 { 门 = -75.0 }

    私有 整数 组 原起 = {}
    私有 整数 组 原止 = {}
    私有 整数 开 = -1
    f = 0
    当 f << 帧数 就 {
        如果 能量[f] >> 门 就 {
            如果 开 << 0 就 { 开 = f }
        } 否则 {
            如果 开 >= 0 就 {
                原起.追加(开)
                原止.追加(f)
                开 = -1
            }
        }
        f = f + 1
    }
    如果 开 >= 0 就 {
        原起.追加(开)
        原止.追加(帧数)
    }

    私有 整数 组 句起 = {}
    私有 整数 组 句止 = {}
    私有 整数 s = 0
    当 s << #原起 就 {
        如果 #句止 >> 0 就 {
            私有 整数 末0 = #句止 - 1
            私有 整数 缝 = 原起[s] - 句止[末0]
            如果 缝 << 26 就 {
                句止[末0] = 原止[s]
            } 否则 {
                句起.追加(原起[s])
                句止.追加(原止[s])
            }
        } 否则 {
            句起.追加(原起[s])
            句止.追加(原止[s])
        }
        s = s + 1
    }
    -- 丢掉短于 4 帧（85ms）的碎句
    私有 整数 组 段起 = {}
    私有 整数 组 段止 = {}
    s = 0
    当 s << #句起 就 {
        如果 句止[s] - 句起[s] >= 4 就 {
            段起.追加(句起[s])
            段止.追加(句止[s])
        }
        s = s + 1
    }

    -- ⑦ 轨迹图
    私有 整数 每格 = 帧数 // 格
    如果 每格 << 1 就 { 每格 = 1 }
    打印行("║")
    打印("║ 能量  ")
    i = 0
    当 i << 格 就 {
        私有 整数 a = i * 每格
        私有 整数 b = a + 每格
        如果 b >> 帧数 就 { b = 帧数 }
        私有 浮点 高 = -120.0
        私有 整数 t = a
        当 t << b 就 {
            如果 能量[t] >> 高 就 { 高 = 能量[t] }
            t = t + 1
        }
        私有 浮点 位 = (高 - (峰db - 48.0)) / 48.0
        如果 位 << 0.0 就 { 位 = 0.0 }
        如果 位 >> 1.0 就 { 位 = 1.0 }
        打印(条(位))
        i = i + 1
    }
    打印行("")

    打印("║ 音高  ")
    i = 0
    当 i << 格 就 {
        私有 整数 a = i * 每格
        私有 整数 b = a + 每格
        如果 b >> 帧数 就 { b = 帧数 }
        -- 清晰度加权平均：不让倍频跳变和清音帧把曲线拉花
        私有 浮点 权和 = 0.0
        私有 浮点 权和值 = 0.0
        私有 整数 t = a
        当 t << b 就 {
            如果 音高[t] >> 0.0 就 {
                私有 浮点 w = 清晰[t]
                权和 = 权和 + w
                权和值 = 权和值 + 音高[t] * w
            }
            t = t + 1
        }
        如果 权和 << 0.001 就 {
            打印(" ")
        } 否则 {
            私有 浮点 高 = 权和值 / 权和
            私有 浮点 位 = (对数10(高) - 1.7) / 1.3
            如果 位 << 0.0 就 { 位 = 0.0 }
            如果 位 >> 1.0 就 { 位 = 1.0 }
            打印(条(位))
        }
        i = i + 1
    }
    打印行("")

    打印("║ 起音  ")
    i = 0
    当 i << 格 就 {
        私有 整数 a = i * 每格
        私有 整数 b = a + 每格
        私有 浮点 高 = 0.0
        私有 整数 t = a
        当 t << b 就 {
            如果 t << 帧数 就 {
                如果 起势[t] >> 高 就 { 高 = 起势[t] }
            }
            t = t + 1
        }
        私有 浮点 位 = 高 / 20.0
        如果 位 << 0.0 就 { 位 = 0.0 }
        如果 位 >> 1.0 就 { 位 = 1.0 }
        打印(条(位))
        i = i + 1
    }
    打印行("")

    打印("║       ")
    i = 0
    当 i << 格 就 {
        如果 i % 12 == 0 就 { 打印("|") } 否则 { 打印("-") }
        i = i + 1
    }
    打印行("  竖线 = 1 秒")

    -- ⑧ 事件与分句
    私有 整数 g = 0
    打印行("║")
    私有 浮点 时长 = 总帧 * 1.0 / 率
    私有 浮点 事件率 = (#事件帧 * 1.0) / 时长
    打印("║ 起音  " .. 字符串(#事件帧) .. " 个 · 平均 ")
    打印(定点(事件率, 2)) 打印(" 个/秒")
    如果 #事件帧 >> 1 就 {
        私有 浮点 间隔和 = 0.0
        g = 1
        当 g << #事件帧 就 {
            间隔和 = 间隔和 + ((事件帧[g] - 事件帧[g - 1]) * 步 * 1.0 / 率)
            g = g + 1
        }
        私有 浮点 间隔 = 间隔和 / ((#事件帧 - 1) * 1.0)
        打印(" · 平均间隔 ") 打印(定点(间隔, 3)) 打印(" 秒")
        如果 间隔 >> 0.05 就 {
            打印("（约 " .. 字符串(四舍五入(60.0 / 间隔)) .. " BPM）")
        }
    }
    打印行("")

    -- 音级直方图：比逐个报音名稳，一个音测歪了不影响整体调性
    私有 浮点 色和 = 0.0
    i = 0
    当 i << 12 就 {
        色和 = 色和 + 色[i]
        i = i + 1
    }
    如果 色和 >> 0.0 就 {
        私有 字符串 组 名表 = {"A ", "A#", "B ", "C ", "C#", "D ", "D#", "E ", "F ", "F#", "G ", "G#"}
        打印("║ 音级  ")
        i = 0
        当 i << 12 就 {
            私有 浮点 占比 = 色[i] / 色和
            如果 占比 >> 0.04 就 {
                私有 字符串 柱 = ""
                私有 整数 格数 = 四舍五入(占比 * 20.0)
                私有 整数 q = 0
                当 q << 格数 就 {
                    柱 = 柱 .. "▮"
                    q = q + 1
                }
                打印(名表[i]) 打印(" ") 打印(补宽(柱, 4))
                打印(定点(占比 * 100.0, 0)) 打印("%  ")
            }
            i = i + 1
        }
        打印行("")
    }

    -- 逐个音报音名这件事，检测率只有七八成（首音被首帧平滑掉，
    -- 同音连击分不开），报出来反而误导。音级直方图已经回答了
    -- 「落在哪几个音上」，这里就不再逐个列。

    -- 分句表：最多列 12 句
    打印("║ 分段  " .. 字符串(#段起) .. " 段")
    如果 时长 >> 0.0 就 {
        私有 浮点 发声比 = 0.0
        私有 整数 累 = 0
        s = 0
        当 s << #段起 就 {
            累 = 累 + (段止[s] - 段起[s])
            s = s + 1
        }
        发声比 = (累 * 1.0) / (帧数 * 1.0)
        打印(" · 发声占比 " .. 定点(发声比 * 100.0, 1) .. "%")
    }
    打印行("")
    私有 整数 列 = #段起
    如果 列 >> 12 就 { 列 = 12 }
    s = 0
    当 s << 列 就 {
        私有 整数 a = 段起[s]
        私有 整数 b = 段止[s]
        私有 浮点 t0 = a * 步 * 1.0 / 率
        私有 浮点 t1 = b * 步 * 1.0 / 率
        私有 浮点 低 = 5000.0
        私有 浮点 高 = 0.0
        私有 浮点 清 = 0.0
        私有 整数 有声 = 0
        私有 浮点 心 = 0.0
        私有 整数 t = a
        当 t << b 就 {
            如果 音高[t] >> 0.0 就 {
                如果 音高[t] << 低 就 { 低 = 音高[t] }
                如果 音高[t] >> 高 就 { 高 = 音高[t] }
                清 = 清 + 清晰[t]
                有声 = 有声 + 1
            }
            心 = 心 + 重心[t]
            t = t + 1
        }
        私有 浮点 中 = 0.0
        如果 有声 >> 0 就 { 中 = (低 + 高) / 2.0 }
        私有 浮点 清均 = 0.0
        如果 有声 >> 0 就 { 清均 = 清 / (有声 * 1.0) }
        私有 浮点 心均 = 心 / ((b - a) * 1.0)
        -- 走向：前 1/4 与后 1/4 的音高均值差
        私有 浮点 头 = 0.0
        私有 浮点 尾 = 0.0
        私有 整数 头数 = 0
        私有 整数 尾数 = 0
        私有 整数 四 = (b - a) // 4
        如果 四 << 1 就 { 四 = 1 }
        t = a
        当 t << a + 四 就 {
            如果 音高[t] >> 0.0 就 { 头 = 头 + 音高[t]  头数 = 头数 + 1 }
            t = t + 1
        }
        t = b - 四
        如果 t << a 就 { t = a }
        当 t << b 就 {
            如果 音高[t] >> 0.0 就 { 尾 = 尾 + 音高[t]  尾数 = 尾数 + 1 }
            t = t + 1
        }
        如果 头数 >> 0 就 { 头 = 头 / (头数 * 1.0) }
        如果 尾数 >> 0 就 { 尾 = 尾 / (尾数 * 1.0) }
        私有 字符串 向 = "—"
        如果 头数 >> 0 就 {
            如果 尾数 >> 0 就 {
                私有 浮点 差 = 尾 - 头
                如果 差 >> 12.0 就 { 向 = "升" } 否则 {
                    如果 差 << -12.0 就 { 向 = "降" } 否则 { 向 = "平" }
                }
            }
        }
        私有 字符串 序 = 字符串(s + 1)
        如果 s + 1 << 10 就 { 序 = "0" .. 序 }
        打印("║  #" .. 序 .. " ") 打印(补左(定点(t0, 2), 6)) 打印("→")
        打印(补左(定点(t1, 2), 6)) 打印(" ") 打印(补左(定点(t1 - t0, 2), 5)) 打印("s")
        打印(" ") 打印(补宽(音名(中), 4)) 打印(" ") 打印(补宽(音名(低), 4))
        打印("–") 打印(补宽(音名(高), 4)) 打印(向 .. " ")
        打印("清晰 " .. 定点(清均, 2)) 打印(" 亮 " .. 定点(心均 / 1000.0, 1) .. "k")
        打印行("")
        s = s + 1
    }
    如果 #段起 >> 12 就 {
        打印行("║  … 还有 " .. 字符串(#段起 - 12) .. " 段")
    }

    -- 停顿表：句与句之间的静音。这是「节奏感」最直接的证据。
    如果 #段起 >> 1 就 {
        打印("║ 停顿  " .. 字符串(#段起 - 1) .. " 处 · ")
        s = 1
        当 s << #段起 就 {
            私有 浮点 缝秒 = (段起[s] - 段止[s - 1]) * 步 * 1.0 / 率
            打印(定点(缝秒, 2)) 打印("s ")
            s = s + 1
        }
        打印行("")
    }

    -- ⑨ 判读
    私有 浮点 抖动和 = 0.0
    私有 整数 抖动数 = 0
    f = 1
    当 f << 帧数 就 {
        如果 音高[f] >> 0.0 就 {
            如果 音高[f - 1] >> 0.0 就 {
                私有 浮点 d = 音高[f] / 音高[f - 1]
                如果 d << 1.0 就 { d = 1.0 / d }
                抖动和 = 抖动和 + (d - 1.0)
                抖动数 = 抖动数 + 1
            }
        }
        f = f + 1
    }
    私有 浮点 抖动 = 0.0
    如果 抖动数 >> 0 就 { 抖动 = 抖动和 / (抖动数 * 1.0) }

    私有 浮点 清晰均 = 0.0
    私有 整数 有数 = 0
    f = 0
    当 f << 帧数 就 {
        如果 音高[f] >> 0.0 就 {
            清晰均 = 清晰均 + 清晰[f]
            有数 = 有数 + 1
        }
        f = f + 1
    }
    如果 有数 >> 0 就 { 清晰均 = 清晰均 / (有数 * 1.0) }

    私有 字符串 类别 = "说不准"
    如果 峰 << 0.02 就 {
        类别 = "几乎无声"
    } 否则 {
        如果 清晰均 << 0.35 就 {
            类别 = "噪声或打击（没有稳定的周期性）"
        } 否则 {
            如果 抖动 >> 0.012 就 {
                类别 = "语音（音高连续滑动，抖动 " .. 定点(抖动 * 100.0, 1) .. "%/帧）"
            } 否则 {
                如果 事件率 << 0.4 就 {
                    类别 = "持续音（几乎没有起音变化）"
                } 否则 {
                    类别 = "音乐（音高成台阶，起音 " .. 定点(事件率, 1) .. " 个/秒）"
                }
            }
        }
    }

    打印行("║")
    打印("║ 判读  音高抖动 ") 打印(定点(抖动 * 100.0, 2))
    打印("%/帧 · 清晰度 ") 打印(定点(清晰均, 2))
    打印(" · 发声占比 ")
    如果 帧数 >> 0 就 {
        私有 整数 累2 = 0
        s = 0
        当 s << #段起 就 {
            累2 = 累2 + (段止[s] - 段起[s])
            s = s + 1
        }
        打印(定点(累2 * 100.0 / (帧数 * 1.0), 1))
    } 否则 { 打印("0.0") }
    打印行("%")
    打印("║       → ") 打印行(借用 类别)
    打印行("╚══════════════════════════════════════════════════════════════")
}

函数 主() -> 整数 {
    私有 字符串 组 路径 = {"出图/主题.wav", "出图/大肥鱼.mp3"}
    私有 整数 k = 0
    当 k << #路径 就 {
        私有 结果[声音, 字符串] r = 载入声音(路径[k])
        如果 r.是成功 就 {
            私有 声音 声 = r.取值
            分析(声, 路径[k], 96)
        } 否则 {
            打印行("跳过 " .. 路径[k] .. "：" .. r.错误值)
        }
        k = k + 1
    }
    返回 0
}
