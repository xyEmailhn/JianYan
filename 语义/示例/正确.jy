模块 示例.基础

结构 学生 {
    名字: 字符串
    年龄: 整数
    成绩: 浮点
}

枚举 形状 {
    圆(半径: 浮点)
    矩(宽: 浮点, 高: 浮点)
    点
}

接口 可打印 {
    函数 打印() -> 字符串

    函数 打印行() {
        打印(打印())
    }
}

接口 可比较 {
    函数 比较(其他: 借用 自身) -> 整数
}

实现 学生 为 可打印, 可比较 {
    函数 打印() -> 字符串 {
        返回 名字 .. "（" .. 字符串(年龄) .. "岁）"
    }

    函数 比较(其他: 借用 学生) -> 整数 {
        返回 年龄 - 其他.年龄
    }
}

常量 整数 最大人数 = 60

函数 面积(s: 借用 形状) -> 浮点 {
    匹配 s {
        例 形状.圆(半径): { 返回 3.14159 * 半径 * 半径 }
        例 形状.矩(宽, 高): { 返回 宽 * 高 }
        例 形状.点: { 返回 0.0 }
    }
}

函数 改名(s: 可变借用 学生) {
    s.名字 = "李四"
}

函数 平均(分数: 借用 浮点 组) -> 浮点 {
    如果 #分数 == 0 就 { 返回 0.0 }
    私有 浮点 和 = 0.0
    对 分 在 分数 {
        和 = 和 + 分
    }
    返回 和 / 浮点(#分数)
}

函数 找学生(编号: 整数) -> 结果[学生, 字符串] {
    如果 编号 << 0 就 {
        返回 失败("编号不能是负数")
    }
    私有 学生 新人 = { "张三", 18, 90.5 }
    返回 成功(新人)
}

函数 演示() {
    私有 学生 甲 = { "张三", 18, 90.5 }
    打印(甲.打印())
    打印(甲.打印行())

    私有 可空[学生] 乙 = 空
    如果 乙 != 空 就 {
        打印(乙.打印())
    }

    私有 结果[学生, 字符串] 丙 = 找学生(1)
    如果 丙.是成功() 就 {
        打印(丙.取值().名字)
    } 否则 {
        打印(丙.错误值())
    }

    私有 字符串 组 词们 = { "苹果", "香蕉" }
    词们.追加("橙子")
    对 词 在 词们 {
        打印(词.长度)
    }

    私有 映射[字符串, 整数] 表 = { "一": 1 }
    表.插入("二", 2)
    如果 表.包含("二") 就 {
        私有 可空[整数] 值 = 表.取("二")
        打印(值.或默认(0))
    }

    对 i: 1~10, 步长: 2 {
        如果 i % 2 == 0 就 { 继续 }
    }

    私有 通道[整数] 管道 = 通道[整数](8)
    线程 {
        发送 管道, 1
    }
    关闭 管道

    改名(可变借用 甲)
    私有 学生 丁 = 移动 甲
    打印(丁.年龄)

    私有 整数 商 = 7 // 2
    私有 整数 余 = 7 % 2
    私有 整数 幂 = 2 ^ 10
    私有 整数 位 = (6 & 3) | (1 <<< 4)
    私有 整数 反 = ~~位
    打印(字符串(商) .. " " .. 字符串(余) .. " " .. 字符串(幂))
}

函数 最大[T: 可比较](甲: T, 乙: T) -> T {
    如果 甲 >> 乙 就 { 返回 甲 }
    返回 乙
}

测试 "加法" {
    私有 整数 商 = 7 // 2
    如果 商 != 3 就 { 打印("错了") }
}
