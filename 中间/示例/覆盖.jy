模块 示例.覆盖

结构 学生 {
    名字: 字符串
    年龄: 整数
    成绩: 浮点
}

枚举 形状 {
    圆(半径: 浮点)
    矩(宽: 浮点, 高: 浮点)
    点
}

接口 可打印 {
    函数 打印() -> 字符串

    函数 打印行() {
        打印(打印())
    }
}

实现 学生 为 可打印 {
    函数 打印() -> 字符串 {
        返回 名字 .. "（" .. 字符串(年龄) .. "岁）"
    }
}

函数 面积(s: 借用 形状) -> 浮点 {
    匹配 s {
        例 形状.圆(半径): { 返回 3.14159 * 半径 * 半径 }
        例 形状.矩(宽, 高): { 返回 宽 * 高 }
        例 形状.点: { 返回 0.0 }
    }
}

函数 分类(分: 整数) -> 字符串 {
    如果 分 >= 90 就 {
        返回 "优"
    } 否则如果 分 >= 60 就 {
        返回 "及格"
    } 否则 {
        返回 "不及格"
    }
}

函数 范围循环() -> 整数 {
    私有 整数 和 = 0
    对 i: 1 ~ 10, 步长: 2 {
        如果 i % 3 == 0 就 { 继续 }
        和 = 和 + i
    }
    返回 和
}

函数 当循环(n: 整数) -> 整数 {
    私有 整数 甲 = n
    当 甲 >> 0 {
        甲 = 甲 - 1
        如果 甲 == 3 就 { 打断 }
    }
    返回 甲
}

函数 重复循环() -> 整数 {
    私有 整数 甲 = 0
    重复循环直到 甲 >= 5 {
        甲 = 甲 + 1
    }
    返回 甲
}

函数 容器() -> 整数 {
    私有 字符串 组 词们 = { "甲", "乙", "丙" }
    词们.追加("丁")
    私有 整数 总 = 0
    对 词 在 词们 {
        总 = 总 + 词.长度
    }

    私有 映射[字符串, 整数] 表 = { "一": 1, "二": 2 }
    表.插入("三", 3)
    如果 表.包含("三") 就 {
        私有 可空[整数] 值 = 表.取("三")
        总 = 总 + 值.或默认(0)
    }
    返回 总
}

函数 找学生(编号: 整数) -> 结果[学生, 字符串] {
    如果 编号 << 0 就 {
        返回 失败("编号不能是负数")
    }
    私有 学生 新人 = { "张三", 18, 90.5 }
    返回 成功(新人)
}

函数 结果处理() -> 字符串 {
    私有 结果[学生, 字符串] 甲 = 找学生(1)
    如果 甲.是成功() 就 {
        返回 甲.取值().名字
    }
    返回 甲.错误值()
}

函数 可空处理() -> 整数 {
    私有 可空[整数] 甲 = 空
    如果 甲 != 空 就 {
        返回 甲.取值()
    }
    返回 甲.或默认(-1)
}

函数 借用链() {
    私有 学生 甲 = { "张三", 18, 90.5 }
    打印(甲.打印())
    打印(甲.打印行())
    私有 学生 乙 = 移动 甲
    打印(乙.年龄)
}

函数 运算() -> 布尔值 {
    私有 整数 甲 = 7 + 3 * 2 - 4
    私有 整数 乙 = 7 // 2
    私有 整数 丙 = 7 % 2
    私有 整数 丁 = 2 ^ 10
    私有 整数 戊 = (6 & 3) | (1 <<< 4)
    私有 整数 己 = ~~戊
    私有 布尔值 庚 = 甲 >> 乙 与 丙 != 0 或 丁 >> 0
    返回 庚
}

函数 拼字符串() -> 字符串 {
    私有 字符串 甲 = "简" .. "言"
    返回 甲.大写() .. 字符串(42)
}

函数 并发() {
    私有 通道[整数] 管道 = 通道[整数](4)
    线程 {
        发送 管道, 1
        发送 管道, 2
    }
    关闭 管道
}

函数 匿名() {
    私有 函数(整数) -> 整数 加倍 = 函数(x: 整数) -> 整数 {
        返回 x * 2
    }
    打印(加倍(21))
}

函数 最大[T: 可比较](甲: T, 乙: T) -> T {
    如果 甲 >> 乙 就 { 返回 甲 }
    返回 乙
}

函数 用泛型() {
    私有 整数 甲 = 最大(1, 2)
    私有 浮点 乙 = 最大(1.5, 2.5)
    私有 字符串 丙 = 最大("a", "b")
    打印(甲)
    打印(乙)
    打印(丙)
}
