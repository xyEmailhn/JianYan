模块 示例.泛型

结构 点 {
    x: 浮点
    y: 浮点
}

函数 最大[T: 可比较](甲: T, 乙: T) -> T {
    如果 甲 >> 乙 就 { 返回 甲 }
    返回 乙
}

函数 最小[T: 可比较](甲: T, 乙: T) -> T {
    如果 甲 << 乙 就 { 返回 甲 }
    返回 乙
}

函数 三个最大[T: 可比较](甲: T, 乙: T, 丙: T) -> T {
    返回 最大(最大(甲, 乙), 丙)
}

函数 折叠() -> 整数 {
    返回 2 * 3 + 4 * 5 - 6 // 2 + (2 ^ 10)
}

函数 演示() {
    私有 整数 甲 = 最大(1, 2)
    私有 浮点 乙 = 最大(1.5, 2.5)
    私有 整数 丙 = 三个最大(3, 9, 5)
    私有 字符串 丁 = 最大("abc", "abd")
    打印(甲)
    打印(乙)
    打印(丙)
    打印(丁)
}
