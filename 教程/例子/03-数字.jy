-- 第三章：数字与运算符。
-- 最容易踩的一条：`/` 永远是浮点除法，整除要写 `//`。
模块 教程.数字

函数 主() -> 整数 {
    打印("7 / 2 = ")   打印行(7 / 2)
    打印("7 // 2 = ")  打印行(7 // 2)
    打印("-7 // 2 = ") 打印行(-7 // 2)
    打印("7 % 3 = ")   打印行(7 % 3)
    打印("-7 % 3 = ")  打印行(-7 % 3)
    打印("2 ^ 10 = ")  打印行(2 ^ 10)
    打印("9 ^ 0.5 = ") 打印行(9 ^ 0.5)

    -- 比较用的是 << 和 >>（小于、大于），不是尖尖朝外的移位
    打印("3 << 5 = ")  打印行(3 << 5)
    打印("3 <= 5 = ")  打印行(3 <= 5)

    -- 位运算：& | ^^ ~~ <<< >>>
    打印("12 & 10 = ") 打印行(12 & 10)
    打印("12 | 10 = ") 打印行(12 | 10)
    打印("12 ^^ 10 = ") 打印行(12 ^^ 10)
    打印("~~0 = ")     打印行(~~0)
    打印("1 <<< 10 = ") 打印行(1 <<< 10)

    -- 内置数学函数，角度用弧度
    打印("开方(2) = ")  打印行(开方(2.0))
    打印("绝对值(-3) = ") 打印行(绝对值(-3.0))
    打印("四舍五入(3.5) = ") 打印行(四舍五入(3.5))
    打印("最大(3, 8) = ") 打印行(最大(3, 8))
    返回 0
}
