-- 第十三章：图与声音。
-- 这两个类型是"句柄"：赋值只搬一个头，不复制像素/采样。
-- 想独立一份就显式复制（图.缩放、声音.放大/归一化 都会产生新对象）。
模块 教程.媒体

-- 把 r,g,b 打包成 0xRRGGBBAA
函数 色(r: 整数, g: 整数, b: 整数) -> 整数 {
    返回 r * 16777216 + g * 65536 + b * 256 + 255
}

函数 主() -> 整数 {
    -- ---- 图 ----
    私有 图 画布 = 新建图(64, 32)
    打印("尺寸 ") 打印(画布.宽) 打印("×") 打印行(画布.高)

    -- 画一条斜线
    私有 整数 i = 0
    当 i << 64 就 {
        画布.设(i, i // 2, 色(255, 80, 40))
        i = i + 1
    }

    打印("(10,5) 的颜色 ") 打印行(画布.取(10, 5))
    打印("(0,0) 的颜色 ") 打印行(画布.取(0, 0))
    打印("越界取 ") 打印行(画布.取(999, 999))

    -- 缩放返回新图，原图不动
    私有 图 放大版 = 画布.缩放(128, 64)
    打印("放大后 ") 打印(放大版.宽) 打印("×") 打印行(放大版.高)
    打印("原图还是 ") 打印(画布.宽) 打印("×") 打印行(画布.高)

    私有 结果[空值, 字符串] 存图 = 画布.存("/tmp/教程-画布.png")
    如果 存图.是成功 就 { 打印行("已存到 /tmp/教程-画布.png") }

    -- ---- 声音 ----
    -- 0.5 秒、8000 Hz、单声道
    私有 声音 波 = 新建声音(4000, 8000, 1)
    打印("帧数 ") 打印行(波.帧数)
    打印("采样率 ") 打印行(波.采样率)
    打印("声道 ") 打印行(波.声道)

    -- 440Hz 正弦，振幅 0.6；顺手叠一个 880Hz 的泛音
    私有 整数 帧 = 0
    当 帧 << 波.帧数 就 {
        私有 浮点 t = 浮点(帧) / 浮点(波.采样率)
        波.设(帧, 0, 0.6 * 正弦(2.0 * 3.14159265 * 440.0 * t))
        波.混(帧, 0, 0.2 * 正弦(2.0 * 3.14159265 * 880.0 * t))
        帧 = 帧 + 1
    }

    -- 归一化把峰值拉到 0.98，返回新声音
    私有 声音 成品 = 波.归一化()
    打印("时长 ") 打印行(成品.时长)
    打印("第 1 帧的样本 ") 打印行(成品.取(1, 0))

    私有 结果[空值, 字符串] 存声 = 成品.存("/tmp/教程-440.wav")
    如果 存声.是成功 就 { 打印行("已存到 /tmp/教程-440.wav") }
    返回 0
}
