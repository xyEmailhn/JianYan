-- 第五章：判断与循环。
-- 注意 `如果 条件 就 { }`：`就` 不能省，`否则` 后面不再写 `就`。
模块 教程.控制流

函数 评级(分: 整数) -> 字符串 {
    如果 分 >= 90 就 {
        返回 "优秀"
    } 否则如果 分 >= 60 就 {
        返回 "及格"
    } 否则 {
        返回 "不及格"
    }
}

函数 主() -> 整数 {
    打印("95 → ") 打印行(评级(95))
    打印("72 → ") 打印行(评级(72))
    打印("40 → ") 打印行(评级(40))

    -- 当：条件为真就一直转
    私有 整数 和 = 0
    私有 整数 i = 1
    当 i <= 100 就 {
        和 = 和 + i
        i = i + 1
    }
    打印("1..100 = ") 打印行(和)

    -- 对 + 范围：1~10 是闭区间，步长写在后头
    私有 整数 奇位和 = 0
    对 k: 1~10, 步长: 2 {
        奇位和 = 奇位和 + k
    }
    打印("1,3,5,7,9 = ") 打印行(奇位和)

    -- 对 + 组
    私有 整数 组 数 = {4, 8, 15, 16}
    私有 整数 最大数 = 数[0]
    对 x 在 数 {
        如果 x >> 最大数 就 { 最大数 = x }
    }
    打印("最大 ") 打印行(最大数)

    -- 打断 / 继续
    私有 整数 找到 = -1
    对 n: 1~100 {
        如果 n % 7 != 0 就 { 继续 }
        如果 n >> 20 就 { 打断 }
        找到 = n
    }
    打印("20 以内最后一个 7 的倍数 ") 打印行(找到)

    -- 循环 = 当 真 就，靠 打断 出来
    私有 整数 次 = 0
    循环 {
        次 = 次 + 1
        如果 次 >= 3 就 { 打断 }
    }
    打印("循环了 ") 打印行(次)
    返回 0
}
