-- 第六章：函数。
-- 参数类型必须写；返回值用 `->`；没有返回值就不写。
-- 只读参数写 `借用`，要改调用方那份写 `可变借用`。
模块 教程.调用

函数 阶乘(n: 整数) -> 整数 {
    如果 n <= 1 就 { 返回 1 }
    返回 n * 阶乘(n - 1)
}

-- 函数体只有一个表达式时，可以写成 `= 表达式`
函数 平方(x: 整数) -> 整数 = x * x

-- 借用：不复制整组数据，函数里只能读
函数 求和(xs: 借用 整数 组) -> 整数 {
    私有 整数 和 = 0
    对 x 在 xs { 和 = 和 + x }
    返回 和
}

-- 可变借用：改的就是调用方那个组
函数 每个加一(xs: 可变借用 整数 组) {
    私有 整数 i = 0
    当 i << #xs 就 {
        xs[i] = xs[i] + 1
        i = i + 1
    }
}

-- 多个参数、多个返回值用结构包
结构 商余 {
    商: 整数
    余: 整数
}

函数 除(甲: 整数, 乙: 整数) -> 商余 {
    返回 新建 商余{ 甲 // 乙, 甲 % 乙 }
}

函数 主() -> 整数 {
    打印("10! = ") 打印行(阶乘(10))
    打印("平方(13) = ") 打印行(平方(13))

    私有 整数 组 数 = {1, 2, 3, 4}
    打印("求和 = ") 打印行(求和(借用 数))

    每个加一(可变借用 数)
    打印("加一后第一个 = ") 打印行(数[0])

    私有 商余 r = 除(17, 5)
    打印("17 // 5 = ") 打印(r.商) 打印(" 余 ") 打印行(r.余)
    返回 0
}
