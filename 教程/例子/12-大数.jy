-- 第十二章：大整数与小数。
-- 整数是 64 位，超过 2^63-1 就绕回去了。要精确的大数用 `大整数`，
-- 要"十进制意义上的准确"用 `小数`（0.1 真的是 0.1）。
-- 两者都不可变：每次运算返回新值，赋值和传参都不用写 借用。
模块 教程.大数

函数 阶乘(n: 整数) -> 大整数 {
    私有 大整数 果 = 大数(1)
    私有 整数 i = 2
    当 i <= n 就 {
        果 = 果.乘(大数(i))
        i = i + 1
    }
    返回 果
}

函数 主() -> 整数 {
    -- ---- 大整数 ----
    私有 大整数 f100 = 阶乘(100)
    打印("100! 有 ") 打印(f100.位()) 打印行(" 位")
    打印("100! = ") 打印行(f100.文本())

    私有 大整数 二的一千 = 大数(2).幂(1000)
    打印("2^1000 有 ") 打印(二的一千.位()) 打印行(" 位")

    -- 精确除法与取余：100! 除以 99! 正好是 100
    打印("100!/99! = ") 打印行(f100.除(阶乘(99)).文本())
    打印("100! 开方后位数 ") 打印行(f100.根().位())

    -- 从字符串读，非法输入给失败原因而不是崩
    私有 结果[大整数, 字符串] 读 = 读大数("123456789012345678901234567890")
    如果 读.是成功 就 {
        打印("读到 ") 打印(读.取值.位()) 打印行(" 位")
    }
    如果 读大数("12x").是失败 就 { 打印行("非法输入被拦住了") }

    -- ---- 小数 ----
    私有 小数 甲 = 读小数("0.1").取值
    私有 小数 乙 = 读小数("0.2").取值
    打印("0.1 + 0.2 = ") 打印行(甲.加(乙).文本())

    -- 对照：浮点里 0.1+0.2 并不等于 0.3（二进制装不下 0.1）
    打印("浮点 (0.1+0.2) == 0.3 ？") 打印行((0.1 + 0.2) == 0.3)
    打印("小数 (0.1+0.2) == 0.3 ？") 打印行(甲.加(乙).比(读小数("0.3").取值) == 0)

    -- 精度是"有效位数"，默认 34，改完作用于下一次运算
    定小数精度(50)
    打印("精度 ") 打印行(小数精度())
    私有 小数 三 = 读小数("3").取值
    打印("1/3 = ") 打印行(变小数(1.0).除(三).文本())
    定小数精度(34)
    返回 0
}
