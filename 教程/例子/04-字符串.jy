-- 第四章：字符串。
-- `#s` 是长度（按字符算），`..` 是拼接（两边必须都是字符串）。
模块 教程.文本

函数 主() -> 整数 {
    私有 字符串 s = "  Hello, 简言  "
    打印("[") 打印(s) 打印行("]")

    打印("长度 ") 打印行(#s)
    打印("去空白后 [") 打印(s.去空白()) 打印行("]")
    打印("大写 ") 打印行(s.去空白().大写())
    打印("全小写 ") 打印行(s.去空白().大写().小写())

    -- 查找返回 可空[整数]：找不到是 空，必须先判
    私有 可空[整数] 位 = s.查找("简言")
    如果 位 != 空 就 {
        打印("简言在第 ") 打印(位.取值()) 打印行(" 个字符")
    }

    私有 字符串 组 段 = s.去空白().切分(",")
    打印("切成 ") 打印(#段) 打印行(" 段")
    打印("第二段 [") 打印(段[1]) 打印行("]")

    打印("替换 ") 打印行(s.去空白().替换("Hello", "你好"))
    打印("开头是空格 ") 打印行(s.开头是("  "))
    打印("包含逗号 ") 打印行(s.包含(","))

    -- 数字转字符串用 字符串(x)，反过来用 .转整数()，它返回 结果
    私有 字符串 拼 = "共 " .. 字符串(#段) .. " 段"
    打印行(拼)
    私有 结果[整数, 字符串] r = "2024".转整数()
    如果 r.是成功 就 { 打印("转成整数 ") 打印行(r.取值) }
    返回 0
}
