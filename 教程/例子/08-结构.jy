-- 第八章：结构与方法。
-- 结构字段一行一个，逗号不行。
-- 方法写在 `实现 类型 为 接口 { ... }` 里；方法体直接用字段名，不用写 自身.r。
模块 教程.账户

结构 账户 {
    户名: 字符串
    余额: 整数
}

接口 可存取 {
    函数 存(n: 整数)
    函数 取(n: 整数) -> 布尔值
    函数 余额文本() -> 字符串
}

实现 账户 为 可存取 {
    函数 存(n: 整数) {
        余额 = 余额 + n
    }

    函数 取(n: 整数) -> 布尔值 {
        如果 n >> 余额 就 { 返回 假 }
        余额 = 余额 - n
        返回 真
    }

    函数 余额文本() -> 字符串 {
        返回 户名 .. " 有 " .. 字符串(余额) .. " 元"
    }
}

函数 主() -> 整数 {
    私有 账户 a = { "张三", 100 }
    打印行(a.余额文本())

    a.存(50)
    打印行(a.余额文本())

    打印("取 200 成功？") 打印行(a.取(200))
    打印("取 30 成功？")  打印行(a.取(30))
    打印行(a.余额文本())

    -- 结构可以套结构；构造时全写字段名更清楚
    私有 账户 b = 新建 账户{ 户名: "李四", 余额: 0 }
    打印行(b.余额文本())
    返回 0
}
