-- 第九章：枚举与匹配。
-- 枚举的每个变体可以带数据，也可以不带。`匹配` 必须写全，编译器会查穷尽。
模块 教程.形状

枚举 形状 {
    圆(半径: 浮点)
    矩形(宽: 浮点, 高: 浮点)
    点
}

函数 面积(s: 借用 形状) -> 浮点 {
    匹配 s {
        例 形状.圆(半径): { 返回 3.14159 * 半径 * 半径 }
        例 形状.矩形(宽, 高): { 返回 宽 * 高 }
        例 形状.点: { 返回 0.0 }
    }
}

函数 描述(s: 借用 形状) -> 字符串 {
    匹配 s {
        例 形状.圆(半径): { 返回 "圆 r=" .. 字符串(半径) }
        例 形状.矩形(宽, 高): { 返回 "矩形 " .. 字符串(宽) .. "×" .. 字符串(高) }
        例 形状.点: { 返回 "一个点" }
    }
}

函数 主() -> 整数 {
    私有 形状 甲 = 形状.圆(2.0)
    私有 形状 乙 = 形状.矩形(3.0, 4.0)
    私有 形状 丙 = 形状.点

    打印行(描述(借用 甲))
    打印("面积 ") 打印行(面积(借用 甲))

    打印行(描述(借用 乙))
    打印("面积 ") 打印行(面积(借用 乙))

    打印行(描述(借用 丙))
    打印("面积 ") 打印行(面积(借用 丙))
    返回 0
}
