-- 第七章：组（动态数组）与映射（键值表）。
-- 组用 `类型 组` 声明，映射用 `映射[键, 值]`。
模块 教程.容器

函数 主() -> 整数 {
    -- ---- 组 ----
    私有 整数 组 分数 = {88, 95, 72}
    打印("初始 ") 打印(#分数) 打印(" 个：")
    对 x 在 分数 { 打印(x) 打印(" ") }
    打印行("")

    分数.追加(100)
    分数.插入(0, 60)
    打印("增删后 ") 打印(#分数) 打印(" 个，第一个 ") 打印行(分数[0])

    分数.排序()
    打印("排序后：")
    对 x 在 分数 { 打印(x) 打印(" ") }
    打印行("")

    分数.反转()
    打印("反转后第一个 ") 打印行(分数[0])
    打印("包含 95？") 打印行(分数.包含(95))
    打印("删掉第一个，得到 ") 打印行(分数.删除(0))

    -- 取是安全的：越界给 空，不崩
    私有 可空[整数] 越界 = 分数.取(999)
    打印("越界取到空？") 打印行(越界 == 空)

    -- ---- 映射 ----
    私有 映射[字符串, 整数] 库存 = {"苹果": 12, "香蕉": 7}
    库存.插入("橙子", 20)
    打印("种类数 ") 打印行(库存.大小)
    打印("苹果 ") 打印行(库存.取("苹果").取值)

    -- 遍历用 键组()，再按键取值
    对 名 在 库存.键组() {
        打印(名) 打印("=") 打印(库存.取(名).取值) 打印(" ")
    }
    打印行("")

    打印("删掉香蕉，原来有 ") 打印行(库存.删除("香蕉").取值)
    打印("现在种类数 ") 打印行(库存.大小)
    返回 0
}
